<Application x:Class="Hush.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hush" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Application.Resources>
    <sys:Double x:Key="SupportFontSize">15</sys:Double>
    <sys:Double x:Key="BodyFontSize">16</sys:Double>
    <sys:Double x:Key="ActionFontSize">16</sys:Double>
    <sys:Double x:Key="CompactFontSize">15</sys:Double>
    <sys:Double x:Key="CategoryFontSize">16</sys:Double>
    <SolidColorBrush x:Key="WindowBrush" Color="#101319"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1B202A"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="#232936"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2B3240"/>
    <SolidColorBrush x:Key="TextBrush" Color="#C6CFDC"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9BA8BA"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#8794A8"/>
    <SolidColorBrush x:Key="HeadingBrush" Color="#D8DFE9"/>
    <Color x:Key="PrimaryAccentColor">#3FC3EE</Color>
    <SolidColorBrush x:Key="TealBrush" Color="{DynamicResource PrimaryAccentColor}"/>
    <SolidColorBrush x:Key="TealTextBrush" Color="#3FC3EE"/>
    <!-- Hover state of the one primary Cyan: lighter in Dark, deeper in Light. Set per theme in ApplyTheme. -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8EDDF7"/>
    <SolidColorBrush x:Key="ActionFillBrush" Color="#252C38"/>
    <SolidColorBrush x:Key="ModalShadeBrush" Color="#A00C1016"/>
    <SolidColorBrush x:Key="SafetyGreenBrush" Color="#3FC3EE"/>
    <!-- The calm green for good news and Safe items (SafetyPalette.Good); themed in MainWindow.ApplyTheme. -->
    <SolidColorBrush x:Key="GoodBrush" Color="#5CC98F"/>
    <!-- Resource meters turn Review-orange (never red) when a reading is high. -->
    <SolidColorBrush x:Key="MeterWarnBrush" Color="#FFA24D"/>
    <SolidColorBrush x:Key="CleanFillBrush" Color="#08FF795C"/>
    <!-- Nearly transparent fill of the accent outline button (scan complete); themed in MainWindow.ApplyTheme. -->
    <SolidColorBrush x:Key="AccentFillBrush" Color="#083FC3EE"/>
    <SolidColorBrush x:Key="CleanTextBrush" Color="#FF795C"/>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
      <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <!-- Typography rules (locked by TypographyChecks). Page titles (Review files, Settings) are one style: 29, Medium 500, upright.
         Popup titles are 28 Regular; Settings card titles 18 Medium in the accent. Italic is reserved for the home heading (the Hush logo is upright since 0.9). -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="29"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="FontStyle" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}"/>
    </Style>
    <Style x:Key="PopupTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FontStyle" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="FontStyle" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource TealTextBrush}"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="{DynamicResource SupportFontSize}"/>
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TealTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource ActionFillBrush}"/>
      <Setter Property="local:Motion.Enabled" Value="True"/>
      <Setter Property="local:Motion.Accent" Value="{DynamicResource PrimaryAccentColor}"/>
      <Setter Property="local:Motion.Glow" Value="0.08"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="FontSize" Value="{DynamicResource ActionFontSize}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="GlowUnderlay" Height="2" Margin="16,0,16,1" VerticalAlignment="Bottom" CornerRadius="2" Opacity="0" Background="{TemplateBinding Foreground}" IsHitTestVisible="False"/>
            <Grid x:Name="OuterGlow" Visibility="Collapsed" IsHitTestVisible="False">
              <Border x:Name="GlowHalo" CornerRadius="13" Background="{TemplateBinding BorderBrush}"/>
              <Border x:Name="GlowEdge" CornerRadius="13" Background="{TemplateBinding BorderBrush}"/>
            </Grid>
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13"/>
            <ContentPresenter x:Name="ButtonContent" TextElement.Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="local:Motion.OuterGlow" Value="True">
              <Setter TargetName="GlowUnderlay" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="OuterGlow" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="local:Motion.HoverForeground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="local:Motion.Glow" Value="0"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>
    <!-- Accent text action (wordmark, links, Release notes...): Cyan in Dark, soft blue in Light. Hover eases to AccentHoverBrush; never scales or glows. -->
    <Style x:Key="AccentTextButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
      <Setter Property="Foreground" Value="{DynamicResource TealTextBrush}"/>
      <Setter Property="local:Motion.HoverForeground" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <!-- Back arrow: the Windows system icon font (Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10),
         the same arrow Windows apps use. It is text, so it takes the animated ink and sits on the label's line. -->
    <Style x:Key="BackIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="Text" Value="&#xE72B;"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,5,7,0"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <!-- Back: set Content="Back"; the arrow and label are centered on one line and share the animated ink. -->
    <Style x:Key="BackButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
      <!-- The 14 DIP padding is hit area only: the label's right edge aligns with the page content edge. -->
      <Setter Property="Margin" Value="0,0,-14,0"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource BackIcon}"/>
          <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
        </StackPanel>
      </DataTemplate></Setter.Value></Setter>
    </Style>
    <!-- Chevron-only Back (0.9): one step up inside a page (for example from an opened Review group to the three groups). Same icon font and ink as BackButton,
         no label; Content is only the accessible name. -->
    <Style x:Key="ChevronBackButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="local:Motion.HoverForeground" Value="{DynamicResource HeadingBrush}"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
        <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextFormattingMode="Ideal"/>
      </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="10"/>
    </Style>
    <Style x:Key="CaptionIcon" TargetType="Path">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
    <!-- Header mode toggle ("Pro"): the plain caption look while off; while on (Tag="On") the word itself lights up in the accent color with a soft glow around the
         letters (owner, November 12, 2026: no border and no fill, an exception to the other highlighted buttons; the glow is a LetterGlow behind it (a tight glow around each letter, drawn
         once as a picture), shown by ApplyProMode only while Pro is on, and the Hush wordmark gets one too). -->
    <Style x:Key="ProModeButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="54"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="FontSize" Value="{DynamicResource CompactFontSize}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Style.Triggers>
        <Trigger Property="Tag" Value="On">
          <Setter Property="Foreground" Value="{DynamicResource TealTextBrush}"/>
          <Setter Property="local:Motion.HoverForeground" Value="{DynamicResource AccentHoverBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource CleanFillBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CleanTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CleanTextBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="local:Motion.Accent" Value="#FF795C"/>
      <Setter Property="local:Motion.Glow" Value="0.13"/>
      <Setter Property="local:Motion.OuterGlow" Value="True"/>
    </Style>
    <!-- The Clean button's shape and glow in the theme's one accent color (the scan-complete button). -->
    <Style x:Key="AccentOutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TealTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TealTextBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="local:Motion.Glow" Value="0.13"/>
      <Setter Property="local:Motion.OuterGlow" Value="True"/>
    </Style>
    <!-- The small "?" after a setting's name (see HelpMark: hover or click opens the explanation popup in the app's own look). -->
    <Style x:Key="HelpMark" TargetType="local:HelpMark">
      <Setter Property="Width" Value="19"/>
      <Setter Property="Height" Value="19"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Help"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="local:HelpMark">
          <Grid Background="Transparent">
            <Ellipse x:Name="Ring" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.4"/>
            <TextBlock x:Name="Mark" Text="?" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TealBrush}"/>
              <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource TealBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TealBrush}"/>
              <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource TealBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <!-- A topic heading in the Windows choices (Telemetry, Search, Microsoft Edge ...): a quiet clickable row with a turning chevron. -->
    <Style x:Key="TopicHeader" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root" Background="Transparent" Margin="0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Path x:Name="Chevron" Data="M 1,1 L 6,6 L 1,11" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Margin="3,0,0,0">
              <Path.RenderTransform><RotateTransform x:Name="Turn" Angle="0"/></Path.RenderTransform>
            </Path>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="0,9"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource TextBrush}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Turn" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Turn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <!-- One entry of a small popup menu (the Actions menu): left-aligned, roomy, text eases to the heading color on hover. -->
    <Style x:Key="MenuAction" TargetType="Button" BasedOn="{StaticResource TextButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height" Value="Auto"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="local:Motion.HoverForeground" Value="{DynamicResource HeadingBrush}"/>
    </Style>
    <!-- The search box at the top of the Privacy card: a quiet rounded field on the raised surface with its hint inside. -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame" Background="{DynamicResource RaisedBrush}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="16,9">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
              <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource FaintBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TealBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="NavigationIcon" TargetType="Path">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="StrokeThickness" Value="1.7"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <ControlTemplate x:Key="ResizeThumb" TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
    <Style x:Key="CategoryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Padding" Value="17,14"/>
      <Setter Property="local:Motion.Glow" Value="0.12"/>
    </Style>
    <!-- Shared checkbox: one 20 DIP slot; every ring shares identical geometry so edges stay smooth.
         Checked border, tick and dash all use the same Tag brush (the safety/accent color). -->
    <Style TargetType="CheckBox">
      <Setter Property="Tag" Value="{DynamicResource SafetyGreenBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="local:Motion.Ink" Value="{DynamicResource TextBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid x:Name="Box" Width="20" Height="20" VerticalAlignment="Center" UseLayoutRounding="False" SnapsToDevicePixels="False">
              <Border x:Name="Surface" CornerRadius="6" Background="{DynamicResource WindowBrush}"/>
              <Border x:Name="Outline" CornerRadius="6" BorderThickness="1.5" BorderBrush="{DynamicResource FaintBrush}"/>
              <Border x:Name="HoverRing" CornerRadius="6" BorderThickness="1.5" BorderBrush="{DynamicResource MutedBrush}" Opacity="0"/>
              <Border x:Name="MixedRing" CornerRadius="6" BorderThickness="1.5" BorderBrush="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0"/>
              <Border x:Name="CheckedRing" CornerRadius="6" BorderThickness="1.5" BorderBrush="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0"/>
              <Path x:Name="Tick" Data="M5.6,10.2 L8.7,13.1 L14.4,6.9" Stroke="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
              <Border x:Name="Mixed" Width="9" Height="2" CornerRadius="1" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0"/>
            </Grid>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="local:Motion.Ink" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CheckedRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CheckedRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="MixedRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Mixed" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="MixedRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Mixed" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <!-- On/off switch for settings rows: still a CheckBox (same bindings and automation), 44 x 24 DIP pill.
         Off: neutral ring and muted knob. On: the Tag accent fills the pill and the knob takes the window color.
         The knob slides and colors ease with the shared 280 ms timing; hover only fades a neutral ring. -->
    <Style x:Key="SwitchCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid x:Name="Root" Width="44" Height="24" Background="Transparent" UseLayoutRounding="False" SnapsToDevicePixels="False">
            <Border x:Name="Surface" CornerRadius="12" Background="{DynamicResource WindowBrush}"/>
            <Border x:Name="Outline" CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource FaintBrush}"/>
            <Border x:Name="HoverRing" CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource MutedBrush}" Opacity="0"/>
            <Border x:Name="OnFill" CornerRadius="12" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0"/>
            <Grid x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="4,0,0,0">
              <Grid.RenderTransform><TranslateTransform x:Name="KnobShift" X="0"/></Grid.RenderTransform>
              <Ellipse x:Name="KnobOff" Fill="{DynamicResource MutedBrush}"/>
              <Ellipse x:Name="KnobOn" Fill="{DynamicResource WindowBrush}" Opacity="0"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="OnFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="OnFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <!-- Settings section: a quiet panel that shows a title (in the theme accent) and a one-line summary; clicking the header
         reveals its switches with the shared height/opacity accordion. The chevron eases like the Review categories. -->
    <Style x:Key="SettingsSection" TargetType="Expander">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Expander">
          <Border Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="28,0">
            <StackPanel>
              <ToggleButton x:Name="HeaderSite" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}" Cursor="Hand" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                  <Grid x:Name="HeaderRoot" Background="Transparent" Margin="0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" Width="10" Height="5" Margin="20,0,2,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                      <Grid.RenderTransform><RotateTransform x:Name="ChevronRotation"/></Grid.RenderTransform>
                      <Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                      <Path x:Name="ChevronHover" Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
                    </Grid>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger SourceName="HeaderRoot" Property="IsMouseOver" Value="True">
                      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <local:AccordionBody Expanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{Binding Expanded, RelativeSource={RelativeSource Self}}">
                <StackPanel>
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                  <ContentPresenter Margin="0,0,0,8"/>
                </StackPanel>
              </local:AccordionBody>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <!-- Choice chip: one option of a small set (threshold, interval). Quiet pill; the chosen one takes the theme accent on a raised surface.
         The label ink eases like every other text control; hover never scales anything. -->
    <Style x:Key="ChoiceChip" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="FontSize" Value="{DynamicResource SupportFontSize}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Pill" CornerRadius="10" Padding="13,7" Margin="0,0,6,0" Background="Transparent">
            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" local:Motion.Ink="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Label" Property="local:Motion.Ink" Value="{DynamicResource TextBrush}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource RaisedBrush}"/>
              <Setter TargetName="Label" Property="local:Motion.Ink" Value="{DynamicResource TealTextBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <!-- Color swatch (Settings > Appearance): one round color to pick. The chosen one carries a ring; hover shows a fainter ring. Never scales. -->
    <Style x:Key="AccentSwatch" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="{DynamicResource TextBrush}" Opacity="0"/>
            <Ellipse x:Name="Dot" Margin="5" Fill="{TemplateBinding Background}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.4"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.4"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="CandidateCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="IsEnabled" Value="{Binding CanSelectCandidates, RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TealBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style TargetType="ScrollViewer"><Setter Property="PanningMode" Value="VerticalOnly"/></Style>
    <!-- Page scroller: the 8 DIP bar overlays the right edge, so content width never changes when scrolling becomes possible.
         Padding adds the end-of-scroll gap (16) so the last card/row is never flush against or clipped by the viewport edge. -->
    <Style x:Key="PageScroll" TargetType="ScrollViewer">
      <Setter Property="PanningMode" Value="VerticalOnly"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Padding" Value="0,0,0,16"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,4,0" Width="10" MinWidth="0" Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbFill" Margin="2,0" CornerRadius="2" Background="{DynamicResource FaintBrush}" Opacity="0.45"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbFill" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbFill" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <!-- Chevron scroll bar for the lists inside a category (owner, November 11, 2026): an up and a down chevron at the ends of the bar; every click moves the list by
         exactly one item (see ScrollSteps), holding repeats. The thin thumb is the same as every other scroll bar. -->
    <Style x:Key="StepChevron" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <ContentPresenter x:Name="Mark" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="StepScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
            <RepeatButton Style="{StaticResource StepChevron}" local:ScrollSteps.Direction="-1" AutomationProperties.Name="Previous item"><Path Data="M 0,5 L 5,0 L 10,5" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></RepeatButton>
            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="5,0" CornerRadius="2" Background="{DynamicResource FaintBrush}" Opacity="0.5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Style="{StaticResource StepChevron}" local:ScrollSteps.Direction="1" AutomationProperties.Name="Next item"><Path Data="M 0,0 L 5,5 L 10,0" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></RepeatButton>
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="StepScroll" TargetType="ScrollViewer">
      <Setter Property="PanningMode" Value="VerticalOnly"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource StepScrollBar}" Orientation="Vertical" Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="FileListBox" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Style="{StaticResource StepScroll}" Focusable="False" Padding="{TemplateBinding Padding}"
                        CanContentScroll="{Binding (ScrollViewer.CanContentScroll), RelativeSource={RelativeSource TemplatedParent}}">
            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  </Application.Resources>
</Application>
