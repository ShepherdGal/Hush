            <Expander x:Name="SettingsBrowserSection" Style="{StaticResource SettingsGroup}" IsExpanded="True" AutomationProperties.Name="Browser data">
              <Expander.Header>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="BROWSER DATA" Style="{StaticResource SectionLabel}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Hush never touches saved passwords, bookmarks or open tabs. History and cookies are not part of any scan: choose them here, close the browser first, and Hush shows you exactly what it found before anything is removed." AutomationProperties.Name="More about Browser data"/></StackPanel>
