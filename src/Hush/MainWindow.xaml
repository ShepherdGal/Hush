                    <StackPanel Orientation="Horizontal"><TextBlock Text="Browser history" Style="{StaticResource RowName}"/><TextBlock Text="Review" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MeterWarnBrush}" Margin="10,1,0,0" VerticalAlignment="Center"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="The list of sites you visited in Chromium browsers. Bookmarks and logins stay." AutomationProperties.Name="More about Browser history"/></StackPanel>
