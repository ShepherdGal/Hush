<Window x:Class="Hush.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hush"
        Title="Hush · Make more room to breathe" Icon="/Hush;component/Assets/Hush.ico" Width="920" Height="820" MinWidth="800" MinHeight="740" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" Closing="Window_Closing" Loaded="Window_Loaded">
  <Window.Resources>
    <local:ReviewRowWidthConverter x:Key="ReviewRowWidth"/>
    <DataTemplate x:Key="NeutralFileTemplate">
      <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}, Converter={StaticResource ReviewRowWidth}, ConverterParameter=6}" Background="{DynamicResource RaisedBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,7" ToolTip="{Binding Path}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource CandidateCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay}" Tag="{Binding SelectionAccent}" AutomationProperties.Name="{Binding Path}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="FileName" Text="{Binding Name}" local:Motion.Ink="{DynamicResource TextBrush}" FontSize="{DynamicResource BodyFontSize}" FontWeight="Medium" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DirectoryLabel}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"/>
            <TextBlock Text="{Binding Outcome}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource TextBrush}" TextAlignment="Right" FontSize="{DynamicResource CompactFontSize}" FontFamily="Cascadia Mono, Consolas"/>
            <TextBlock Text="{Binding GroupLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SupportFontSize}" TextAlignment="Right" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="FileName" Property="local:Motion.Ink" Value="{Binding SelectionAccent}"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="CategoryHeaderTemplate">
        <Grid x:Name="HeaderRoot" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="118"/><ColumnDefinition Width="27"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="CategoryTitle" Text="{Binding Title}" local:Motion.Ink="{DynamicResource HeadingBrush}" FontSize="{DynamicResource CategoryFontSize}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource SupportFontSize}" TextWrapping="Wrap" LineHeight="20" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SupportFontSize}" Margin="0,6,0,0"/>
          </StackPanel>
          <Border Grid.Column="2" Background="{DynamicResource RaisedBrush}" CornerRadius="10" Padding="10,8" VerticalAlignment="Center">
            <TextBlock Text="{Binding TotalLabel}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource CompactFontSize}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" TextAlignment="Center"/>
          </Border>
          <Grid Grid.Column="3" Width="10" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><RotateTransform x:Name="ChevronRotation"/></Grid.RenderTransform>
            <Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            <Path x:Name="ChevronHover" Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
          </Grid>
        </Grid>
      <DataTemplate.Triggers>
      <Trigger SourceName="HeaderRoot" Property="IsMouseOver" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
      </Trigger>
      <DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="CategoryTitle" Property="local:Motion.Ink" Value="{Binding TextAccent}"/></DataTrigger>
      <DataTrigger Binding="{Binding Expanded}" Value="True">
        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
        <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
      </DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="CategoryAccordion" TargetType="Expander">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
        <Border Height="1" Margin="36,0" Background="{DynamicResource BorderBrush}" Opacity="0.45"/>
        <Grid Margin="22,3">
          <StackPanel>
            <Border Padding="17,11" ToolTip="{Binding Description}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="15"/><ColumnDefinition Width="22"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{Binding TextAccent}" Width="6" Margin="0,2" CornerRadius="3"/>
            <CheckBox Grid.Column="2" Style="{StaticResource CandidateCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay}" Tag="{Binding TextAccent}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title, StringFormat=Select {0}}"/>
            <ToggleButton Grid.Column="4" x:Name="HeaderSite" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" BorderThickness="0" FocusVisualStyle="{x:Null}" Cursor="Hand" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            </Grid></Border>
            <local:AccordionBody Expanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
              <ContentPresenter Margin="14,10,14,12"/>
            </local:AccordionBody>
          </StackPanel>
          <!-- Checked outline: an overlay (never covers or shifts content) with a full 1 DIP stroke on whole pixels, softened by opacity.
               A 0.5 DIP border rendered as a ragged hairline at the rounded corners. -->
          <Border x:Name="SelectionOutline" CornerRadius="10" BorderThickness="1" Opacity="0.7" IsHitTestVisible="False" SnapsToDevicePixels="False" local:Motion.Ink="Transparent"/>
        </Grid>
        </StackPanel>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="SelectionOutline" Property="local:Motion.Ink" Value="{Binding TextAccent}"/></DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="WindowSurface" CornerRadius="24" Background="{DynamicResource WindowBrush}" SizeChanged="Surface_SizeChanged">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="AppSurface" Grid.RowSpan="2">
      <Grid.Effect><BlurEffect x:Name="BackgroundBlur" Radius="0" RenderingBias="Quality"/></Grid.Effect>
      <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="30,0,18,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Button x:Name="AboutButton" Content="Hush" Click="About_Click" Style="{StaticResource AccentTextButton}" FontSize="33" FontWeight="Medium" FontStyle="Italic" Height="52" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" AutomationProperties.Name="About Hush"/>
        <StackPanel x:Name="CaptionControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Style="{StaticResource CaptionButton}" Click="Settings_Click" Margin="0,0,4,0" ToolTip="Settings" AutomationProperties.Name="Settings">
            <Path Style="{StaticResource CaptionIcon}" Data="M8,1 L10,1 L10.6,3.2 L12.1,4.1 L14.3,3.5 L15.3,5.3 L13.8,6.9 L13.8,8.9 L15.3,10.5 L14.3,12.3 L12.1,11.7 L10.6,12.6 L10,14.8 L8,14.8 L7.4,12.6 L5.9,11.7 L3.7,12.3 L2.7,10.5 L4.2,8.9 L4.2,6.9 L2.7,5.3 L3.7,3.5 L5.9,4.1 L7.4,3.2 Z M11.4,7.9 A2.4,2.4 0 1 1 6.6,7.9 A2.4,2.4 0 1 1 11.4,7.9"/>
          </Button>
          <Button x:Name="ThemeButton" Style="{StaticResource CaptionButton}" Click="Theme_Click" Margin="0,0,8,0" ToolTip="Switch theme" AutomationProperties.Name="Switch theme">
            <Grid Width="18" Height="18">
              <Path x:Name="ThemeSunRays" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9,1 L9,2.2 M9,15.8 L9,17 M1,9 L2.2,9 M15.8,9 L17,9 M3.35,3.35 L4.2,4.2 M13.8,13.8 L14.65,14.65 M3.35,14.65 L4.2,13.8 M13.8,4.2 L14.65,3.35"/>
              <Ellipse x:Name="ThemeSunCore" Width="7" Height="7" StrokeThickness="1.5" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
            </Grid>
          </Button>
          <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" Margin="0,0,4,0" ToolTip="Minimize" AutomationProperties.Name="Minimize">
            <Path Style="{StaticResource CaptionIcon}" Stretch="None" Data="M4,9 L14,9"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
            <Path Style="{StaticResource CaptionIcon}" Stretch="None" Data="M4,4 L14,14 M14,4 L4,14"/>
          </Button>
        </StackPanel>
      </Grid>
      <Grid x:Name="MainContent" Grid.Row="1" Margin="30,8,30,24">
        <Grid x:Name="ScanPage">
          <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="166"/><RowDefinition Height="24"/></Grid.RowDefinitions>
          <StackPanel HorizontalAlignment="Center" Margin="16,20,16,0" MaxWidth="660">
            <TextBlock x:Name="Headline" Text="Make more room to breathe" FontSize="33" FontWeight="Normal" FontStyle="Italic" Foreground="{DynamicResource HeadingBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <Button x:Name="ScanCircleButton" local:Motion.Glow="0.04" Grid.Row="1" Width="320" Height="320" Click="Circle_Click" Padding="0" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Start a scan. Click again while scanning to stop." AutomationProperties.Name="Ready to scan">
            <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter x:Name="CircleContent"/></ControlTemplate></Button.Template>
            <Grid Width="320" Height="320">
              <Ellipse Fill="{DynamicResource PanelBrush}" Margin="35"/>
              <Ellipse Stroke="{DynamicResource RaisedBrush}" StrokeThickness="7" Margin="29"/>
              <Viewbox IsHitTestVisible="False"><Grid Width="158" Height="158">
                <Path x:Name="GaugeArc" Stroke="{DynamicResource TealBrush}" StrokeThickness="3.5" Opacity="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                  <Path.Effect><DropShadowEffect x:Name="GaugeFinishGlow" Color="{DynamicResource PrimaryAccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.22"/></Path.Effect>
                </Path>
              </Grid></Viewbox>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="230">
                <TextBlock x:Name="GaugeValue" Text="0%" Foreground="{DynamicResource TextBrush}" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="GaugeLabel" Text="Click to scan" FontSize="16" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
              </StackPanel>
            </Grid>
          </Button>
          <Grid x:Name="StatusSlot" Grid.Row="2" HorizontalAlignment="Center" Width="670" MaxWidth="670" Margin="20,0,20,8">
            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="40"/><RowDefinition Height="56"/></Grid.RowDefinitions>
            <TextBlock x:Name="StatusTitle" Text="Your files stay yours." Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
            <local:ScanActivity x:Name="FileScanActivity" Width="140" Height="36" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button x:Name="CompletionLinkButton" Click="OpenResults_Click" Visibility="Collapsed" Style="{StaticResource AccentTextButton}" Padding="12,5" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Open the list of what was found" AutomationProperties.Name="Open scanned files">
              <!-- Reads as a link: italic and underlined in its own ink, so the underline follows the hover color. No looping animation. -->
              <TextBlock x:Name="CompletionLinkText" Text="{Binding Text, ElementName=StatusTitle}" MaxWidth="570" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontStyle="Italic">
                <TextBlock.TextDecorations><TextDecoration Location="Underline" PenOffset="4" PenOffsetUnit="Pixel"/></TextBlock.TextDecorations>
              </TextBlock>
            </Button>
            <TextBlock x:Name="StatusDetail" Grid.Row="1" Text="Personal files and passwords are left alone." Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource CompactFontSize}" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <local:RollingFileCount x:Name="LiveFileCounter" Grid.Row="1" Visibility="Hidden" Height="22" Margin="0,4,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" FontFamily="{Binding FontFamily, ElementName=StatusDetail}" FontSize="{Binding FontSize, ElementName=StatusDetail}" FontWeight="{Binding FontWeight, ElementName=StatusDetail}" Foreground="{Binding Foreground, ElementName=StatusDetail}"/>
            <Button x:Name="HomeCleanButton" Grid.Row="2" Content="Clean" Click="HomeClean_Click" Style="{StaticResource DangerButton}" MinWidth="108" Height="40" FontSize="{DynamicResource CompactFontSize}" Padding="20,7" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
        <Grid x:Name="ReviewPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="96"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
              <TextBlock Text="Review files" FontSize="29" FontWeight="Normal" FontStyle="Italic" Foreground="{DynamicResource HeadingBrush}"/>
              <TextBlock x:Name="ResultCount" Text="Scan to find cleanup items" FontSize="{DynamicResource BodyFontSize}" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
            </StackPanel>
            <Button x:Name="BackButton" Grid.Column="1" Content="Back" Click="Back_Click" Style="{StaticResource BackButton}" VerticalAlignment="Top" Margin="0,6,-14,0" AutomationProperties.Name="Back"/>
          </Grid>
          <Border x:Name="CategorySurface" Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="14" Margin="0,8,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid x:Name="CategoryControls" Margin="61,8,33,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="SelectAllBox" Content="Select all categories" FontSize="{DynamicResource CompactFontSize}" FontWeight="Medium" VerticalAlignment="Center" Click="SelectAll_Click" IsEnabled="False"/>
            <TextBlock x:Name="ReadOnlyResultsLabel" Text="Partial results · read-only" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Button x:Name="CollapseAllButton" Grid.Column="2" Click="CollapseAll_Click" Style="{StaticResource TextButton}" Foreground="{DynamicResource TextBrush}" local:Motion.HoverForeground="{DynamicResource HeadingBrush}" Padding="16,9" VerticalAlignment="Center" AutomationProperties.Name="Expand all">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource NavigationIcon}" Data="M 1,1 L 6,6 L 11,1 M 1,7 L 6,12 L 11,7" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform x:Name="SectionToggleRotation"/></Path.RenderTransform></Path><TextBlock x:Name="SectionToggleLabel" Text="Expand all" VerticalAlignment="Center"/></StackPanel>
            </Button>
          </Grid>
          <ScrollViewer x:Name="ReviewScroll" Grid.Row="1" Style="{StaticResource PageScroll}" Padding="0,0,0,16">
            <ItemsControl x:Name="CategoriesList">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Expander Style="{StaticResource CategoryAccordion}" IsExpanded="{Binding Expanded, Mode=TwoWay}" Header="{Binding}" HeaderTemplate="{StaticResource CategoryHeaderTemplate}">
                  <Grid>
                    <ListBox ItemsSource="{Binding Files}" ItemTemplate="{StaticResource NeutralFileTemplate}" MaxHeight="280" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewMouseWheel="CategoryFiles_PreviewMouseWheel" AutomationProperties.Name="{Binding Title}">
                      <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Style.Triggers><DataTrigger Binding="{Binding Files.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
                    </ListBox>
                  </Grid>
                </Expander>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Grid></Border>
          <StackPanel x:Name="ReviewEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="28" Visibility="Collapsed">
            <TextBlock x:Name="EmptyStateTitle" Text="Everything looks clean." FontSize="22" FontWeight="Normal" FontStyle="Italic" Foreground="{DynamicResource HeadingBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="EmptyStateDetail" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0"/>
          </StackPanel>
          <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="SelectionDetails" VerticalAlignment="Center">
              <TextBlock x:Name="SelectionSummary" Text="Nothing selected" Foreground="{DynamicResource HeadingBrush}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="ReviewHint" Text="Selected files only. Confirmation required." FontSize="{DynamicResource SupportFontSize}" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="RescanButton" Content="Scan again" Click="Scan_Click" Style="{StaticResource TextButton}" Margin="0,0,12,0" Visibility="Collapsed" ToolTip="Scan again" AutomationProperties.Name="Scan again"/>
              <Button x:Name="PrimaryButton" Content="Start scan" Click="Primary_Click" Style="{StaticResource DangerButton}" MinWidth="156" Height="44" FontSize="{DynamicResource ActionFontSize}" Padding="18,9"/>
            </StackPanel>
          </Grid>
        </Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <Grid.Resources>
            <!-- One settings row: title, plain description and (only when it matters) a status line on the left, the on/off switch on the right.
                 A hairline divider separates rows; the first row of each card has none. -->
            <DataTemplate x:Key="AdjustmentTemplate">
              <StackPanel>
                <Border x:Name="RowDivider" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="21"/>
                    <TextBlock x:Name="RowStatus" Text="{Binding Status}" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
                </Grid>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasNotice}" Value="True"><Setter TargetName="RowStatus" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0"><Setter TargetName="RowDivider" Property="Visibility" Value="Collapsed"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </Grid.Resources>
          <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="Settings" FontSize="29" FontWeight="Medium" FontStyle="Italic" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Top" Margin="0,10,0,0"/>
            <Button x:Name="SettingsBackButton" Content="Back" Style="{StaticResource BackButton}" Click="SettingsBack_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,-14,0" AutomationProperties.Name="Back from settings"/>
          </Grid>
          <!-- The 8 DIP overlay scrollbar lives in a 22 DIP strip to the right of the cards (viewer extends into the page margin), so cards never shift or sit under it. -->
          <ScrollViewer x:Name="WindowsSettingsScroll" Grid.Row="1" Style="{StaticResource PageScroll}" Margin="0,8,-22,0" Padding="0,0,22,16">
            <StackPanel>
            <!-- Info: live figures from Windows (processor, memory, system drive), one smart summary line, Hush's own memory and the last junk check.
                 It is a plain card, not an accordion: the figures are always on screen and the Smart Boost controls stay uncluttered. -->
            <Border x:Name="SettingsInfoCard" Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="28,18,28,20" Margin="0,0,0,16" AutomationProperties.Name="Info">
              <StackPanel>
                <TextBlock Text="Info" FontSize="18" FontWeight="Medium" FontStyle="Italic" Foreground="{DynamicResource TealTextBrush}"/>
                <TextBlock x:Name="InfoSummary" Text="Reading this PC…" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                  <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Processor" FontSize="{DynamicResource SupportFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock x:Name="CpuText" Text="…" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                      <Border Height="6" CornerRadius="3" Background="{DynamicResource RaisedBrush}"><Border x:Name="CpuFill" CornerRadius="3" Background="{DynamicResource TealBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform></Border></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Memory" FontSize="{DynamicResource SupportFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock x:Name="MemoryText" Text="…" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                      <Border Height="6" CornerRadius="3" Background="{DynamicResource RaisedBrush}"><Border x:Name="MemoryFill" CornerRadius="3" Background="{DynamicResource TealBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform></Border></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="System drive" FontSize="{DynamicResource SupportFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock x:Name="DiskText" Text="…" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                      <Border Height="6" CornerRadius="3" Background="{DynamicResource RaisedBrush}"><Border x:Name="DiskFill" CornerRadius="3" Background="{DynamicResource TealBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform></Border></Border>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="ResourceNote" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                  <TextBlock x:Name="BoostStatus" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <Expander x:Name="SettingsBoostSection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="Smart Boost">
              <!-- The card shows the live details before it is opened: summary, three resource meters, Hush's own memory and the last check. -->
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="Smart Boost" FontSize="18" FontWeight="Medium" FontStyle="Italic" Foreground="{DynamicResource TealTextBrush}"/>
                  <TextBlock x:Name="BoostSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <!-- Quick Boost -->

                <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Quick Boost" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                    <TextBlock Text="Scans only the Safe items and shows you what it found before anything is removed." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="21"/>
                  </StackPanel>
                  <Button x:Name="QuickBoostButton" Grid.Column="2" Content="Quick Boost" Click="QuickBoost_Click" Style="{StaticResource AccentTextButton}" Padding="16,9" AutomationProperties.Name="Quick Boost"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Watch for junk" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                    <TextBlock Text="While Hush is open (also minimized) it now and then counts Safe junk, quietly and at low priority. Nothing is deleted; Hush only tells you." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="21"/>
                  </StackPanel>
                  <CheckBox x:Name="MonitorJunkBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Click="MonitorJunk_Click" VerticalAlignment="Center" AutomationProperties.Name="Watch for junk"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Automatic Boost" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                    <TextBlock Text="When Safe junk passes your threshold, Hush cleans those Safe items by itself. Review and Advanced items are never included. Off unless you turn it on." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="21"/>
                  </StackPanel>
                  <CheckBox x:Name="AutoBoostBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Click="AutoBoost_Click" VerticalAlignment="Center" AutomationProperties.Name="Automatic Boost"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <StackPanel x:Name="ThresholdRow" Margin="0,16">
                  <TextBlock Text="Cleanup threshold" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                  <TextBlock Text="How much Safe junk must build up before Hush mentions it (or cleans it, with Automatic Boost)." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,10" TextWrapping="Wrap" LineHeight="21"/>
                  <StackPanel Orientation="Horizontal" Margin="-13,0,0,0">
                    <RadioButton x:Name="Threshold500" GroupName="Threshold" Content="500 MB" Tag="500" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                    <RadioButton x:Name="Threshold1000" GroupName="Threshold" Content="1 GB" Tag="1000" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                    <RadioButton x:Name="Threshold2000" GroupName="Threshold" Content="2 GB" Tag="2000" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                    <RadioButton x:Name="Threshold5000" GroupName="Threshold" Content="5 GB" Tag="5000" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                  </StackPanel>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <StackPanel x:Name="IntervalRow" Margin="0,16">
                  <TextBlock Text="Check every" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                  <TextBlock Text="Longer gaps mean less background activity." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,10" TextWrapping="Wrap" LineHeight="21"/>
                  <StackPanel Orientation="Horizontal" Margin="-13,0,0,0">
                    <RadioButton x:Name="Interval15" GroupName="Interval" Content="15 minutes" Tag="15" Style="{StaticResource ChoiceChip}" Click="Interval_Click"/>
                    <RadioButton x:Name="Interval60" GroupName="Interval" Content="1 hour" Tag="60" Style="{StaticResource ChoiceChip}" Click="Interval_Click"/>
                    <RadioButton x:Name="Interval360" GroupName="Interval" Content="6 hours" Tag="360" Style="{StaticResource ChoiceChip}" Click="Interval_Click"/>
                    <RadioButton x:Name="Interval1440" GroupName="Interval" Content="Daily" Tag="1440" Style="{StaticResource ChoiceChip}" Click="Interval_Click"/>
                  </StackPanel>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Low-resource mode" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                    <TextBlock Text="Hush uses less processor and disk: lower priority, Windows efficiency mode, slower progress updates. Scans take a little longer." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="21"/>
                  </StackPanel>
                  <CheckBox x:Name="LowResourceBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Click="LowResource_Click" VerticalAlignment="Center" AutomationProperties.Name="Low-resource mode"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <!-- Startup apps: Task Manager's on/off flag per program. Nothing is uninstalled. -->
                <StackPanel Margin="0,16,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Startup apps" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock x:Name="StartupSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="UndoStartupButton" Grid.Column="1" Content="Undo" Click="UndoStartup_Click" Style="{StaticResource TextButton}" Visibility="Collapsed" VerticalAlignment="Top" AutomationProperties.Name="Undo startup change"/>
                  </Grid>
                  <TextBlock Text="Turning one off only stops it from starting with Windows. The program stays installed and you can turn it back on here." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,4"/>
                  <ItemsControl x:Name="StartupList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="StartupSwitch_Click" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="StartupStatus" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,8"/>
                </StackPanel>
              </StackPanel>
            </Expander>
            <Expander x:Name="SettingsPrivacySection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="Privacy and telemetry">
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="Privacy &amp; telemetry" FontSize="18" FontWeight="Medium" FontStyle="Italic" Foreground="{DynamicResource TealTextBrush}"/>
                  <TextBlock x:Name="PrivacySummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <TextBlock x:Name="WindowsSettingsSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"/>
                <ItemsControl x:Name="PrivacyAdjustments" AlternationCount="100" ItemTemplate="{StaticResource AdjustmentTemplate}" Margin="0,8,0,0"/>
              </StackPanel>
            </Expander>
            <Expander x:Name="SettingsImpactSection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="More impact" Margin="0">
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="More impact" FontSize="18" FontWeight="Medium" FontStyle="Italic" Foreground="{DynamicResource TealTextBrush}"/>
                  <TextBlock x:Name="ImpactSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <TextBlock Text="These can remove Windows features, so read each one first. Nothing here uninstalls apps or turns off services." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"/>
                <ItemsControl x:Name="AdvancedAdjustments" AlternationCount="100" ItemTemplate="{StaticResource AdjustmentTemplate}" Margin="0,8,0,0"/>
              </StackPanel>
            </Expander>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="WindowsSettingsStatus" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,10"/>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="RefreshWindowsSettingsButton" Content="Refresh" Click="RefreshWindowsSettings_Click" Style="{StaticResource TextButton}"/>
              <Button x:Name="UndoWindowsSettingsButton" Grid.Column="2" Content="Undo changes" Click="UndoWindowsSettings_Click" Style="{StaticResource TextButton}" IsEnabled="False"/>
              <Button x:Name="ApplyWindowsSettingsButton" Grid.Column="4" Content="Review changes" Click="ApplyWindowsSettings_Click" IsEnabled="False"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
      </Grid>
      <Border x:Name="ModalOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed">
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="24" Width="510" Padding="34" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Confirm cleanup" FontSize="{DynamicResource CompactFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock Text="Are you sure?" FontSize="28" FontWeight="Normal" FontStyle="Italic" Foreground="{DynamicResource HeadingBrush}" Margin="0,12,0,0"/>
            <TextBlock x:Name="ConfirmSummary" Foreground="{DynamicResource TextBrush}" FontSize="17" TextWrapping="Wrap" Margin="0,22,0,0" LineHeight="26"/>
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
              <TextBlock x:Name="ConfirmDetail" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="25" Margin="0,0,10,0"/>
            </ScrollViewer>
            <!-- Advanced (red) cleanups are irreversible or touch recovery data: Clean stays off until this is ticked. -->
            <CheckBox x:Name="AdvancedConsentBox" Visibility="Collapsed" Click="AdvancedConsent_Click" Style="{StaticResource CandidateCheckBox}" Tag="{DynamicResource CleanTextBrush}" Margin="0,18,0,0" FontSize="{DynamicResource CompactFontSize}" Content="I understand some of this cannot be undone" IsEnabled="True" AutomationProperties.Name="I understand some of this cannot be undone"/>
            <Border Height="28"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="CancelDeleteButton" Content="Keep my files" Click="CancelDelete_Click" Padding="12,9" FontSize="{DynamicResource ActionFontSize}"/>
              <Button x:Name="ConfirmDeleteButton" Grid.Column="2" Content="Clean selected" Click="ConfirmDelete_Click" Style="{StaticResource DangerButton}" Padding="12,9" FontSize="{DynamicResource ActionFontSize}"/>
            </Grid>
          </StackPanel>
        </Border>
      </Border>
      <Border x:Name="WindowsSettingsOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
        <Border x:Name="WindowsSettingsCard" Background="{DynamicResource PanelBrush}" CornerRadius="24" Width="550" MaxHeight="650" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="WindowsConfirmTitle" Text="Apply Windows changes?" FontSize="28" FontWeight="Normal" FontStyle="Italic" Foreground="{DynamicResource HeadingBrush}"/>
            <ScrollViewer Grid.Row="1" MaxHeight="410" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,22,0,24">
              <StackPanel>
                <TextBlock x:Name="WindowsConfirmSummary" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="25"/>
                <TextBlock x:Name="WindowsConfirmDetail" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="23" Margin="0,20,0,0"/>
              </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="CancelWindowsSettingsButton" Content="Cancel" Click="CancelWindowsSettings_Click" Style="{StaticResource TextButton}"/>
              <Button x:Name="ConfirmWindowsSettingsButton" Grid.Column="2" Content="Apply changes" Click="ConfirmWindowsSettings_Click"/>
            </Grid>
          </Grid>
        </Border>
      </Border>
      <Border x:Name="AboutOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed">
        <Border x:Name="AboutCard" Background="{DynamicResource PanelBrush}" CornerRadius="24" Width="500" MaxHeight="650" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel KeyboardNavigation.TabNavigation="Cycle">
            <TextBlock Text="Hush" FontSize="28" FontWeight="Normal" FontStyle="Italic" Foreground="{DynamicResource TealTextBrush}"/>
            <TextBlock x:Name="AboutVersion" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
            <TextBlock x:Name="AboutDescription" Text="A portable Windows cleaner. Review before you clean." FontSize="17" LineHeight="26" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,20,0,0"/>
            <local:AccordionBody x:Name="AboutUpdatesBody" Visibility="Collapsed" IsEnabled="{Binding Expanded, RelativeSource={RelativeSource Self}}" IsHitTestVisible="{Binding Expanded, RelativeSource={RelativeSource Self}}">
              <StackPanel Margin="0,24,0,0">
                <ScrollViewer x:Name="UpdateDetailsScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock x:Name="UpdateStatus" Text="Check for the latest release." FontSize="{DynamicResource CompactFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="22"/>
                    <TextBlock x:Name="UpdateHint" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"/>
                    <local:UpdateActivity x:Name="UpdateSweep" Height="4" Margin="0,14,0,0"/>
                    <Border x:Name="PatchNotesPanel" Margin="0,20,0,0"><StackPanel>
                      <TextBlock x:Name="PatchNotesHeading" Text="Installed release" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock x:Name="PatchNotes" FontSize="{DynamicResource CompactFontSize}" TextWrapping="Wrap" LineHeight="23" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                  </StackPanel>
                </ScrollViewer>
                <Button x:Name="CancelUpdateButton" Content="Cancel" Click="CancelUpdate_Click" Style="{StaticResource TextButton}" Padding="0,9" HorizontalAlignment="Right" Visibility="Collapsed"/>
              </StackPanel>
            </local:AccordionBody>
            <!-- Footer: quiet secondary Release notes at the left, the primary Cyan Check for updates centered in the open space, Close at the right. -->
            <Grid Margin="0,28,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="AboutUpdatesButton" Content="Release notes" Click="AboutUpdates_Click" Style="{StaticResource TextButton}" Padding="0,9" AutomationProperties.Name="Show release notes"/>
              <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="Check for updates" Click="CheckUpdate_Click" Style="{StaticResource AccentTextButton}" Padding="16,9" HorizontalAlignment="Center"/>
              <Button x:Name="CloseAboutButton" Grid.Column="2" Content="Close" Click="CloseAbout_Click" Style="{StaticResource TextButton}" Padding="0,9"/>
            </Grid>
          </StackPanel>
        </Border>
      </Border>
      <!-- Drawn after (above) the About card so the update confirmation appears on top of it. -->
      <Border x:Name="ConsentOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="24" Width="510" Padding="34" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock x:Name="ConsentTitle" FontSize="28" FontWeight="Normal" FontStyle="Italic" Foreground="{DynamicResource HeadingBrush}" TextWrapping="Wrap"/>
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,26">
              <TextBlock x:Name="ConsentText" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="25" Margin="0,0,10,0"/>
            </ScrollViewer>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="ConsentCancelButton" Content="Not now" Click="ConsentCancel_Click" Style="{StaticResource TextButton}" FontSize="{DynamicResource ActionFontSize}"/>
              <Button x:Name="ConsentConfirmButton" Grid.Column="2" Content="Turn on" Click="ConsentConfirm_Click" Padding="12,9" FontSize="{DynamicResource ActionFontSize}"/>
            </Grid>
          </StackPanel>
        </Border>
      </Border>
      <Thumb Grid.RowSpan="2" Height="5" Margin="24,0" VerticalAlignment="Top" Cursor="SizeNS" Tag="T" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Height="5" Margin="24,0" VerticalAlignment="Bottom" Cursor="SizeNS" Tag="B" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="5" Margin="0,24" HorizontalAlignment="Left" Cursor="SizeWE" Tag="L" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="5" Margin="0,24" HorizontalAlignment="Right" Cursor="SizeWE" Tag="R" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Tag="TL" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Tag="TR" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Tag="BL" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Tag="BR" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
    </Grid>
  </Border>
</Window>
