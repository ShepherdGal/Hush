<Window x:Class="Hush.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hush"
        Title="Hush · Make more room to breathe" Icon="/Hush;component/Assets/Hush.ico" Width="920" Height="820" MinWidth="920" MinHeight="820" MaxWidth="920" MaxHeight="820" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize" Closing="Window_Closing" Loaded="Window_Loaded">
  <Window.Resources>
    <local:ReviewRowWidthConverter x:Key="ReviewRowWidth"/>
    <DataTemplate x:Key="NeutralFileTemplate">
      <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}, Converter={StaticResource ReviewRowWidth}, ConverterParameter=6}" Background="{DynamicResource RaisedBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,7" ToolTip="{Binding Path}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource CandidateCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay}" Tag="{Binding SelectionAccent}" AutomationProperties.Name="{Binding Path}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="FileName" Text="{Binding Name}" local:Motion.Ink="{DynamicResource TextBrush}" FontSize="{DynamicResource BodyFontSize}" FontWeight="Medium" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DirectoryLabel}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"/>
            <TextBlock Text="{Binding Outcome}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource TextBrush}" TextAlignment="Right" FontSize="{DynamicResource CompactFontSize}" FontFamily="Cascadia Mono, Consolas"/>
            <TextBlock Text="{Binding GroupLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SupportFontSize}" TextAlignment="Right" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="FileName" Property="local:Motion.Ink" Value="{Binding SelectionAccent}"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <!-- A sub-heading inside a category's list: the app's name and what it holds, a short colored line in the category's color (same line as the card's). -->
    <!-- Per-app row (owner, November 14, 2026): its own checkbox for that app's files and a chevron that opens its files (closed at first). -->
    <DataTemplate x:Key="SubHeadingTemplate">
      <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}, Converter={StaticResource ReviewRowWidth}, ConverterParameter=6}" Margin="0,2,0,5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="10"/><ColumnDefinition Width="22"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{Binding Category.TextAccent}" Width="4" CornerRadius="2" Margin="0,8"/>
        <CheckBox Grid.Column="2" Style="{StaticResource CandidateCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay}" IsThreeState="False" Tag="{Binding SelectionAccent}" AutomationProperties.Name="{Binding SelectName}" VerticalAlignment="Center"/>
        <ToggleButton Grid.Column="4" Style="{StaticResource TopicHeader}" IsChecked="{Binding IsOpen, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource HeadingBrush}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SupportFontSize}" Margin="12,2,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
      </Grid>
    </DataTemplate>
    <local:ReviewRowTemplateSelector x:Key="ReviewRows" File="{StaticResource NeutralFileTemplate}" Heading="{StaticResource SubHeadingTemplate}"/>
    <!-- A category card's header (Phase D): its name and plain description, a lock with "Restart as administrator" when some of its items need administrator
         mode (owner, November 19, 2026: only the items that are already locked), its size and count at the right, and the chevron. -->
    <DataTemplate x:Key="CategoryHeaderTemplate">
        <Grid x:Name="HeaderRoot" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="CategoryTitle" Text="{Binding Title}" local:Motion.Ink="{DynamicResource HeadingBrush}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SupportFontSize}" TextWrapping="Wrap" LineHeight="20" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel x:Name="LockArea" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
            <Path Width="16" Height="16" Stretch="None" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"
                  Data="M4.2,7.2 L11.8,7.2 Q13,7.2 13,8.4 L13,13.2 Q13,14.4 11.8,14.4 L4.2,14.4 Q3,14.4 3,13.2 L3,8.4 Q3,7.2 4.2,7.2 Z M5.4,7.2 L5.4,5 A2.6,2.6 0 0 1 10.6,5 L10.6,7.2" ToolTip="Some of these need administrator mode" AutomationProperties.Name="Locked: needs administrator mode"/>
            <Button Content="Restart as administrator" Click="RestartAsAdministrator_Click" Style="{StaticResource AccentOutlineButton}" Height="32" Padding="14,0" FontSize="14" Margin="10,0,0,0" ToolTip="Hush restarts with Windows' own permission prompt; scan again afterwards to clean these too"/>
          </StackPanel>
          <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="{Binding TotalLabel}" Foreground="{DynamicResource HeadingBrush}" FontSize="{DynamicResource BodyFontSize}" FontWeight="Medium" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
            <TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="13" HorizontalAlignment="Right" Margin="0,2,0,0"/>
          </StackPanel>
          <Grid Grid.Column="4" Width="10" Height="5" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><RotateTransform x:Name="ChevronRotation"/></Grid.RenderTransform>
            <Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            <Path x:Name="ChevronHover" Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
          </Grid>
        </Grid>
      <DataTemplate.Triggers>
      <Trigger SourceName="HeaderRoot" Property="IsMouseOver" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
      </Trigger>
      <DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="CategoryTitle" Property="local:Motion.Ink" Value="{Binding TextAccent}"/></DataTrigger>
      <DataTrigger Binding="{Binding HasLocked}" Value="True"><Setter TargetName="LockArea" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Expanded}" Value="True">
        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
        <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
      </DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <!-- Every category is its own card (Phase D): panel fill, glass edge, 18 corners, 10 DIP apart; a 3 DIP line in its risk color, its checkbox, the header;
         the files open below. A selected card gets an outline in its risk color (an overlay: never covers or shifts content). -->
    <Style x:Key="CategoryAccordion" TargetType="Expander">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <Grid Margin="0,0,0,10">
          <Border CornerRadius="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1"/>
          <StackPanel>
            <Border Padding="14,12,14,12" ToolTip="{Binding Description}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="14"/><ColumnDefinition Width="22"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{Binding TextAccent}" Width="3" Margin="0,4" CornerRadius="1.5"/>
            <CheckBox Grid.Column="2" Style="{StaticResource CandidateCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay}" Tag="{Binding TextAccent}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title, StringFormat=Select {0}}"/>
            <ToggleButton Grid.Column="4" x:Name="HeaderSite" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" BorderThickness="0" FocusVisualStyle="{x:Null}" Cursor="Hand" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            </Grid></Border>
            <local:AccordionBody Expanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
              <ContentPresenter Margin="14,0,14,12"/>
            </local:AccordionBody>
          </StackPanel>
          <Border x:Name="SelectionOutline" CornerRadius="18" BorderThickness="1" Opacity="0.7" IsHitTestVisible="False" SnapsToDevicePixels="False" local:Motion.Ink="Transparent"/>
        </Grid>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="SelectionOutline" Property="local:Motion.Ink" Value="{Binding TextAccent}"/></DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Tweaks rows (owner, November 20, 2026: the Software Updates layout, option A of the mockups): a soft rounded row, an icon tile for its topic, the
         name with its "?" over one muted line, a level chip, and the switch at the far right. A staged change takes the accent tint and a 3 DIP accent line at
         the left; hover gives the accent edge. One look for Privacy, More impact, Windows tweaks, Services, Tasks and Startup. -->
    <local:TopicIconConverter x:Key="TopicIcon"/>
    <!-- One service, scheduled task, Windows tweak or startup item (OffSwitchChoice). The switch keeps its meaning (ON = turn this off / apply the tweak). -->
    <DataTemplate x:Key="ServiceTemplate">
      <Grid x:Name="RowRoot" Margin="0,2" Background="Transparent">
        <Border x:Name="Row" CornerRadius="12" Background="{DynamicResource RaisedBrush}" BorderBrush="Transparent" BorderThickness="1"/>
        <Border x:Name="StagedLine" Width="3" CornerRadius="2" Margin="0,10" Background="{DynamicResource TealTextBrush}" HorizontalAlignment="Left" Visibility="Collapsed"/>
        <Grid Margin="12,9,14,9">
          <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" SharedSizeGroup="OffSwitchLevel"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSelectedBrush}" BorderBrush="{DynamicResource AccentSelectedEdgeBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
            <local:GlyphIcon Data="{Binding Converter={StaticResource TopicIcon}}" Stroke="{DynamicResource TealTextBrush}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}"/><InlineUIContainer BaselineAlignment="Center"><local:HelpMark Style="{StaticResource HelpMark}" HelpText="{Binding HelpText}" AutomationProperties.Name="{Binding HelpName}"/></InlineUIContainer></TextBlock>
            <TextBlock Text="{Binding Status}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
          </StackPanel>
          <!-- Stop now (services only): a quiet button before the chip, so the chips and switches line up whatever is shown. -->
          <Button x:Name="StopNowButton" Grid.Column="2" Content="Stop now" Click="StopService_Click" Style="{StaticResource TextButton}" Height="32" Padding="10,0" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="{Binding StopLabel}" ToolTip="Stop it now; it keeps its setting and can start again when needed"/>
          <Grid Grid.Column="3" Height="24" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Border x:Name="ChipFill" CornerRadius="12" Background="{DynamicResource GoodSoftBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
              <Ellipse x:Name="ChipDot" Width="6" Height="6" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="ChipText" Text="{Binding LevelLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" Margin="6,0,0,1" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <CheckBox Grid.Column="5" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding On, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
        </Grid>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Amber}" Value="True">
          <Setter TargetName="ChipFill" Property="Background" Value="{DynamicResource WarnSoftBrush}"/><Setter TargetName="ChipDot" Property="Fill" Value="{DynamicResource MeterWarnBrush}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource MeterWarnBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding CanStopNow}" Value="True"><Setter TargetName="StopNowButton" Property="Visibility" Value="Visible"/></DataTrigger>
        <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/></Trigger>
        <DataTrigger Binding="{Binding Staged}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource SoftAccentBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/><Setter TargetName="StagedLine" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- One Windows privacy choice (AdjustmentChoice) on the same row: the level chip says Recommended (green) or Somewhat recommended (amber); a blocked
         choice says why on its line in amber. -->
    <DataTemplate x:Key="AdjustmentTemplate">
      <Grid x:Name="RowRoot" Margin="0,2" Background="Transparent">
        <Border x:Name="Row" CornerRadius="12" Background="{DynamicResource RaisedBrush}" BorderBrush="Transparent" BorderThickness="1"/>
        <Border x:Name="StagedLine" Width="3" CornerRadius="2" Margin="0,10" Background="{DynamicResource TealTextBrush}" HorizontalAlignment="Left" Visibility="Collapsed"/>
        <Grid Margin="12,9,14,9">
          <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSelectedBrush}" BorderBrush="{DynamicResource AccentSelectedEdgeBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
            <local:GlyphIcon Data="{Binding Converter={StaticResource TopicIcon}}" Stroke="{DynamicResource TealTextBrush}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}"/><InlineUIContainer BaselineAlignment="Center"><local:HelpMark Style="{StaticResource HelpMark}" HelpText="{Binding HelpText}" AutomationProperties.Name="More about this setting"/></InlineUIContainer></TextBlock>
            <TextBlock x:Name="RowStatus" Text="{Binding Topic}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Grid Grid.Column="2" Height="24" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Border x:Name="ChipFill" CornerRadius="12" Background="{DynamicResource GoodSoftBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
              <Ellipse x:Name="ChipDot" Width="6" Height="6" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="ChipText" Text="{Binding LevelLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" Margin="6,0,0,1" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <CheckBox Grid.Column="4" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
        </Grid>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsBlocked}" Value="True"><Setter TargetName="RowStatus" Property="Text" Value="{Binding Status}"/><Setter TargetName="RowStatus" Property="Foreground" Value="{DynamicResource MeterWarnBrush}"/><Setter TargetName="RowStatus" Property="TextWrapping" Value="Wrap"/></DataTrigger>
        <DataTrigger Binding="{Binding Advanced}" Value="True">
          <Setter TargetName="ChipFill" Property="Background" Value="{DynamicResource WarnSoftBrush}"/><Setter TargetName="ChipDot" Property="Fill" Value="{DynamicResource MeterWarnBrush}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource MeterWarnBrush}"/>
        </DataTrigger>
        <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/></Trigger>
        <DataTrigger Binding="{Binding Staged}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource SoftAccentBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/><Setter TargetName="StagedLine" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- A tool inside the focus card (Phase D): its header, then its content, always shown; only the open tool is visible (MainWindow.ToolsPage.cs). -->
    <Style x:Key="ToolSection" TargetType="Expander">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ContentPresenter ContentSource="Header" Margin="0,16,0,12"/>
          <ContentPresenter/>
        </StackPanel>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Icon tabs (owner, November 20, 2026: the Software Updates layout, reused by Tweaks, Startup and Browser extensions): a line icon, the name, a count badge
         that turns accent while the tab holds something, a small accent dot while it holds a staged change; the accent underline springs to the open tab.
         One template for every such bar; IconTab_Select hands the click to the bar it belongs to. -->
    <ItemsPanelTemplate x:Key="IconTabsPanel"><local:SegmentPanel Orientation="Horizontal" Underline="True" ThumbBrush="{DynamicResource TealTextBrush}"/></ItemsPanelTemplate>
    <Style x:Key="IconTabContainer" TargetType="ContentPresenter"><Setter Property="local:SegmentPanel.IsSelected" Value="{Binding Open}"/></Style>
    <DataTemplate x:Key="IconTabTemplate">
      <Grid Margin="0,0,18,0">
        <Button Click="IconTab_Select" Tag="{Binding}" Style="{StaticResource TextButton}" Foreground="{Binding Ink}" local:Motion.MouseOnly="True" Padding="2,0" Height="42" AutomationProperties.Name="{Binding SpokenName}">
          <StackPanel Orientation="Horizontal">
            <local:GlyphIcon x:Name="Icon" Data="{Binding IconGeometry}" Stroke="{Binding Ink}" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource SupportFontSize}" FontWeight="Medium" VerticalAlignment="Center"/>
            <Border x:Name="Badge" Visibility="{Binding BadgeVisible}" MinWidth="22" Height="22" CornerRadius="11" Padding="6,0" Margin="8,1,0,0" Background="{DynamicResource RaisedBrush}" BorderBrush="Transparent" BorderThickness="1" VerticalAlignment="Center">
              <TextBlock x:Name="BadgeText" Text="{Binding Count}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Ellipse Width="6" Height="6" Fill="{DynamicResource TealTextBrush}" Margin="6,1,0,0" VerticalAlignment="Center" Visibility="{Binding StagedDot}"/>
          </StackPanel>
        </Button>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasUpdates}" Value="True">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AccentSelectedBrush}"/>
          <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/>
          <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TealTextBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IconGeometry}" Value="{x:Null}"><Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- The left rail of Tools and Tweaks (owner, November 21, 2026: one screen, the rail always on the left, Overview first): the Settings index's look (28 DIP
         icon chip, name, the selected pill that springs to the entry picked) with a small accent dot while an entry holds a staged change. -->
    <ItemsPanelTemplate x:Key="RailPanel"><local:SegmentPanel ThumbBrush="{DynamicResource AccentSelectedBrush}" ThumbEdge="{DynamicResource AccentSelectedEdgeBrush}" ThumbRadius="12"/></ItemsPanelTemplate>
    <DataTemplate x:Key="RailTemplate">
      <Button Click="Rail_Select" Tag="{Binding}" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Padding="0" Height="40" Margin="0,0,0,2" HorizontalContentAlignment="Stretch" ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding SpokenName}">
        <Grid Margin="6,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource RaisedBrush}">
            <Path x:Name="Icon" Data="{Binding RailIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" Stretch="None" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center"><Path.RenderTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.RenderTransform></Path>
          </Border>
          <TextBlock x:Name="Label" Grid.Column="2" Text="{Binding Label}" FontSize="{DynamicResource SupportFontSize}" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Ellipse Grid.Column="3" Width="6" Height="6" Fill="{DynamicResource TealTextBrush}" Margin="6,1,0,0" VerticalAlignment="Center" Visibility="{Binding StagedDot}"/>
        </Grid>
      </Button>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Open}" Value="True"><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource HeadingBrush}"/><Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource TealTextBrush}"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <!-- One suggestion on an Overview (owner's pick B, November 21, 2026): an accent icon tile, what is worth a look, one plain line, and one button that opens it;
         the row takes the soft accent tint and edge on hover, like the Software Updates rows. -->
    <DataTemplate x:Key="SuggestionTemplate">
      <Border x:Name="Row" CornerRadius="14" Background="{DynamicResource RaisedBrush}" BorderBrush="Transparent" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSelectedBrush}" BorderBrush="{DynamicResource AccentSelectedEdgeBrush}" BorderThickness="1" VerticalAlignment="Center">
            <Path Data="{Binding Icon}" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource SupportFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Line}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
          <Button Grid.Column="4" Content="{Binding Action}" Click="Suggestion_Click" Tag="{Binding}" Style="{StaticResource AccentOutlineButton}" Height="32" Padding="16,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding SpokenName}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers><Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SoftAccentBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/></Trigger></DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Border x:Name="WindowSurface" CornerRadius="24" Background="{DynamicResource WindowGradientBrush}" SizeChanged="Surface_SizeChanged">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <!-- Frost + Prism (Phase D): the night-navy gradient (WindowSurface) and one soft accent glow from the top-left corner, both painted once, never animated
           except by a theme change, never an effect. -->
      <Border x:Name="WindowGlowLayer" Grid.RowSpan="2" CornerRadius="24" Background="{DynamicResource WindowGlowBrush}" IsHitTestVisible="False"/>
      <!-- The same gradient and glow painted by Hush itself, dithered so no bands show (UI/MainWindow.Backdrop.cs); hidden until painted and during theme changes. -->
      <Border x:Name="BackdropLayer" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Hidden" SizeChanged="BackdropLayer_SizeChanged">
        <!-- A plain image at exactly 1:1 (its DPI is set to the device's): the renderer's fast copy path, never resampled; the window's own clip rounds the corners. -->
        <Image x:Name="BackdropImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      </Border>
      <Grid x:Name="AppSurface" Grid.RowSpan="2">
      <Grid.Effect><BlurEffect x:Name="BackgroundBlur" Radius="0" RenderingBias="Quality"/></Grid.Effect>
      <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <!-- The frosted header band: a faint cool strip behind the header with one hairline under it. -->
      <Border x:Name="HeaderBand" CornerRadius="24,24,0,0" Background="{DynamicResource HeaderBandBrush}" BorderBrush="{DynamicResource HeaderBandEdgeBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
      <!-- The header (Phase D, owner, November 19, 2026): three columns so the tab bar sits exactly in the window's center. Left: the wordmark (a green dot on it when
           an update exists) and the Simple | Expert pill. Middle: the five tabs (Simple mode shows Home and Settings). Right: the sun / full-moon theme slider,
           minimize and close. Glass is flat like the cards; the selected tab, the chosen mode and the theme thumb share one accent "selected" look. -->
      <Grid x:Name="HeaderBar" Margin="18,0,18,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" SizeChanged="HeaderBar_SizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="HeaderLeft" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Grid VerticalAlignment="Center">
            
            <Button x:Name="AboutButton" Content="Hush" Click="About_Click" Style="{StaticResource AccentTextButton}" Foreground="{DynamicResource HeadingBrush}" local:Motion.MouseOnly="True" local:Motion.HoverForeground="{DynamicResource HeadingBrush}" FontSize="24" FontWeight="Medium" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" AutomationProperties.Name="About Hush"/>
            <!-- 0.9 update notice, Phase D look (owner): a small green dot on the wordmark when a newer version exists; a click opens the update popup. -->
            <Button x:Name="UpdateNoticeButton" Click="UpdateNotice_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Width="16" Height="16" Padding="0" Margin="0,6,-14,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" ToolTip="Update available" AutomationProperties.Name="A new update is available: open the update window">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource GoodBrush}"/>
            </Button>
          </Grid>
          <!-- Simple | Expert (owner, November 19, 2026): one flat glass pill; the chosen half sits on the accent "selected" thumb, which slides by a transform.
               Switching to Expert asks first (the shared consent popup); switching back to Simple asks nothing. -->
          <Border x:Name="ModePill" Margin="18,0,0,0" CornerRadius="16" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Padding="2" VerticalAlignment="Center">
            <Grid x:Name="ProModeSlot">
              <Border x:Name="ModeThumb" Width="62" Height="26" CornerRadius="13" HorizontalAlignment="Left" Background="{DynamicResource AccentSelectedBrush}" BorderBrush="{DynamicResource AccentSelectedEdgeBrush}" BorderThickness="1" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform x:Name="ModeThumbShift"/></Border.RenderTransform>
              </Border>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="SimpleModeButton" Style="{StaticResource ModeSegment}" Tag="On" Click="SimpleMode_Click" ToolTip="Simple mode is on." AutomationProperties.Name="Simple mode, on">
                  <Grid><TextBlock Text="Simple" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                </Button>
                <Button x:Name="ProModeButton" Style="{StaticResource ModeSegment}" Tag="Off" Click="ProMode_Click" ToolTip="Expert mode is off. Turn it on to see everything Hush can do." AutomationProperties.Name="Expert mode, off">
                  <Grid><TextBlock Text="Expert" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- The tabs (owner, November 19, 2026): equal width, one flat glass bar, the selected pill moves by a transform (ease-in-out 280 ms; instant from
             the keyboard, Ctrl+1 to Ctrl+5). The names SettingsButton and ToolsButton are kept for the Settings and Tools tabs. -->
        <Border x:Name="TabBar" Grid.Column="1" CornerRadius="20" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Padding="3" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Grid>
            <Border x:Name="TabPill" Width="76" Height="32" CornerRadius="16" HorizontalAlignment="Left" Background="{DynamicResource AccentSelectedBrush}" BorderBrush="{DynamicResource AccentSelectedEdgeBrush}" BorderThickness="1" IsHitTestVisible="False">
              <Border.RenderTransform><TranslateTransform x:Name="TabPillShift"/></Border.RenderTransform>
            </Border>
            <StackPanel x:Name="TabStrip" Orientation="Horizontal">
              <Button x:Name="HomeTabButton" Style="{StaticResource HeaderTab}" Tag="On" Click="HomeTab_Click" ToolTip="Home (Ctrl+1)" AutomationProperties.Name="Home">
                <Grid><TextBlock Text="Home" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
              </Button>
              <Button x:Name="CleanTabButton" Style="{StaticResource HeaderTab}" Tag="Off" Click="CleanTab_Click" ToolTip="Clean (Ctrl+2)" AutomationProperties.Name="Clean">
                <Grid><TextBlock Text="Clean" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
              </Button>
              <Button x:Name="ToolsButton" Style="{StaticResource HeaderTab}" Tag="Off" Click="Tools_Click" ToolTip="Tools (Ctrl+3)" AutomationProperties.Name="Tools">
                <Grid><TextBlock Text="Tools" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
              </Button>
              <Button x:Name="TweaksTabButton" Style="{StaticResource HeaderTab}" Tag="Off" Click="TweaksTab_Click" ToolTip="Tweaks (Ctrl+4)" AutomationProperties.Name="Tweaks">
                <Grid><TextBlock Text="Tweaks" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
              </Button>
              <Button x:Name="SettingsButton" Style="{StaticResource HeaderTab}" Tag="Off" Click="Settings_Click" ToolTip="Settings (Ctrl+5)" AutomationProperties.Name="Settings">
                <Grid><TextBlock Text="Settings" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel x:Name="CaptionControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <!-- The theme: a sun / full-moon slider (owner, November 19, 2026: never a crescent). The accent thumb sits under the current theme's icon and slides
               by a transform; the current icon is the accent, the other one faint. -->
          <Button x:Name="ThemeButton" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Click="Theme_Click" Width="60" Height="30" Padding="0" Margin="0,0,8,0" ToolTip="Switch theme" AutomationProperties.Name="Switch theme">
            <Grid Width="60" Height="30">
              <Border CornerRadius="15" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1"/>
              <Ellipse x:Name="ThemeThumb" Width="24" Height="24" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{DynamicResource AccentSelectedBrush}" Stroke="{DynamicResource AccentSelectedEdgeBrush}" StrokeThickness="1">
                <Ellipse.RenderTransform><TranslateTransform x:Name="ThemeThumbShift"/></Ellipse.RenderTransform>
              </Ellipse>
              <Path x:Name="ThemeSunIcon" Width="16" Height="16" HorizontalAlignment="Left" Margin="7,0,0,0" Stretch="None" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M8,4.6 A3.4,3.4 0 1 1 7.99,4.6 M8,0.6 L8,2.4 M8,13.6 L8,15.4 M0.6,8 L2.4,8 M13.6,8 L15.4,8 M2.8,2.8 L4.1,4.1 M11.9,11.9 L13.2,13.2 M2.8,13.2 L4.1,11.9 M11.9,4.1 L13.2,2.8"/>
              <Grid x:Name="ThemeMoonIcon" Width="16" Height="16" HorizontalAlignment="Right" Margin="0,0,7,0">
                <Ellipse x:Name="ThemeMoonDisc" Width="12.4" Height="12.4" StrokeThickness="1.5" Stroke="{DynamicResource TealTextBrush}"/>
                <Ellipse x:Name="ThemeMoonCrater1" Width="3.4" Height="3.4" Margin="3.4,-3.0,0,0" Fill="{DynamicResource TealTextBrush}" Opacity="0.55"/>
                <Ellipse x:Name="ThemeMoonCrater2" Width="2.2" Height="2.2" Margin="-3.6,2.4,0,0" Fill="{DynamicResource TealTextBrush}" Opacity="0.45"/>
              </Grid>
            </Grid>
          </Button>
          <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" Width="34" Height="34" Padding="8" Margin="0,0,2,0" ToolTip="Minimize" AutomationProperties.Name="Minimize">
            <Path Style="{StaticResource CaptionIcon}" Stretch="None" Data="M4,9 L14,9"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="Close_Click" Width="34" Height="34" Padding="8" ToolTip="Close" AutomationProperties.Name="Close">
            <Path Style="{StaticResource CaptionIcon}" Stretch="None" Data="M4,4 L14,14 M14,4 L4,14"/>
          </Button>
        </StackPanel>
      </Grid>
      <Grid x:Name="MainContent" Grid.Row="1" Margin="30,8,30,24">
        <Grid.Resources>
              <!-- Each topic is a collapsible group (chevron, name, count); open topics are remembered while Settings is open, and a search opens them all. -->
              <GroupStyle x:Key="AdjustmentGroups">
                <GroupStyle.ContainerStyle>
                  <Style TargetType="GroupItem">
                    <Setter Property="Template"><Setter.Value>
                      <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                          <ToggleButton x:Name="TopicToggle" Uid="topic" Style="{StaticResource TopicHeader}" Loaded="Topic_Loaded" Checked="Topic_Changed" Unchecked="Topic_Changed">
                            <TextBlock FontSize="{DynamicResource CompactFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource FaintBrush}" FontWeight="Normal"/></TextBlock>
                          </ToggleButton>
                          <local:AccordionBody Expanded="{Binding IsChecked, ElementName=TopicToggle}" IsEnabled="{Binding Expanded, RelativeSource={RelativeSource Self}}"><ItemsPresenter/></local:AccordionBody>
                        </StackPanel>
                      </ControlTemplate>
                    </Setter.Value></Setter>
                  </Style>
                </GroupStyle.ContainerStyle>
              </GroupStyle>
        </Grid.Resources>
        <!-- Home (Phase D, owner, November 19, 2026; the design notes "Next look"): the heading, the thin glowing ring (still the scan button), the result line with
             Take a look and Clean, the status tiles (Expert mode) and the This PC card (meters every 5 s while Hush is in front, Boost). -->
        <Grid x:Name="ScanPage">
          <!-- Owner, November 20, 2026: the heading, the gauge and its text are one block in the middle between the header and the tiles, the same gap above as below
               in every state; when the block grows or shrinks (Take a look and Clean appear) it glides to its new place (HomeBlock, UI/MainWindow.Home.cs). -->
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="HomeBlock" Grid.Row="1"><StackPanel.RenderTransform><TranslateTransform x:Name="HomeBlockShift"/></StackPanel.RenderTransform>
          <TextBlock x:Name="Headline" HorizontalAlignment="Center" Margin="16,0,16,0" MaxWidth="660" Text="Make more room to breathe." FontSize="28" FontWeight="Normal" FontStyle="Italic" Foreground="{DynamicResource HeadingBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
          <Button x:Name="ScanCircleButton" local:Motion.Press="False" local:Motion.Glow="0.04" local:Motion.HoverLift="0.4" local:Motion.MouseOnly="True" Width="320" Height="320" Margin="0,4,0,0" Click="Circle_Click" Padding="0" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Start a scan. Click again while scanning to stop." AutomationProperties.Name="Ready to scan">
            <Button.LayoutTransform><ScaleTransform ScaleX="0.66" ScaleY="0.66"/></Button.LayoutTransform>
            <Button.Template><ControlTemplate TargetType="Button"><Grid>
              <!-- The glow lives on this disc BEHIND the gauge, never on the button itself: an effect on the button would re-render the whole gauge (the cleaning sweep, the ripples, the arc) through a blur on every frame. -->
              <Border x:Name="GlowUnderlay" Width="250" Height="250" CornerRadius="125" Background="Transparent"/>
              <ContentPresenter x:Name="CircleContent"/>
            </Grid></ControlTemplate></Button.Template>
            <Grid Width="320" Height="320">
              <Ellipse x:Name="GaugeTrack" Stroke="{DynamicResource GlassEdgeBrush}" StrokeThickness="4" Margin="30.5"/>
              <!-- The scan cue: a soft beam, two orbiting beads and gathering specks (see ScanRadar). Off unless a scan is running. -->
              <local:ScanRadar x:Name="ScanRadarCue"/>
              <Viewbox IsHitTestVisible="False"><Grid Width="158" Height="158">
                <Path x:Name="GaugeArc" Stroke="{DynamicResource TealBrush}" StrokeThickness="2" Opacity="0.95" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                  <Path.Effect><DropShadowEffect x:Name="GaugeFinishGlow" Color="{DynamicResource PrimaryAccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.22"/></Path.Effect>
                </Path>
              </Grid></Viewbox>
              <!-- The hover on the gauge (see GaugeHoverCue): one style before a scan, another after it. Pre-built shapes, transform and opacity only. -->
              <local:GaugeHoverCue x:Name="GaugeHover"/>
              <!-- While files are being cleaned: fine dust lifts inside the gauge, then one splash of light and rings at 100% (see ScanActivity); the percentage stays on top of it, on the cue's soft plate. -->
              <local:ScanActivity x:Name="FileScanActivity" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" Smashed="CleaningCue_Smashed"/>
              <!-- The percentage sits exactly in the middle of the gauge, always (owner, November 12, 2026). Owner, November 20, 2026: much smaller (90 → 56) and
                   in tabular figures, so "7%" and "42%" share one centre and the digits never shift sideways as they count; the 3 DIP bottom margin lifts the line
                   box 1.5 DIP so the ink, not the box, is centred. The label hangs below it at a fixed place, so it never moves the number. -->
              <TextBlock x:Name="GaugeValue" Foreground="{DynamicResource TextBrush}" FontSize="56" FontWeight="Light" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"><Run x:Name="GaugeNumber" Text="0"/><Run Text="%" FontSize="28"/></TextBlock>
              <TextBlock x:Name="GaugeLabel" Text="Click to scan" FontSize="20" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,198,0,0" MaxWidth="230" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Button>
          <Grid x:Name="StatusSlot" HorizontalAlignment="Center" Width="670" MaxWidth="670" Margin="20,2,20,0">
            <!-- The details row grows with its text (a long "skipped" note wraps instead of being cut off); the title row keeps its height so nothing above moves. -->
            <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto" MinHeight="26"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="StatusTitle" Text="Your files stay yours." Foreground="{DynamicResource HeadingBrush}" FontSize="16" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusDetail" Grid.Row="1" Text="Personal files and passwords are left alone." Foreground="{DynamicResource MutedBrush}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <local:RollingFileCount x:Name="LiveFileCounter" Grid.Row="1" Visibility="Hidden" Height="22" Margin="0,4,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" FontFamily="{Binding FontFamily, ElementName=StatusDetail}" FontSize="{Binding FontSize, ElementName=StatusDetail}" FontWeight="{Binding FontWeight, ElementName=StatusDetail}" Foreground="{Binding Foreground, ElementName=StatusDetail}"/>
            <!-- Below the details, two buttons of exactly the same size and font: Take a look (the theme's accent) and Clean (the Clean red), side by side. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button x:Name="CompletionLinkButton" Content="Take a look" Click="OpenResults_Click" Visibility="Collapsed" Style="{StaticResource AccentOutlineButton}" Width="140" Height="40" FontSize="16" Padding="20,7" Margin="0,3" ToolTip="Open the list of what was found" AutomationProperties.Name="Open scanned files"/>
              <Button x:Name="HomeCleanButton" Content="Clean" Click="HomeClean_Click" Style="{StaticResource DangerButton}" Width="140" Height="40" FontSize="16" Padding="20,7" Margin="14,3,0,3" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
          </StackPanel>
          <!-- Status tiles (Phase D, owner, November 19, 2026; Expert mode only). Junk found: the quiet safe count, then the scan result. Startup items: one quiet
               read ~5 s after start. Updates and Disk health: the last result the Tools cards found (kept between starts), "Check" until then. Each tile opens its page. -->
          <UniformGrid x:Name="StatusTiles" Grid.Row="3" Columns="4" Margin="-8,10,-8,0">
            <UniformGrid.Resources><Style TargetType="Button" BasedOn="{StaticResource StatusTile}"><Setter Property="Margin" Value="8,0"/></Style></UniformGrid.Resources>
            <Button x:Name="JunkTile" Click="JunkTile_Click" ToolTip="What a scan can clean. Click to scan, or to see what was found." AutomationProperties.Name="Junk found">
              <StackPanel>
                <Grid>
                  <Path Width="20" Height="20" Stretch="None" Data="M3.5,5.5 L16.5,5.5 M8,5.5 L8,4 L12,4 L12,5.5 M5,5.5 L5.8,15.7 Q5.9,16.5 6.8,16.5 L13.2,16.5 Q14.1,16.5 14.2,15.7 L15,5.5" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left"/>
                  <Ellipse x:Name="JunkTileDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource FaintBrush}" Visibility="Hidden"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" FontSize="28" FontWeight="Light" Foreground="{DynamicResource HeadingBrush}" Typography.NumeralAlignment="Tabular"><Run x:Name="JunkTileValue" Text="—"/><Run x:Name="JunkTileUnit" Text="" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                <TextBlock x:Name="JunkTileLabel" Text="Junk found" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="StartupTile" Click="StartupTile_Click" ToolTip="Programs that start with Windows. Click to manage them." AutomationProperties.Name="Startup items">
              <StackPanel>
                <Grid>
                  <Path Width="20" Height="20" Stretch="None" Data="M10,3 L10,9 M6.3,5.6 A6,6 0 1 0 13.7,5.6" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left"/>
                  <Ellipse x:Name="StartupTileDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource FaintBrush}" Visibility="Hidden"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" FontSize="28" FontWeight="Light" Foreground="{DynamicResource HeadingBrush}" Typography.NumeralAlignment="Tabular"><Run x:Name="StartupTileValue" Text="—"/><Run x:Name="StartupTileUnit" Text="" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                <TextBlock x:Name="StartupTileLabel" Text="Startup items" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="UpdatesTile" Click="UpdatesTile_Click" ToolTip="Apps with a newer version (from the last check). Click to check." AutomationProperties.Name="App updates">
              <StackPanel>
                <Grid>
                  <Path Width="20" Height="20" Stretch="None" Data="M10,3.25 A6.75,6.75 0 1 1 9.99,3.25 M10,6.5 L10,13 M7.2,10.3 L10,13 L12.8,10.3" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left"/>
                  <Ellipse x:Name="UpdatesTileDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource FaintBrush}" Visibility="Hidden"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" FontSize="28" FontWeight="Light" Foreground="{DynamicResource HeadingBrush}" Typography.NumeralAlignment="Tabular"><Run x:Name="UpdatesTileValue" Text="—"/><Run x:Name="UpdatesTileUnit" Text="" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                <TextBlock x:Name="UpdatesTileLabel" Text="App updates" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="DiskTile" Click="DiskTile_Click" ToolTip="What Windows reports about your drives (from the last check). Click to check." AutomationProperties.Name="Disk health">
              <StackPanel>
                <Grid>
                  <Path Width="20" Height="20" Stretch="None" Data="M5.5,5 L14.5,5 Q17,5 17,7.5 L17,12.5 Q17,15 14.5,15 L5.5,15 Q3,15 3,12.5 L3,7.5 Q3,5 5.5,5 Z M6,12 L10,12" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left"/>
                  <Ellipse x:Name="DiskTileDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource FaintBrush}" Visibility="Hidden"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" FontSize="28" FontWeight="Light" Foreground="{DynamicResource HeadingBrush}" Typography.NumeralAlignment="Tabular"><Run x:Name="DiskTileValue" Text="—"/><Run x:Name="DiskTileUnit" Text="" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                <TextBlock x:Name="DiskTileLabel" Text="Disk health" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              </StackPanel>
            </Button>
          </UniformGrid>
          <Border x:Name="ThisPcCard" Grid.Row="4" Background="{DynamicResource PanelBrush}" CornerRadius="18" Padding="22,14,22,15" Margin="0,12,0,0" AutomationProperties.Name="This PC">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="This PC" Style="{StaticResource FrostCardTitle}"/>
                    <TextBlock x:Name="InfoSummary" Text="Reading this PC…" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button x:Name="BoostButton" Style="{StaticResource AccentOutlineButton}" Grid.Column="2" Content="Boost" Click="Boost_Click" Height="40" MinWidth="124" Padding="20,0" VerticalAlignment="Center" AutomationProperties.Name="Boost" ToolTip="Cleans safe temporary files and asks Windows to release idle memory. Closes nothing.">
                    <!-- Heartbeat line, the stage or "Boost", and (at rest) the amount ready to clean, which ThisPc keeps in the button's Tag (" · 1.4 GB"). -->
                    <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                      <Path Width="18" Height="12" Stretch="None" Data="M0,6 L4,6 L6.2,1.2 L9,10.8 L11.6,3.4 L13.2,6 L18,6" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                    </StackPanel></DataTemplate></Button.ContentTemplate>
                  </Button>
                </Grid>
                <Grid Height="5" Margin="0,10,0,10">
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                  <local:UpdateActivity x:Name="BoostSweep" Height="5"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="10" Height="44" CornerRadius="5" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Center">
                      <Border x:Name="CpuFill" Height="44" CornerRadius="5" Background="{DynamicResource GoodBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform></Border>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="CpuText" Text="…" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock Text="Processor" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="10" Height="44" CornerRadius="5" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Center">
                      <Border x:Name="MemoryFill" Height="44" CornerRadius="5" Background="{DynamicResource GoodBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform></Border>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="MemoryText" Text="…" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock Text="Memory usage" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Border Width="10" Height="44" CornerRadius="5" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Center">
                      <Border x:Name="TempFill" Height="44" CornerRadius="5" Background="{DynamicResource GoodBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform></Border>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="TempText" Text="…" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock Text="Temporary files" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Width="10" Height="44" CornerRadius="5" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Center">
                      <Border x:Name="DiskFill" Height="44" CornerRadius="5" Background="{DynamicResource GoodBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform></Border>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="DiskText" Text="…" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock Text="System drive used" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
        </Grid>
        <!-- The Clean page (Phase D, owner-approved mockup "Clean · groups" / "inside Review", November 19, 2026): the title with the total found at the right;
             on the overview ONE card holds Select all and the three color groups (each with its share of the total as a bar), the scan line under it says when the
             scan ran and what it skipped; inside a group every category is its own card. A glass bar at the bottom carries what is selected and Clean selected.
             Before a scan and when nothing was found, one illustrated card says so with its own button. Element names are the old Review page's (tests, code). -->
        <Grid x:Name="ReviewPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,10,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top">
              <TextBlock x:Name="ReviewTitle" Text="Clean" Style="{StaticResource PageTitle}"/>
              <TextBlock x:Name="ResultCount" Text="Scan to find cleanup items" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel x:Name="ReviewTotal" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16,0,0,0">
              <TextBlock HorizontalAlignment="Right" FontSize="30" FontWeight="Light" Foreground="{DynamicResource HeadingBrush}" Typography.NumeralAlignment="Tabular"><Run x:Name="ReviewTotalValue" Text="—"/><Run x:Name="ReviewTotalUnit" Text="" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
              <TextBlock x:Name="ReviewTotalDetail" HorizontalAlignment="Right" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <!-- Back to Home: the tabs replace it in the new shell (kept, hidden, for the handler and its tests). -->
            <Button x:Name="BackButton" Grid.Column="2" Content="Back" Click="Back_Click" Style="{StaticResource BackButton}" VerticalAlignment="Top" Margin="0,6,-14,0" Visibility="Collapsed" AutomationProperties.Name="Back"/>
          </Grid>
          <Grid x:Name="ReviewBody" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition x:Name="ReviewCardRow" Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="ReviewFillerRow" Height="*"/></Grid.RowDefinitions>
            <!-- On the overview this is the one card (panel fill, glass edge); inside a group it turns transparent and every category is its own card. -->
            <Border x:Name="CategorySurface" CornerRadius="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1">
            <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <!-- One bar above both views. Overview: "Select all categories" ticks Safe, Review and Risky together. Inside a group: a round Back, "Select all in <group>"
                 for that group only, and Expand all. -->
            <Grid x:Name="CategoryControls" Margin="20,8,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="GroupBackButton" Content="Back to the groups" Click="GroupBack_Click" Style="{StaticResource RoundBackButton}" Margin="-8,0,12,0" Visibility="Collapsed" ToolTip="Back to the groups" AutomationProperties.Name="Back to the three groups"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="SelectAllBox" Content="Select all categories" FontSize="{DynamicResource SupportFontSize}" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Left" Click="SelectAll_Click" IsEnabled="False"/>
                <TextBlock x:Name="ReviewScopeDetail" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,1,0,0"/>
              </StackPanel>
              <TextBlock x:Name="ReadOnlyResultsLabel" Grid.Column="1" Text="Partial results · scan again to clean" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
              <Button x:Name="CollapseAllButton" Grid.Column="3" Click="CollapseAll_Click" Style="{StaticResource TextButton}" Foreground="{DynamicResource TextBrush}" local:Motion.HoverForeground="{DynamicResource HeadingBrush}" Padding="16,9" VerticalAlignment="Center" AutomationProperties.Name="Expand all">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource NavigationIcon}" Data="M 1,1 L 6,6 L 11,1 M 1,7 L 6,12 L 11,7" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform x:Name="SectionToggleRotation"/></Path.RenderTransform></Path><TextBlock x:Name="SectionToggleLabel" Text="Expand all" VerticalAlignment="Center"/></StackPanel>
              </Button>
            </Grid>
            <Border x:Name="OverviewDivider" Height="1" Margin="36,0" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}" Opacity="0.45" IsHitTestVisible="False"/>
            <Grid Grid.Row="1">
            <Grid x:Name="CategoryListView" Visibility="Collapsed">
            <ScrollViewer x:Name="ReviewScroll" Style="{StaticResource PageScroll}" Padding="0,4,0,16">
              <ItemsControl x:Name="CategoriesList">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Expander Style="{StaticResource CategoryAccordion}" IsExpanded="{Binding Expanded, Mode=TwoWay}" Header="{Binding}" HeaderTemplate="{StaticResource CategoryHeaderTemplate}">
                    <Grid>
                      <ListBox ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource ReviewRows}" MaxHeight="280" Background="Transparent" BorderThickness="0" Padding="0" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewMouseWheel="CategoryFiles_PreviewMouseWheel" AutomationProperties.Name="{Binding Title}">
                        <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource FileListBox}"><Style.Triggers><DataTrigger Binding="{Binding Files.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
                      </ListBox>
                    </Grid>
                  </Expander>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            </Grid>
            <!-- The three color groups (Safe, Review, Risky), each a row with its colored line, its own checkbox, what it holds, its share of the total as a bar,
                 its size and a chevron; a fully selected group gets an outline in its own color. A group with nothing found is not shown. -->
            <ScrollViewer x:Name="ReviewGroupsView" Style="{StaticResource PageScroll}" Padding="8,4,8,4">
              <ItemsControl x:Name="ReviewGroupsList">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel>
                    <Border x:Name="GroupDivider" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="36,0"/>
                    <Grid>
                    <Button Click="ReviewGroup_Click" Tag="{Binding}" Style="{StaticResource TextButton}" Padding="0" Height="NaN" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding AutomationName}">
                      <Grid Margin="12,18,14,18" MinHeight="64" Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="14"/><ColumnDefinition Width="22"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                        <Border Background="{Binding Accent}" Width="3" CornerRadius="1.5" Margin="0,4"/>
                        <CheckBox Grid.Column="2" Style="{StaticResource CandidateCheckBox}" IsChecked="{Binding SelectionState, Mode=OneWay}" Tag="{Binding Accent}" Click="GroupSelect_Click" IsEnabled="{Binding CanSelectCandidates, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title, StringFormat=Select {0}}"/>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontSize="17" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SupportFontSize}" TextWrapping="Wrap" LineHeight="21" Margin="0,2,0,0"/>
                          <!-- The group's share of everything found: two star columns, so nothing measures or animates it. -->
                          <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="420"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource GlassEdgeBrush}">
                              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ShareStar}"/><ColumnDefinition Width="{Binding RestStar}"/></Grid.ColumnDefinitions>
                                <Border Background="{Binding Accent}" CornerRadius="2" Opacity="0.85"/>
                              </Grid>
                            </Border>
                          </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding TotalLabel}" Foreground="{DynamicResource HeadingBrush}" FontSize="22" FontWeight="Light" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                          <TextBlock Text="{Binding DetailLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="13" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Path Grid.Column="7" Data="M 0,0 L 5,5 L 0,10" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                      </Grid>
                    </Button>
                    <Border x:Name="GroupOutline" CornerRadius="14" BorderThickness="1" Opacity="0.7" IsHitTestVisible="False" SnapsToDevicePixels="False" local:Motion.Ink="Transparent"/>
                    </Grid>
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding DividerAbove}" Value="False"><Setter TargetName="GroupDivider" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding SelectionState}" Value="True"><Setter TargetName="GroupOutline" Property="local:Motion.Ink" Value="{Binding Accent}"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            </Grid>
            <TextBlock x:Name="OverviewNote" Grid.Row="2" Text="Only Safe items are selected for you. Review and Risky items are your choice, and Risky items ask for a confirmation tick." FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="24,0,24,16"/>
            </Grid></Border>
            <!-- The scan line (owner: clock time): when the scan ran and what it skipped; the details are in its tooltip. Scan again sits at its right. -->
            <Grid x:Name="ScanInfoLine" Grid.Row="1" Margin="4,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Path Width="16" Height="16" Stretch="None" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Data="M8,1.6 A6.4,6.4 0 1 1 7.99,1.6 M8,4.6 L8,8 L10.4,9.4"/>
              <TextBlock x:Name="ScanInfoText" Grid.Column="1" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
              <Button x:Name="RescanButton" Grid.Column="2" Content="Scan again" Click="Scan_Click" Style="{StaticResource AccentTextButton}" VerticalAlignment="Center" Padding="12,6" Margin="0,0,-12,0" Visibility="Collapsed" ToolTip="Scan again" AutomationProperties.Name="Scan again"/>
            </Grid>
          </Grid>
          <!-- Before a scan, and when a scan found nothing: one card with a small drawing, what it means and its own button. -->
          <Border x:Name="ReviewEmptyState" Grid.Row="1" CornerRadius="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="32">
              <Canvas Width="200" Height="140" HorizontalAlignment="Center">
                <Ellipse Canvas.Left="34" Canvas.Top="113" Width="132" Height="18" Fill="{DynamicResource TealTextBrush}" Opacity="0.08"/>
                <Path Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="1.3 4" Opacity="0.55" Data="M34,52 C56,26 104,18 142,38"/>
                <Rectangle Canvas.Left="52" Canvas.Top="54" Width="96" Height="60" RadiusX="16" RadiusY="16" Fill="{DynamicResource AccentSelectedBrush}" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.5"/>
                <Path Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.7" Data="M66,98 L100,98"/>
                <Path Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.4" Data="M66,86 L86,86"/>
                <Ellipse Canvas.Left="129" Canvas.Top="95" Width="6" Height="6" Fill="{DynamicResource GoodBrush}"/>
                <Canvas x:Name="EmptyStateBadge">
                  <Ellipse Canvas.Left="132" Canvas.Top="40" Width="28" Height="28" Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource GoodBrush}" StrokeThickness="1.5"/>
                  <Path Stroke="{DynamicResource GoodBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M139.5,54 L144,58.5 L152.5,49.5"/>
                </Canvas>
                <Path Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8" Data="M44,22 L44,32 M39,27 L49,27"/>
                <Path Stroke="{DynamicResource GoodBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8" Data="M166,82 L166,90 M162,86 L170,86"/>
                <Path Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6" Data="M160,24 L160,30 M157,27 L163,27"/>
              </Canvas>
              <TextBlock x:Name="EmptyStateTitle" Text="Scan to see what can be cleaned" FontSize="22" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/>
              <TextBlock x:Name="EmptyStateDetail" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/>
              <Button x:Name="EmptyStateButton" Content="Scan now" Click="Scan_Click" Style="{StaticResource AccentOutlineButton}" Height="40" Padding="24,0" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="{DynamicResource SupportFontSize}"/>
            </StackPanel>
          </Border>
          <!-- The glass bar: what is selected at the left, Clean selected (the one red) at the right. Shown while there are results. -->
          <Border x:Name="ReviewFooterBar" Grid.Row="2" Margin="0,14,0,0" CornerRadius="28" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Padding="24,8,8,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel x:Name="SelectionDetails" VerticalAlignment="Center">
                <TextBlock x:Name="SelectionSummary" Text="Nothing selected" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource SupportFontSize}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="PrimaryButton" Grid.Column="1" Content="Start scan" Click="Primary_Click" Style="{StaticResource DangerButton}" MinWidth="156" Height="44" FontSize="{DynamicResource ActionFontSize}" Padding="22,9"/>
            </Grid>
          </Border>
        </Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <Grid.Resources>
            <!-- One settings row: title, plain description and (only when it matters) a status line on the left, the on/off switch on the right.
                 A hairline divider separates rows; the first row of each card has none. -->
            <!-- One running app: its icon, name and memory, and a plain End button. -->
            <DataTemplate x:Key="ProcessTemplate">
              <StackPanel>
                <Border x:Name="RowDivider" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border x:Name="IconPlaceholder" CornerRadius="8" Background="{DynamicResource RaisedBrush}" Visibility="Collapsed"><TextBlock Text="{Binding Initial}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TealTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button x:Name="EndButton" Grid.Column="2" Content="End" Click="EndProcess_Click" Tag="{Binding}" Width="84" Height="36" Padding="0" VerticalAlignment="Center" IsEnabled="{Binding CanEnd}" AutomationProperties.Name="{Binding EndLabel}"/>
                  <TextBlock x:Name="AdminNeeded" Grid.Column="2" Text="Needs administrator to end" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MeterWarnBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="False"><Setter TargetName="IconPlaceholder" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding NeedsAdministrator}" Value="True"><Setter TargetName="EndButton" Property="Visibility" Value="Collapsed"/><Setter TargetName="AdminNeeded" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0"><Setter TargetName="RowDivider" Property="Visibility" Value="Collapsed"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>

            
          <!-- Settings (Phase D, the approved mockup; owner, November 19, 2026: "no accordions"): one open page. Left: the title and a section index (an icon chip per
               section, a red dot on Windows Update while it is off); a click glides to the section and scrolling moves the highlight. Right: the red Windows Update line
               when needed, then every section as an uppercase label over one card of rows (name, one plain line, its control). Nothing has to be opened to be seen;
               the one exception is Open apps (owner's pick, November 20, 2026): its list unfolds with Show apps and is read only then. The cards keep their old
               Expanders and names (code and tests open them), styled SettingsGroup so they are always open. -->
            <Style x:Key="SettingsGroup" TargetType="Expander">
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Margin" Value="0,0,0,24"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                  <ContentPresenter ContentSource="Header" Margin="4,0,4,8"/>
                  <Border CornerRadius="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Padding="18,2">
                    <ContentPresenter/>
                  </Border>
                </StackPanel>
              </ControlTemplate></Setter.Value></Setter>
            </Style>
            <!-- One section label: uppercase, small, muted, with the section's state at the right. -->
            <Style x:Key="SectionLabel" TargetType="TextBlock">
              <Setter Property="FontSize" Value="13"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SectionState" TargetType="TextBlock">
              <Setter Property="FontSize" Value="13"/>
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="HorizontalAlignment" Value="Right"/>
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="RowName" TargetType="TextBlock">
              <Setter Property="FontSize" Value="{DynamicResource SupportFontSize}"/>
              <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RowLine" TargetType="TextBlock">
              <Setter Property="FontSize" Value="13"/>
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
              <Setter Property="Margin" Value="0,2,0,0"/>
              <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="RowDivider" TargetType="Border">
              <Setter Property="Height" Value="1"/>
              <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
              <Setter Property="Opacity" Value="0.55"/>
            </Style>
          </Grid.Resources>
          <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DockPanel Margin="0,10,0,24">
            <TextBlock x:Name="SettingsTitle" Text="Settings" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"/>
            <Button x:Name="SettingsBackButton" Content="Back" Style="{StaticResource BackButton}" Click="SettingsBack_Click" Visibility="Collapsed" DockPanel.Dock="Top" AutomationProperties.Name="Back from settings"/>
            <TextBlock Text="Changes save as you make them." FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" DockPanel.Dock="Bottom"/>
            <ItemsControl x:Name="SettingsIndex" Margin="0,16,0,0" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:SegmentPanel ThumbBrush="{DynamicResource AccentSelectedBrush}" ThumbEdge="{DynamicResource AccentSelectedEdgeBrush}" ThumbRadius="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="local:SegmentPanel.IsSelected" Value="{Binding Selected}"/></Style></ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Click="SettingsIndex_Click" Tag="{Binding}" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Padding="0" Height="40" Margin="0,0,0,2" HorizontalContentAlignment="Stretch" Visibility="{Binding Shown}" AutomationProperties.Name="{Binding Name}">
                  <Border x:Name="Pill" CornerRadius="12" Padding="6,0,10,0" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border x:Name="Chip" Width="28" Height="28" CornerRadius="8" Background="{DynamicResource RaisedBrush}">
                        <Path x:Name="Icon" Data="{Binding Icon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" Stretch="None" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Path.RenderTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.RenderTransform>
                        </Path>
                      </Border>
                      <TextBlock x:Name="Label" Grid.Column="2" Text="{Binding Name}" FontSize="{DynamicResource SupportFontSize}" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource HeadingBrush}"/>
                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource TealTextBrush}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
          <ScrollViewer x:Name="WindowsSettingsScroll" Grid.Column="2" Style="{StaticResource PageScroll}" ScrollChanged="SettingsScroll_ScrollChanged" Margin="0,12,-22,0" Padding="0,0,22,24">
            <StackPanel x:Name="SettingsSectionsPanel">
            <!-- Windows Update is off (turned off from Hush): a lasting red line with one click back. -->
            <Border x:Name="UpdateOffBanner" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CleanTextBrush}" BorderThickness="1" CornerRadius="26" Padding="18,6,6,6" Margin="0,0,0,24">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
