<Window x:Class="Hush.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hush"
        Title="Hush · Make more room to breathe" Icon="/Hush;component/Assets/Hush.ico" Width="920" Height="820" MinWidth="800" MinHeight="740" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" Closing="Window_Closing" Loaded="Window_Loaded">
  <Window.Resources>
    <local:ReviewRowWidthConverter x:Key="ReviewRowWidth"/>
    <!-- The soft glow of the "100%" in the finished gauge (attached to GaugeValue only while a finished clean is on screen; see CompleteGauge). -->
    <DropShadowEffect x:Key="GaugeValueGlowEffect" Color="{DynamicResource PrimaryAccentColor}" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
    <DataTemplate x:Key="NeutralFileTemplate">
      <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}, Converter={StaticResource ReviewRowWidth}, ConverterParameter=6}" Background="{DynamicResource RaisedBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,7" ToolTip="{Binding Path}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource CandidateCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay}" Tag="{Binding SelectionAccent}" AutomationProperties.Name="{Binding Path}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="FileName" Text="{Binding Name}" local:Motion.Ink="{DynamicResource TextBrush}" FontSize="{DynamicResource BodyFontSize}" FontWeight="Medium" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DirectoryLabel}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"/>
            <TextBlock Text="{Binding Outcome}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource TextBrush}" TextAlignment="Right" FontSize="{DynamicResource CompactFontSize}" FontFamily="Cascadia Mono, Consolas"/>
            <TextBlock Text="{Binding GroupLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SupportFontSize}" TextAlignment="Right" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="FileName" Property="local:Motion.Ink" Value="{Binding SelectionAccent}"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <!-- A sub-heading inside a category's list: the app's name and what it holds, a short colored line in the category's color (same line as the card's). -->
    <DataTemplate x:Key="SubHeadingTemplate">
      <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}, Converter={StaticResource ReviewRowWidth}, ConverterParameter=6}" Margin="0,4,0,9" IsHitTestVisible="False">
        <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{Binding Category.TextAccent}" Width="4" CornerRadius="2" Margin="0,1"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource HeadingBrush}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SupportFontSize}" Margin="12,2,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <local:ReviewRowTemplateSelector x:Key="ReviewRows" File="{StaticResource NeutralFileTemplate}" Heading="{StaticResource SubHeadingTemplate}"/>
    <DataTemplate x:Key="CategoryHeaderTemplate">
        <Grid x:Name="HeaderRoot" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="118"/><ColumnDefinition Width="27"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="CategoryTitle" Text="{Binding Title}" local:Motion.Ink="{DynamicResource HeadingBrush}" FontSize="{DynamicResource CategoryFontSize}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource SupportFontSize}" TextWrapping="Wrap" LineHeight="20" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SupportFontSize}" Margin="0,6,0,0"/>
          </StackPanel>
          <Border Grid.Column="2" Background="{DynamicResource RaisedBrush}" CornerRadius="10" Padding="10,8" VerticalAlignment="Center">
            <TextBlock Text="{Binding TotalLabel}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource CompactFontSize}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" TextAlignment="Center"/>
          </Border>
          <Grid Grid.Column="3" Width="10" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><RotateTransform x:Name="ChevronRotation"/></Grid.RenderTransform>
            <Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            <Path x:Name="ChevronHover" Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
          </Grid>
        </Grid>
      <DataTemplate.Triggers>
      <Trigger SourceName="HeaderRoot" Property="IsMouseOver" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
      </Trigger>
      <DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="CategoryTitle" Property="local:Motion.Ink" Value="{Binding TextAccent}"/></DataTrigger>
      <DataTrigger Binding="{Binding Expanded}" Value="True">
        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
        <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
      </DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="CategoryAccordion" TargetType="Expander">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
        <Border Height="1" Margin="36,0" Background="{DynamicResource BorderBrush}" Opacity="0.45"/>
        <Grid Margin="22,3">
          <StackPanel>
            <Border Padding="17,11" ToolTip="{Binding Description}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="15"/><ColumnDefinition Width="22"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{Binding TextAccent}" Width="6" Margin="0,2" CornerRadius="3"/>
            <CheckBox Grid.Column="2" Style="{StaticResource CandidateCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay}" Tag="{Binding TextAccent}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title, StringFormat=Select {0}}"/>
            <ToggleButton Grid.Column="4" x:Name="HeaderSite" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" BorderThickness="0" FocusVisualStyle="{x:Null}" Cursor="Hand" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            </Grid></Border>
            <local:AccordionBody Expanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
              <ContentPresenter Margin="14,10,14,12"/>
            </local:AccordionBody>
          </StackPanel>
          <!-- Checked outline: an overlay (never covers or shifts content) with a full 1 DIP stroke on whole pixels, softened by opacity.
               A 0.5 DIP border rendered as a ragged hairline at the rounded corners. -->
          <Border x:Name="SelectionOutline" CornerRadius="10" BorderThickness="1" Opacity="0.7" IsHitTestVisible="False" SnapsToDevicePixels="False" local:Motion.Ink="Transparent"/>
        </Grid>
        </StackPanel>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="SelectionOutline" Property="local:Motion.Ink" Value="{Binding TextAccent}"/></DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="WindowSurface" CornerRadius="24" Background="{DynamicResource WindowBrush}" SizeChanged="Surface_SizeChanged">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="AppSurface" Grid.RowSpan="2">
      <Grid.Effect><BlurEffect x:Name="BackgroundBlur" Radius="0" RenderingBias="Quality"/></Grid.Effect>
      <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="30,0,18,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <!-- Pro mode (owner, November 12, 2026): a tight glow around each letter of the wordmark while Pro is on, drawn once as a picture (see LetterGlow and ApplyProMode). -->
        <local:LetterGlow x:Name="WordmarkGlow" Visibility="Collapsed" Text="Hush" FontFamily="{Binding FontFamily, ElementName=AboutButton}" FontSize="{Binding FontSize, ElementName=AboutButton}" FontWeight="{Binding FontWeight, ElementName=AboutButton}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Button x:Name="AboutButton" Content="Hush" Click="About_Click" Style="{StaticResource AccentTextButton}" local:Motion.MouseOnly="True" local:Motion.HoverForeground="{DynamicResource TealTextBrush}" FontSize="33" FontWeight="Medium" Height="52" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" AutomationProperties.Name="About Hush"/>
        <!-- 0.9: a quiet green line beside the wordmark when a newer version exists (found by one silent check at start). Clicking opens the update popup. -->
        <Button x:Name="UpdateNoticeButton" Content="There is a new update!" Click="UpdateNotice_Click" Style="{StaticResource TextButton}" Foreground="{DynamicResource GoodBrush}" local:Motion.HoverForeground="{DynamicResource HeadingBrush}" local:Motion.MouseOnly="True" FontSize="{DynamicResource CompactFontSize}" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="92,3,0,0" Padding="10,8" Visibility="Collapsed" Opacity="0" AutomationProperties.Name="A new update is available: open the update window"/>
        <StackPanel x:Name="CaptionControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Grid x:Name="ProModeSlot" Margin="0,0,8,0">
            <local:LetterGlow x:Name="ProGlow" Visibility="Collapsed" Text="Pro" FontFamily="{Binding FontFamily, ElementName=ProModeButton}" FontSize="{Binding FontSize, ElementName=ProModeButton}" FontWeight="{Binding FontWeight, ElementName=ProModeButton}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="ProModeButton" Content="Pro" Style="{StaticResource ProModeButton}" Tag="Off" Click="ProMode_Click" ToolTip="Pro mode is off. Turn it on to see everything Hush can do." AutomationProperties.Name="Pro mode, off"/>
          </Grid>
          <Button x:Name="SettingsButton" Style="{StaticResource CaptionButton}" Click="Settings_Click" Margin="0,0,4,0" ToolTip="Settings" AutomationProperties.Name="Settings">
            <Path Style="{StaticResource CaptionIcon}" Data="M8,1 L10,1 L10.6,3.2 L12.1,4.1 L14.3,3.5 L15.3,5.3 L13.8,6.9 L13.8,8.9 L15.3,10.5 L14.3,12.3 L12.1,11.7 L10.6,12.6 L10,14.8 L8,14.8 L7.4,12.6 L5.9,11.7 L3.7,12.3 L2.7,10.5 L4.2,8.9 L4.2,6.9 L2.7,5.3 L3.7,3.5 L5.9,4.1 L7.4,3.2 Z M11.4,7.9 A2.4,2.4 0 1 1 6.6,7.9 A2.4,2.4 0 1 1 11.4,7.9"/>
          </Button>
          <Button x:Name="ThemeButton" Style="{StaticResource CaptionButton}" Click="Theme_Click" Margin="0,0,8,0" ToolTip="Switch theme" AutomationProperties.Name="Switch theme">
            <Grid Width="18" Height="18">
              <Path x:Name="ThemeSunRays" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9,1 L9,2.2 M9,15.8 L9,17 M1,9 L2.2,9 M15.8,9 L17,9 M3.35,3.35 L4.2,4.2 M13.8,13.8 L14.65,14.65 M3.35,14.65 L4.2,13.8 M13.8,4.2 L14.65,3.35"/>
              <Ellipse x:Name="ThemeSunCore" Width="7" Height="7" StrokeThickness="1.5" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
            </Grid>
          </Button>
          <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" Margin="0,0,4,0" ToolTip="Minimize" AutomationProperties.Name="Minimize">
            <Path Style="{StaticResource CaptionIcon}" Stretch="None" Data="M4,9 L14,9"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
            <Path Style="{StaticResource CaptionIcon}" Stretch="None" Data="M4,4 L14,14 M14,4 L4,14"/>
          </Button>
        </StackPanel>
      </Grid>
      <Grid x:Name="MainContent" Grid.Row="1" Margin="30,8,30,24">
        <Grid x:Name="ScanPage">
          <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="166"/><RowDefinition Height="24"/></Grid.RowDefinitions>
          <StackPanel HorizontalAlignment="Center" Margin="16,20,16,0" MaxWidth="660">
            <TextBlock x:Name="Headline" Text="Make more room to breathe." FontSize="33" FontWeight="Normal" FontStyle="Italic" Foreground="{DynamicResource HeadingBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <Button x:Name="ScanCircleButton" local:Motion.Glow="0.04" local:Motion.HoverLift="0.4" local:Motion.MouseOnly="True" Grid.Row="1" Width="320" Height="320" Click="Circle_Click" Padding="0" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Start a scan. Click again while scanning to stop." AutomationProperties.Name="Ready to scan">
            <Button.Template><ControlTemplate TargetType="Button"><Grid>
              <!-- The glow lives on this disc BEHIND the gauge, never on the button itself: an effect on the button would re-render the whole gauge (the cleaning sweep, the ripples, the arc) through a blur on every frame. -->
              <Border x:Name="GlowUnderlay" Width="250" Height="250" CornerRadius="125" Background="{DynamicResource PanelBrush}"/>
              <ContentPresenter x:Name="CircleContent"/>
            </Grid></ControlTemplate></Button.Template>
            <Grid Width="320" Height="320">
              <Ellipse Fill="{DynamicResource PanelBrush}" Margin="35"/>
              <Ellipse Stroke="{DynamicResource RaisedBrush}" StrokeThickness="7" Margin="29"/>
              <!-- The scan cue: soft rings drifting out from the gauge (see ScanRipples). Off unless a scan is running. -->
              <local:ScanRipples x:Name="ScanRipplesCue" Stroke="{DynamicResource TealBrush}" Width="320" Height="320"/>
              <Viewbox IsHitTestVisible="False"><Grid Width="158" Height="158">
                <Path x:Name="GaugeArc" Stroke="{DynamicResource TealBrush}" StrokeThickness="3.5" Opacity="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                  <Path.Effect><DropShadowEffect x:Name="GaugeFinishGlow" Color="{DynamicResource PrimaryAccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.22"/></Path.Effect>
                </Path>
              </Grid></Viewbox>
              <!-- The hover on the gauge (see GaugeHoverCue): one style before a scan, another after it. Pre-built shapes, transform and opacity only. -->
              <local:GaugeHoverCue x:Name="GaugeHover"/>
              <!-- While files are being cleaned: the Smash cue fills the whole inside of the gauge (see ScanActivity); the percentage stays on top of it, on the cue's soft plate. -->
              <local:ScanActivity x:Name="FileScanActivity" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" Smashed="CleaningCue_Smashed"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="230">
                <TextBlock x:Name="GaugeValue" Text="0%" Foreground="{DynamicResource TextBrush}" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="GaugeLabel" Text="Click to scan" FontSize="18" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
              </StackPanel>
            </Grid>
          </Button>
          <Grid x:Name="StatusSlot" Grid.Row="2" HorizontalAlignment="Center" Width="670" MaxWidth="670" Margin="20,0,20,8">
            <!-- The details row grows with its text (a long "skipped" note wraps instead of being cut off); the title row keeps its height so nothing above moves. -->
            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="Auto" MinHeight="38"/><RowDefinition Height="52"/></Grid.RowDefinitions>
            <TextBlock x:Name="StatusTitle" Text="Your files stay yours." Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusDetail" Grid.Row="1" Text="Personal files and passwords are left alone." Foreground="{DynamicResource MutedBrush}" FontSize="17" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" LineHeight="24" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <local:RollingFileCount x:Name="LiveFileCounter" Grid.Row="1" Visibility="Hidden" Height="22" Margin="0,4,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" FontFamily="{Binding FontFamily, ElementName=StatusDetail}" FontSize="{Binding FontSize, ElementName=StatusDetail}" FontWeight="{Binding FontWeight, ElementName=StatusDetail}" Foreground="{Binding Foreground, ElementName=StatusDetail}"/>
            <!-- Below the details, two buttons of exactly the same size and font: Take a look (the theme's accent) and Clean (the Clean red), side by side. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button x:Name="CompletionLinkButton" Content="Take a look" Click="OpenResults_Click" Visibility="Collapsed" Style="{StaticResource AccentOutlineButton}" Width="140" Height="40" FontSize="18" Padding="20,7" ToolTip="Open the list of what was found" AutomationProperties.Name="Open scanned files"/>
              <Button x:Name="HomeCleanButton" Content="Clean" Click="HomeClean_Click" Style="{StaticResource DangerButton}" Width="140" Height="40" FontSize="18" Padding="20,7" Margin="14,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
        </Grid>
        <Grid x:Name="ReviewPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="96"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
              <TextBlock x:Name="ReviewTitle" Text="Review files" Style="{StaticResource PageTitle}"/>
              <TextBlock x:Name="ResultCount" Text="Scan to find cleanup items" FontSize="{DynamicResource BodyFontSize}" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
            </StackPanel>
            <Button x:Name="BackButton" Grid.Column="1" Content="Back" Click="Back_Click" Style="{StaticResource BackButton}" VerticalAlignment="Top" Margin="0,6,-14,0" AutomationProperties.Name="Back"/>
          </Grid>
          <Border x:Name="CategorySurface" Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="14" Margin="0,8,0,0">
          <Grid>
          <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <!-- 0.9: one bar above both views. On the three-group overview "Select all categories" ticks Safe, Review and Advanced together (as it always did);
               inside a group the chevron goes back to the overview, the checkbox reads "Select all in <group>" and covers only that group. -->
          <Grid x:Name="CategoryControls" Margin="61,8,33,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="GroupBackButton" Content="Back to the groups" Click="GroupBack_Click" Style="{StaticResource ChevronBackButton}" Margin="-41,0,5,0" Visibility="Collapsed" ToolTip="Back to the groups" AutomationProperties.Name="Back to the three groups"/>
            <CheckBox x:Name="SelectAllBox" Grid.Column="1" Content="Select all categories" FontSize="{DynamicResource CompactFontSize}" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Left" Click="SelectAll_Click" IsEnabled="False"/>
            <TextBlock x:Name="ReadOnlyResultsLabel" Grid.Column="1" Text="Partial results · scan again to clean" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Button x:Name="CollapseAllButton" Grid.Column="3" Click="CollapseAll_Click" Style="{StaticResource TextButton}" Foreground="{DynamicResource TextBrush}" local:Motion.HoverForeground="{DynamicResource HeadingBrush}" Padding="16,9" VerticalAlignment="Center" AutomationProperties.Name="Expand all">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource NavigationIcon}" Data="M 1,1 L 6,6 L 11,1 M 1,7 L 6,12 L 11,7" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform x:Name="SectionToggleRotation"/></Path.RenderTransform></Path><TextBlock x:Name="SectionToggleLabel" Text="Expand all" VerticalAlignment="Center"/></StackPanel>
            </Button>
          </Grid>
          <!-- On the overview a soft divider separates this bar from the groups below (inside a group the first category card has its own). -->
          <Border x:Name="OverviewDivider" Height="1" Margin="36,0" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}" Opacity="0.45" IsHitTestVisible="False"/>
          <Grid Grid.Row="1">
          <Grid x:Name="CategoryListView" Visibility="Collapsed">
          <ScrollViewer x:Name="ReviewScroll" Style="{StaticResource PageScroll}" Padding="0,0,0,16">
            <ItemsControl x:Name="CategoriesList">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Expander Style="{StaticResource CategoryAccordion}" IsExpanded="{Binding Expanded, Mode=TwoWay}" Header="{Binding}" HeaderTemplate="{StaticResource CategoryHeaderTemplate}">
                  <Grid>
                    <ListBox ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource ReviewRows}" MaxHeight="280" Background="Transparent" BorderThickness="0" Padding="0" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewMouseWheel="CategoryFiles_PreviewMouseWheel" AutomationProperties.Name="{Binding Title}">
                      <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource FileListBox}"><Style.Triggers><DataTrigger Binding="{Binding Files.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
                    </ListBox>
                  </Grid>
                </Expander>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Grid>
          <!-- 0.9: the Review page opens on three color groups (Green Safe, Amber Review, Red Advanced) with size and counts; clicking one opens its
               categories (the list above, same cards and animations) and Back returns here. A group with nothing found is not shown. -->
          <ScrollViewer x:Name="ReviewGroupsView" Style="{StaticResource PageScroll}" Padding="0,0,0,8">
            <ItemsControl x:Name="ReviewGroupsList">
              <ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel>
                  <!-- The same soft hairline as between the category cards inside a group (36 DIP in from each side, opacity 0.45); the first group has none above it because the bar's own divider sits there. -->
                  <Border x:Name="GroupDivider" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="36,0"/>
                  <Grid>
                  <Button Click="ReviewGroup_Click" Tag="{Binding}" Style="{StaticResource TextButton}" Padding="0" Height="NaN" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding AutomationName}">
                    <Grid Margin="39,22,33,22" Background="Transparent">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="15"/><ColumnDefinition Width="22"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="118"/><ColumnDefinition Width="27"/></Grid.ColumnDefinitions>
                      <!-- 0.9: the group's colored line (the same line style as the category rows) and a checkbox that selects the whole group; mixed when only part of it is selected. -->
                      <Border Background="{Binding Accent}" Width="6" CornerRadius="3" Margin="0,2"/>
                      <CheckBox Grid.Column="2" Style="{StaticResource CandidateCheckBox}" IsChecked="{Binding SelectionState, Mode=OneWay}" Tag="{Binding Accent}" Click="GroupSelect_Click" IsEnabled="{Binding CanSelectCandidates, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title, StringFormat=Select {0}}"/>
                      <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontSize="{DynamicResource CategoryFontSize}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource SupportFontSize}" TextWrapping="Wrap" LineHeight="20" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SupportFontSize}" Margin="0,6,0,0"/>
                      </StackPanel>
                      <Border Grid.Column="6" Background="{DynamicResource RaisedBrush}" CornerRadius="10" Padding="10,8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalLabel}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource CompactFontSize}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" TextAlignment="Center"/>
                      </Border>
                      <Path Grid.Column="7" Data="M 0,0 L 5,5 L 0,10" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                  <!-- A fully selected group gets an outline in its own color (green Safe, amber Review, red Advanced), the same overlay as a selected category card: never covers or shifts content. -->
                  <Border x:Name="GroupOutline" Margin="22,3" CornerRadius="10" BorderThickness="1" Opacity="0.7" IsHitTestVisible="False" SnapsToDevicePixels="False" local:Motion.Ink="Transparent"/>
                  </Grid>
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding DividerAbove}" Value="False"><Setter TargetName="GroupDivider" Property="Visibility" Value="Collapsed"/></DataTrigger>
                  <DataTrigger Binding="{Binding SelectionState}" Value="True"><Setter TargetName="GroupOutline" Property="local:Motion.Ink" Value="{Binding Accent}"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Grid>
          </Grid></Border>
          <StackPanel x:Name="ReviewEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="28" Visibility="Collapsed">
            <TextBlock x:Name="EmptyStateTitle" Text="Everything looks clean." FontSize="22" FontWeight="Normal" Foreground="{DynamicResource HeadingBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="EmptyStateDetail" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0"/>
          </StackPanel>
          <Grid Grid.Row="2" Margin="0,18,0,0">
            <!-- Quiet bottom bar: Scan again at the left edge; in the middle the red Clean button with what it will act on (count and size) in plain text just below it. -->
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="RescanButton" Content="Scan again" Click="Scan_Click" Style="{StaticResource TextButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-14,0,0,0" Visibility="Collapsed" ToolTip="Scan again" AutomationProperties.Name="Scan again"/>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <Button x:Name="PrimaryButton" Content="Start scan" Click="Primary_Click" Style="{StaticResource DangerButton}" MinWidth="156" Height="44" HorizontalAlignment="Center" FontSize="{DynamicResource ActionFontSize}" Padding="18,9"/>
              <StackPanel x:Name="SelectionDetails" Margin="0,12,0,0">
                <TextBlock x:Name="SelectionSummary" Text="Nothing selected" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource SupportFontSize}" FontWeight="Medium" TextAlignment="Center" HorizontalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <Grid.Resources>
            <!-- One settings row: title, plain description and (only when it matters) a status line on the left, the on/off switch on the right.
                 A hairline divider separates rows; the first row of each card has none. -->
            <!-- One running app: its icon, name and memory, and a plain End button (the reference look of PC Manager's Process management). -->
            <DataTemplate x:Key="ProcessTemplate">
              <StackPanel>
                <Border x:Name="RowDivider" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border x:Name="IconPlaceholder" CornerRadius="8" Background="{DynamicResource RaisedBrush}" Visibility="Collapsed"><TextBlock Text="{Binding Initial}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TealTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button x:Name="EndButton" Grid.Column="2" Content="End" Click="EndProcess_Click" Tag="{Binding}" Width="84" Height="36" Padding="0" VerticalAlignment="Center" IsEnabled="{Binding CanEnd}" AutomationProperties.Name="{Binding EndLabel}"/>
                  <TextBlock x:Name="AdminNeeded" Grid.Column="2" Text="Needs administrator to end" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MeterWarnBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="False"><Setter TargetName="IconPlaceholder" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding NeedsAdministrator}" Value="True"><Setter TargetName="EndButton" Property="Visibility" Value="Collapsed"/><Setter TargetName="AdminNeeded" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0"><Setter TargetName="RowDivider" Property="Visibility" Value="Collapsed"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
            <!-- Each topic is a collapsible group (chevron, name, count); open topics are remembered while Settings is open, and a search opens them all. -->
            <GroupStyle x:Key="AdjustmentGroups">
              <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                  <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                      <StackPanel>
                        <ToggleButton x:Name="TopicToggle" Uid="topic" Style="{StaticResource TopicHeader}" Loaded="Topic_Loaded" Checked="Topic_Changed" Unchecked="Topic_Changed">
                          <TextBlock FontSize="{DynamicResource CompactFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource FaintBrush}" FontWeight="Normal"/></TextBlock>
                        </ToggleButton>
                        <local:AccordionBody Expanded="{Binding IsChecked, ElementName=TopicToggle}" IsEnabled="{Binding Expanded, RelativeSource={RelativeSource Self}}"><ItemsPresenter/></local:AccordionBody>
                      </StackPanel>
                    </ControlTemplate>
                  </Setter.Value></Setter>
                </Style>
              </GroupStyle.ContainerStyle>
            </GroupStyle>
            <!-- One service or scheduled task Hush offers (OffSwitchChoice): switch, plain name with a "?" explanation, what it does right now, and its level
                 (green: rarely needed, amber: read first or left behind). Shared by the Services and Scheduled tasks cards. -->
            <DataTemplate x:Key="ServiceTemplate">
              <StackPanel>
                <Border x:Name="RowDivider" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding On, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}"/><InlineUIContainer BaselineAlignment="Center"><local:HelpMark Style="{StaticResource HelpMark}" HelpText="{Binding HelpText}" AutomationProperties.Name="{Binding HelpName}"/></InlineUIContainer></TextBlock>
                    <TextBlock Text="{Binding Status}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="LevelDot" Width="10" Height="10" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LevelLabel}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Amber}" Value="True"><Setter TargetName="LevelDot" Property="Fill" Value="{DynamicResource MeterWarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0"><Setter TargetName="RowDivider" Property="Visibility" Value="Collapsed"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
            <!-- One compact line per choice, laid out like O&O ShutUp10++: the switch first, then the name with a "?" (the explanation opens in a popup),
                 and the level (green dot Recommended, amber dot Somewhat recommended) at the right. A note shows only when a choice is blocked. -->
            <DataTemplate x:Key="AdjustmentTemplate">
              <StackPanel>
                <Border x:Name="RowDivider" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}"/><InlineUIContainer BaselineAlignment="Center"><local:HelpMark Style="{StaticResource HelpMark}" HelpText="{Binding HelpText}" AutomationProperties.Name="More about this setting"/></InlineUIContainer></TextBlock>
                    <TextBlock x:Name="RowStatus" Text="{Binding Status}" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MeterWarnBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="LevelDot" Width="10" Height="10" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LevelLabel}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBlocked}" Value="True"><Setter TargetName="RowStatus" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Advanced}" Value="True"><Setter TargetName="LevelDot" Property="Fill" Value="{DynamicResource MeterWarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0"><Setter TargetName="RowDivider" Property="Visibility" Value="Collapsed"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </Grid.Resources>
          <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <TextBlock x:Name="SettingsTitle" Text="Settings" Style="{StaticResource PageTitle}" VerticalAlignment="Top" Margin="0,10,0,0"/>
            <Button x:Name="SettingsBackButton" Content="Back" Style="{StaticResource BackButton}" Click="SettingsBack_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,-14,0" AutomationProperties.Name="Back from settings"/>
          </Grid>
          <!-- The 8 DIP overlay scrollbar lives in a 22 DIP strip to the right of the cards (viewer extends into the page margin), so cards never shift or sit under it. -->
          <ScrollViewer x:Name="WindowsSettingsScroll" Grid.Row="1" Style="{StaticResource PageScroll}" SizeChanged="SettingsScroll_SizeChanged" Margin="0,8,-22,0" Padding="0,0,22,16">
            <StackPanel>
            <!-- Windows Update is off (turned off from Hush): a lasting red line with one click back. -->
            <Border x:Name="UpdateOffBanner" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="28,14,20,14" Margin="0,0,0,16">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateOffText" Text="Windows Update is off. Your PC gets no security fixes through it until you turn it back on." Foreground="{DynamicResource CleanTextBrush}" FontSize="{DynamicResource CompactFontSize}" FontWeight="Medium" TextWrapping="Wrap" LineHeight="22" VerticalAlignment="Center"/>
                <Button x:Name="UpdateBackOnButton" Grid.Column="2" Content="Turn Windows Update back on" Click="UpdateBackOn_Click" Style="{StaticResource TextButton}" Foreground="{DynamicResource CleanTextBrush}" local:Motion.HoverForeground="{DynamicResource HeadingBrush}" Padding="14,9" AutomationProperties.Name="Turn Windows Update back on"/>
              </Grid>
            </Border>
            <!-- Info: as simple as it gets. A title with one short line, the Boost button on the right of that same row (centered on it, its right edge
                 on the card's content edge like the last bar), a hairline that becomes the Boost sweep while Boost runs, and four slim vertical bars
                 with a value and a label each. Everything else (explanations, last check, memory use) is in tooltips, not on the card. -->
            <Border x:Name="SettingsInfoCard" Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="28,22,28,26" Margin="0,0,0,16" AutomationProperties.Name="Info">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Info" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="InfoSummary" Text="Reading this PC…" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button x:Name="BoostButton" Style="{StaticResource AccentOutlineButton}" Grid.Column="2" Content="Boost" Click="Boost_Click" Height="42" MinWidth="124" Padding="26,0" VerticalAlignment="Center" AutomationProperties.Name="Boost" ToolTip="Clean Safe temporary files and release idle memory"/>
                </Grid>
                <Grid Height="5" Margin="0,20,0,20">
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                  <local:UpdateActivity x:Name="BoostSweep" Height="5"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="12" Height="46" CornerRadius="6" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Center">
                      <Border x:Name="CpuFill" Height="46" CornerRadius="6" Background="{DynamicResource GoodBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform></Border>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="CpuText" Text="…" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock Text="Processor" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="12" Height="46" CornerRadius="6" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Center">
                      <Border x:Name="MemoryFill" Height="46" CornerRadius="6" Background="{DynamicResource GoodBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform></Border>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="MemoryText" Text="…" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock Text="Memory usage" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Border Width="12" Height="46" CornerRadius="6" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Center">
                      <Border x:Name="TempFill" Height="46" CornerRadius="6" Background="{DynamicResource GoodBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform></Border>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="TempText" Text="…" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock Text="Temporary files" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Width="12" Height="46" CornerRadius="6" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Center">
                      <Border x:Name="DiskFill" Height="46" CornerRadius="6" Background="{DynamicResource GoodBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform></Border>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="DiskText" Text="…" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock Text="System drive used" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <!-- 0.9: the sections sit in two columns side by side (one column when the window is narrow, see ApplySettingsColumns). -->
            <Grid x:Name="SettingsColumns">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel x:Name="SettingsLeftColumn">
            <!-- Process: a small card near Info. The summary says how many apps are open; opening it lists them, each with an End button. -->
            <Expander x:Name="SettingsProcessSection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="Process" Expanded="Process_Expanded">
              <Expander.Header>
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Process" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Apps with a window open right now. Ending one asks it to close first, so it can offer to save; anything unsaved in it can be lost." AutomationProperties.Name="More about Process"/></StackPanel>
                  <TextBlock x:Name="ProcessSummary" Text="Reading open apps…" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel Margin="0,14,0,8">
                
                <ItemsControl x:Name="ProcessList" AlternationCount="1000" ItemTemplate="{StaticResource ProcessTemplate}"/>
                <TextBlock x:Name="ProcessEmpty" Text="No other apps have a window open." Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                <TextBlock x:Name="ProcessNote" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                <Button x:Name="RefreshProcessesButton" Content="Refresh" Click="RefreshProcesses_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" HorizontalAlignment="Left" Margin="-14,8,0,0"/>
              </StackPanel>
            </Expander>
            <!-- Administrator mode: one switch. The question is asked once at the first start; this changes the answer later. -->
            <Expander x:Name="SettingsAdminSection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="Administrator mode">
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="Administrator" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="AdminSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel Margin="0,10,0,6">
                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Run Hush as administrator" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center"/>
                      <local:HelpMark Style="{StaticResource HelpMark}" Margin="8,0,0,0" AutomationProperties.Name="More about administrator mode" HelpText="System Temp, Prefetch, Windows logs and Windows Update files can only be cleaned as administrator. Hush still shows everything first and asks before cleaning. The installed copy moves to Program Files and starts through one task, so there is no permission prompt on each start; a portable copy asks each time."/>
                    </StackPanel>
                  </StackPanel>
                  <CheckBox x:Name="AdminModeBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Click="AdminMode_Click" VerticalAlignment="Center" AutomationProperties.Name="Run Hush as administrator"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Minimize to tray" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center"/>
                      <local:HelpMark Style="{StaticResource HelpMark}" Margin="8,0,0,0" AutomationProperties.Name="More about Minimize to tray" HelpText="When you minimize Hush it hides next to the clock (the notification area) instead of staying in the taskbar. Click its icon to open it again, or right-click it for Open and Quit. The close button still closes Hush."/>
                    </StackPanel>
                  </StackPanel>
                  <CheckBox x:Name="MinimizeToTrayBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Click="MinimizeToTray_Click" VerticalAlignment="Center" AutomationProperties.Name="Minimize to tray"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Start with Windows" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center"/>
                      <local:HelpMark Style="{StaticResource HelpMark}" Margin="8,0,0,0" AutomationProperties.Name="More about Start with Windows" HelpText="Opens Hush when you sign in to Windows, quietly: minimized, or in the tray when Minimize to tray is on. It never starts in front of what you are doing. With administrator mode on, the installed copy starts without a permission prompt; a portable copy would ask Windows' permission at every sign-in, so install Hush if you want both."/>
                    </StackPanel>
                  </StackPanel>
                  <CheckBox x:Name="StartWithWindowsBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Click="StartWithWindows_Click" VerticalAlignment="Center" AutomationProperties.Name="Start with Windows"/>
                </Grid>
              </StackPanel>
            </Expander>
              </StackPanel>
              <StackPanel x:Name="SettingsRightColumn" Grid.Column="1" Margin="16,0,0,0">
            <Expander x:Name="SettingsBoostSection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="Smart Boost">
              <!-- The card shows the live details before it is opened: summary, three resource meters, Hush's own memory and the last check. -->
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="Smart Boost" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="BoostSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <!-- Quick Boost -->

                <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Quick Boost" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Scans only the Safe items and shows you what it found before anything is removed." AutomationProperties.Name="More about Quick Boost"/></StackPanel>
                  </StackPanel>
                  <Button x:Name="QuickBoostButton" Grid.Column="2" Content="Quick Boost" Click="QuickBoost_Click" Style="{StaticResource AccentTextButton}" Padding="16,9" AutomationProperties.Name="Quick Boost"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Watch for junk" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="While Hush is open (also minimized) it now and then counts Safe junk, quietly and at low priority. Nothing is deleted; Hush only tells you." AutomationProperties.Name="More about Watch for junk"/></StackPanel>
                  </StackPanel>
                  <CheckBox x:Name="MonitorJunkBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Click="MonitorJunk_Click" VerticalAlignment="Center" AutomationProperties.Name="Watch for junk"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Automatic Boost" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="When Safe junk passes your threshold, Hush cleans those Safe items by itself. Review and Advanced items are never included. Off unless you turn it on." AutomationProperties.Name="More about Automatic Boost"/></StackPanel>
                  </StackPanel>
                  <CheckBox x:Name="AutoBoostBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Click="AutoBoost_Click" VerticalAlignment="Center" AutomationProperties.Name="Automatic Boost"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <StackPanel x:Name="ThresholdRow" Margin="0,16">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Cleanup threshold" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="How much Safe junk must build up before Hush mentions it (or cleans it, with Automatic Boost)." AutomationProperties.Name="More about Cleanup threshold"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="-13,0,0,0">
                    <RadioButton x:Name="Threshold500" GroupName="Threshold" Content="500 MB" Tag="500" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                    <RadioButton x:Name="Threshold1000" GroupName="Threshold" Content="1 GB" Tag="1000" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                    <RadioButton x:Name="Threshold2000" GroupName="Threshold" Content="2 GB" Tag="2000" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                    <RadioButton x:Name="Threshold5000" GroupName="Threshold" Content="5 GB" Tag="5000" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                  </StackPanel>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <StackPanel x:Name="IntervalRow" Margin="0,16">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Check every" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Longer gaps mean less background activity." AutomationProperties.Name="More about Check every"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="-13,0,0,0">
                    <RadioButton x:Name="Interval15" GroupName="Interval" Content="15 minutes" Tag="15" Style="{StaticResource ChoiceChip}" Click="Interval_Click"/>
                    <RadioButton x:Name="Interval60" GroupName="Interval" Content="1 hour" Tag="60" Style="{StaticResource ChoiceChip}" Click="Interval_Click"/>
                    <RadioButton x:Name="Interval360" GroupName="Interval" Content="6 hours" Tag="360" Style="{StaticResource ChoiceChip}" Click="Interval_Click"/>
                    <RadioButton x:Name="Interval1440" GroupName="Interval" Content="Daily" Tag="1440" Style="{StaticResource ChoiceChip}" Click="Interval_Click"/>
                  </StackPanel>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Low-resource mode" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Hush uses less processor and disk: lower priority, Windows efficiency mode, slower progress updates. Scans take a little longer." AutomationProperties.Name="More about Low-resource mode"/></StackPanel>
                  </StackPanel>
                  <CheckBox x:Name="LowResourceBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Click="LowResource_Click" VerticalAlignment="Center" AutomationProperties.Name="Low-resource mode"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <!-- Startup apps: Task Manager's on/off flag per program. Nothing is uninstalled. -->
                <StackPanel Margin="0,16,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal"><TextBlock Text="Startup apps" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Turning one off only stops it from starting with Windows. The program stays installed and you can turn it back on here." AutomationProperties.Name="More about Startup apps"/></StackPanel>
                      <TextBlock x:Name="StartupSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="UndoStartupButton" Grid.Column="1" Content="Undo" Click="UndoStartup_Click" Style="{StaticResource TextButton}" Visibility="Collapsed" VerticalAlignment="Top" AutomationProperties.Name="Undo startup change"/>
                  </Grid>
                  
                  <ItemsControl x:Name="StartupList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="StartupSwitch_Click" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="StartupStatus" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,8"/>
                </StackPanel>
              </StackPanel>
            </Expander>
            <!-- Browser data: history and cookies are never part of a scan. They are chosen here, marked (orange / the Clean red) and confirmed with warnings. -->
            <Expander x:Name="SettingsBrowserSection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="Browser data">
              <Expander.Header>
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Browser data" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Hush never touches saved passwords, bookmarks or open tabs. History and cookies are not part of any scan: choose them here, close the browser first, and Hush shows you exactly what it found before anything is removed." AutomationProperties.Name="More about Browser data"/></StackPanel>
                  <TextBlock x:Name="BrowserSummary" Text="Kept out of scans · nothing selected" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                
                <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Browser history" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                      <TextBlock Text="Review" FontSize="{DynamicResource SupportFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource MeterWarnBrush}" Margin="10,1,0,0"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="The list of sites you visited in Chromium browsers. Bookmarks and logins stay." AutomationProperties.Name="More about Browser history"/>
                    </StackPanel>
                    
                  </StackPanel>
                  <CheckBox x:Name="BrowserHistoryBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Tag="{DynamicResource MeterWarnBrush}" Click="BrowserChoice_Click" VerticalAlignment="Center" AutomationProperties.Name="Browser history"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="BrowserCookiesTitle" Text="Cookies and site data" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource CleanTextBrush}"/>
                      <TextBlock Text="Advanced" FontSize="{DynamicResource SupportFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource CleanTextBrush}" Margin="10,1,0,0"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Removing cookies signs you out of websites. Chromium browsers and Firefox." AutomationProperties.Name="More about Cookies and site data"/>
                    </StackPanel>
                    
                  </StackPanel>
                  <CheckBox x:Name="BrowserCookiesBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Tag="{DynamicResource CleanTextBrush}" Click="BrowserChoice_Click" VerticalAlignment="Center" AutomationProperties.Name="Cookies and site data"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7"/>
                <Grid Margin="0,16,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="BrowserStatus" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" VerticalAlignment="Center"/>
                  <Button x:Name="BrowserCleanButton" Style="{StaticResource AccentOutlineButton}" Grid.Column="2" Content="Review and clean…" Click="BrowserClean_Click" IsEnabled="False" Padding="18,8" AutomationProperties.Name="Review and clean browser data"/>
                </Grid>
              </StackPanel>
            </Expander>
              </StackPanel>
            </Grid>
            <!-- Interface size: scales the whole window content together (see UiScale) so nobody has to resize the window to read it. -->
            <Expander x:Name="SettingsSizeSection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="Appearance">
              <Expander.Header>
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Appearance" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Interface size makes everything in Hush bigger or smaller together, so you never have to resize the window just to read it. Smart fits the size of your screen. Main color is the color of the gauge, links, switches and glows. The Light theme uses a slightly darker shade of the same color so it stays easy to read. It does not change the green, amber and red that mark how safe something is." AutomationProperties.Name="More about Appearance"/></StackPanel>
                  <TextBlock x:Name="UiSizeSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel Margin="0,16,0,8">
                
                <StackPanel Orientation="Horizontal" Margin="-13,10,0,0">
                  <RadioButton x:Name="UiSizeSmart" GroupName="UiSize" Content="Smart" Tag="smart" Style="{StaticResource ChoiceChip}" Click="UiSize_Click" AutomationProperties.Name="Smart size"/>
                  <RadioButton x:Name="UiSize75" GroupName="UiSize" Content="75%" Tag="75" Style="{StaticResource ChoiceChip}" Click="UiSize_Click" AutomationProperties.Name="75 percent"/>
                  <RadioButton x:Name="UiSize100" GroupName="UiSize" Content="100%" Tag="100" Style="{StaticResource ChoiceChip}" Click="UiSize_Click" AutomationProperties.Name="100 percent"/>
                  <RadioButton x:Name="UiSize120" GroupName="UiSize" Content="120%" Tag="120" Style="{StaticResource ChoiceChip}" Click="UiSize_Click" AutomationProperties.Name="120 percent"/>
                </StackPanel>
                <TextBlock x:Name="UiSizeNote" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0"/>
                <TextBlock Text="Main color" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource SupportFontSize}" Margin="0,18,0,0"/>
                <TextBlock x:Name="AccentSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                <WrapPanel x:Name="AccentPanel" Margin="0,10,0,0"/>
              </StackPanel>
            </Expander>
            <!-- Services (0.9): services that start with Windows but that most people do not need, and ones left behind by removed programs. Nothing is claimed
                 about speed: each line shows what it uses right now. Needs administrator mode to change; every original setting is saved first and Undo restores it. -->
            <Expander x:Name="SettingsServicesSection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="Services" Expanded="Services_Expanded" Collapsed="TopicCard_Collapsed">
              <Expander.Header>
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Services" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Windows services are helpers that start with Windows. A few are rarely needed (fax, Xbox, offline maps) and some are left behind by programs you removed. Hush lists the ones it knows most home PCs do not need (Xbox, telemetry, phone, mixed reality, old networking and more), whether they run now or only start when asked, and disables the ones you switch off. A switch that is ON means the service is enabled, as Windows has it now; OFF means Hush will disable it after you review and confirm. It never touches security, update, core network, sign-in or driver services. Each line shows when it starts and what it uses right now; Hush does not promise a speed-up. Every original setting is saved first and Undo puts it back. Changing needs administrator mode." AutomationProperties.Name="More about Services"/></StackPanel>
                  <TextBlock x:Name="ServicesSummary" Text="Open to see what you can turn off" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel Margin="0,6,0,8">
                <!-- What the switches mean, once, where the list starts (the "?" on each line says more): ON = turn this off (a change waiting for Review), OFF = left as it is, like O&O ShutUp10++. -->
                <TextBlock x:Name="ServicesHint" Text="Switch a service on to disable it, or switch one Hush turned off back off to restore it. Nothing changes until you press “Review changes” at the bottom of this page." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,8"/>
                <ItemsControl x:Name="ServicesList" AlternationCount="200" ItemTemplate="{StaticResource ServiceTemplate}"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
                <TextBlock x:Name="ServicesEmpty" Text="No service on this PC needs a second look." Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                <TextBlock x:Name="ServicesStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                <!-- Footer like the Windows choices: Refresh and the Actions menu at the left, Undo and Review at the right. Every action only switches the matching
                     services ON and opens the usual review (nothing is written before it is confirmed). -->
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshServicesButton" Content="Refresh" Click="RefreshServices_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Margin="-14,0,0,0"/>
                    <Button x:Name="ServicesActionsButton" Click="ServicesActions_Click" Style="{StaticResource AccentOutlineButton}" Padding="18,9" AutomationProperties.Name="Actions: choose services" Margin="10,0,0,0">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="Actions"/><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="9,2,0,0" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                        <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsOpen, ElementName=ServicesActionsPopup}" Value="True">
                          <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                          <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                        </DataTrigger></Style.Triggers></Style></Path.Style>
                      </Path></StackPanel>
                    </Button>
                    <Popup x:Name="ServicesActionsPopup" PlacementTarget="{Binding ElementName=ServicesActionsButton}" Placement="Top" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-4">
                      <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="6" Margin="14,14,14,18">
                        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000"/></Border.Effect>
                        <StackPanel MinWidth="380">
                          <Button x:Name="ServicesActionRareButton" Style="{StaticResource MenuAction}" Click="ServicesActionRare_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource GoodBrush}" Margin="0,0,14,0"/><TextBlock Text="Turn off only the rarely needed services"/></StackPanel></Button>
                          <Button x:Name="ServicesActionReadFirstButton" Style="{StaticResource MenuAction}" Click="ServicesActionReadFirst_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource MeterWarnBrush}" Margin="0,0,14,0"/><TextBlock Text="Rarely needed and read-first services"/></StackPanel></Button>
                          <Button x:Name="ServicesActionAllButton" Style="{StaticResource MenuAction}" Click="ServicesActionAll_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource CleanTextBrush}" Margin="0,0,14,0"/><TextBlock Text="Turn off every service in the list"/></StackPanel></Button>
                          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,5"/>
                          <Button x:Name="ServicesActionClearButton" Style="{StaticResource MenuAction}" Click="ServicesActionClear_Click"><TextBlock Text="Clear my choices"/></Button>
                          <Button x:Name="ServicesActionUndoButton" Style="{StaticResource MenuAction}" Click="ServicesActionUndo_Click"><TextBlock Text="Undo all changes"/></Button>
                        </StackPanel>
                      </Border>
                    </Popup>
                  </StackPanel>
                  <Button x:Name="ServicesUndoButton" Grid.Column="2" Content="Undo changes" Click="ServicesUndo_Click" Style="{StaticResource TextButton}" Visibility="Collapsed" AutomationProperties.Name="Put the changed services back"/>
                </Grid>
              </StackPanel>
            </Expander>
            <!-- Scheduled tasks (0.9): the sibling of Services, full width under the two balanced columns. Tasks most home PCs do not need (telemetry, app updaters)
                 and ones left behind by removed programs. Read when the card is opened; turning one off disables it (never deletes it), with the original saved first and Undo. -->
            <Expander x:Name="SettingsTasksSection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="Scheduled tasks" Expanded="Tasks_Expanded" Collapsed="TopicCard_Collapsed">
              <Expander.Header>
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Scheduled tasks" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Scheduled tasks are jobs Windows runs by itself at set times, at start-up or when you sign in. Some only collect usage data for Microsoft or check for app updates in the background, and some are left behind by programs you removed. Hush lists the ones it knows most home PCs do not need and turns off the ones you switch off: the task stays on the PC, it just no longer runs. A switch that is ON means the task is enabled, as Windows has it now; OFF means Hush will turn it off after you review and confirm. It never touches Windows Update, security, backup, restore or other system tasks. Hush does not promise a speed-up. Every original setting is saved first and Undo turns the tasks back on. Changing needs administrator mode." AutomationProperties.Name="More about Scheduled tasks"/></StackPanel>
                  <TextBlock x:Name="TasksSummary" Text="Open to see what you can turn off" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel Margin="0,6,0,8">
                <TextBlock x:Name="TasksHint" Text="Switch a task on to disable it, or switch one Hush turned off back off to restore it. Nothing changes until you press “Review changes” at the bottom of this page." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,8"/>
                <ItemsControl x:Name="TasksList" AlternationCount="200" ItemTemplate="{StaticResource ServiceTemplate}"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
                <TextBlock x:Name="TasksEmpty" Text="No scheduled task on this PC needs a second look." Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                <TextBlock x:Name="TasksStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="RefreshTasksButton" Content="Refresh" Click="RefreshTasks_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Margin="-14,0,0,0" AutomationProperties.Name="Read the scheduled tasks again"/>
                  <Button x:Name="TasksUndoButton" Grid.Column="1" Content="Undo changes" Click="TasksUndo_Click" Style="{StaticResource TextButton}" Visibility="Collapsed" AutomationProperties.Name="Turn the changed scheduled tasks back on"/>
                </Grid>
              </StackPanel>
            </Expander>
            <Expander x:Name="SettingsPrivacySection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="Privacy and telemetry" Collapsed="TopicCard_Collapsed">
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="Privacy &amp; telemetry" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="PrivacySummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <TextBlock x:Name="WindowsSettingsSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"/>
                <TextBox x:Name="SettingsSearch" Style="{StaticResource SearchBox}" Tag="Find a Windows privacy setting…" TextChanged="SettingsSearch_Changed" Margin="0,14,0,4" AutomationProperties.Name="Find a Windows privacy setting"/>
                <TextBlock FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"><Run Text="Recommended" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}"/><Run Text=" · little or no effect on how Windows works. Choices for every user need administrator rights: Hush asks Windows when you apply them."/></TextBlock>
                <ItemsControl x:Name="PrivacyAdjustments" AlternationCount="100" ItemTemplate="{StaticResource AdjustmentTemplate}" Margin="0,0,0,0"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
              </StackPanel>
            </Expander>
            <Expander x:Name="SettingsImpactSection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="More impact" Margin="0" Collapsed="TopicCard_Collapsed">
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="More impact" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="ImpactSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <TextBlock FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"><Run Text="Somewhat recommended" FontWeight="SemiBold" Foreground="{DynamicResource MeterWarnBrush}"/><Run Text=" · useful for privacy, but you may notice a difference: some apps or features can stop working. Read each one first. Nothing here uninstalls apps or turns off services. Choices for every user need administrator rights."/></TextBlock>
                <ItemsControl x:Name="AdvancedAdjustments" AlternationCount="100" ItemTemplate="{StaticResource AdjustmentTemplate}" Margin="0,0,0,0"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
              </StackPanel>
            </Expander>
            <!-- Windows Update: a red (Advanced) choice in its own card. Off means completely off, with every original value saved first and Undo. -->
            <Expander x:Name="SettingsUpdateSection" Style="{StaticResource SettingsSection}" AutomationProperties.Name="Windows Update" Margin="0,16,0,0">
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="Windows Update" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="UpdateSwitchSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <Grid Margin="0,16,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                  <TextBlock Text="Turn off Windows Update" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource CleanTextBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Advanced" FontSize="{DynamicResource SupportFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource CleanTextBrush}" Margin="10,1,0,0" VerticalAlignment="Center"/>
                  <local:HelpMark Style="{StaticResource HelpMark}" AutomationProperties.Name="More about turning off Windows Update" HelpText="Turns Windows Update off completely: its policies, the update services and the update scheduled tasks. Your PC then stops getting security fixes and Defender updates through Windows Update until you turn this back on. Every original value is saved first and Undo puts them all back. Needs administrator rights."/>
                </StackPanel>
                <Button x:Name="TurnOffUpdateButton" Style="{StaticResource AccentOutlineButton}" Grid.Column="2" Content="Turn off…" Click="TurnOffUpdate_Click" Padding="18,8" AutomationProperties.Name="Turn off Windows Update"/>
              </Grid>
            </Expander>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="SettingsFooter" Grid.Row="2" Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="WindowsSettingsStatus" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,10"/>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshWindowsSettingsButton" Content="Refresh" Click="RefreshWindowsSettings_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" ToolTip="Read the Windows choices again"/>
                <Button x:Name="ActionsButton" Click="Actions_Click" Style="{StaticResource AccentOutlineButton}" Padding="18,9" AutomationProperties.Name="Actions: apply recommended settings" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Actions"/><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="9,2,0,0" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                    <!-- The chevron turns upside down while the menu is open and back when it closes (any way of closing), on the shared 280 ms easing. -->
                    <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsOpen, ElementName=ActionsPopup}" Value="True">
                      <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                    </DataTrigger></Style.Triggers></Style></Path.Style>
                  </Path></StackPanel>
                </Button>
                <Popup x:Name="ActionsPopup" PlacementTarget="{Binding ElementName=ActionsButton}" Placement="Top" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-4">
                  <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="6" Margin="14,14,14,18">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000"/></Border.Effect>
                    <StackPanel MinWidth="380">
                      <Button x:Name="ActionRecommendedButton" Style="{StaticResource MenuAction}" Click="ActionRecommended_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource GoodBrush}" Margin="0,0,14,0"/><TextBlock Text="Apply only recommended settings"/></StackPanel></Button>
                      <Button x:Name="ActionSomewhatButton" Style="{StaticResource MenuAction}" Click="ActionSomewhat_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource MeterWarnBrush}" Margin="0,0,14,0"/><TextBlock Text="Recommended and somewhat recommended settings"/></StackPanel></Button>
                      <Button x:Name="ActionAllButton" Style="{StaticResource MenuAction}" Click="ActionAll_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource CleanTextBrush}" Margin="0,0,14,0"/><TextBlock Text="Apply all settings"/></StackPanel></Button>
                      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,5"/>
                      <Button x:Name="ActionUndoButton" Style="{StaticResource MenuAction}" Click="ActionUndo_Click"><TextBlock Text="Undo all changes"/></Button>
                    </StackPanel>
                  </Border>
                </Popup>
              </StackPanel>
              <Button x:Name="UndoWindowsSettingsButton" Grid.Column="2" Content="Undo Windows changes" Click="UndoWindowsSettings_Click" Style="{StaticResource TextButton}" IsEnabled="False"/>
              <Button x:Name="ApplyWindowsSettingsButton" Style="{StaticResource AccentOutlineButton}" Grid.Column="4" Content="Review changes" Click="ReviewChanges_Click" IsEnabled="False" AutomationProperties.Name="Review all staged changes"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
      </Grid>
      <Border x:Name="ModalOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed">
        <!-- The Clean confirmation. Simple mode shows only the title (what will be freed), one calm line and the two buttons; Pro mode adds the breakdown by group and category and
             the short list of what will happen (see ShowConfirmation). Left edges line up on one 34 DIP margin, the amounts share one right edge. -->
        <Border x:Name="ConfirmCard" Background="{DynamicResource PanelBrush}" CornerRadius="24" Width="500" Padding="34,32,34,30" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock x:Name="ConfirmTitle" Text="Are you sure?" Style="{StaticResource PopupTitle}"/>
            <TextBlock x:Name="ConfirmSummary" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="23"/>
            <TextBlock x:Name="ConfirmHomeNote" Visibility="Collapsed" Text="Cleans only the green, recommended items. Use Take a look to choose more." FontSize="{DynamicResource CompactFontSize}" Foreground="{DynamicResource GoodBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0"/>
            <ScrollViewer x:Name="ConfirmScroll" MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,22,0,0">
              <StackPanel Margin="0,0,8,0">
                <Border Background="{DynamicResource RaisedBrush}" CornerRadius="14" Padding="18,16">
                  <StackPanel x:Name="ConfirmGroups" Grid.IsSharedSizeScope="True"/>
                </Border>
                <TextBlock x:Name="ConfirmDetail" FontSize="{DynamicResource CompactFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="2,18,0,0"/>
              </StackPanel>
            </ScrollViewer>
            <!-- Advanced (red) cleanups are irreversible or touch recovery data: Clean stays off until this is ticked. -->
            <CheckBox x:Name="AdvancedConsentBox" Visibility="Collapsed" Click="AdvancedConsent_Click" Style="{StaticResource CandidateCheckBox}" Tag="{DynamicResource CleanTextBrush}" Margin="0,20,0,0" FontSize="{DynamicResource CompactFontSize}" Content="I understand some of this cannot be undone" IsEnabled="True" AutomationProperties.Name="I understand some of this cannot be undone"/>
            <Grid Margin="0,28,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="ConfirmDeleteButton" Content="Clean selected" Click="ConfirmDelete_Click" Style="{StaticResource DangerButton}" Padding="12,9" FontSize="{DynamicResource ActionFontSize}"/>
              <Button x:Name="CancelDeleteButton" Grid.Column="2" Content="Keep my files" Click="CancelDelete_Click" Padding="12,9" FontSize="{DynamicResource ActionFontSize}"/>
            </Grid>
          </StackPanel>
        </Border>
      </Border>
      <Border x:Name="WindowsSettingsOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
        <Border x:Name="WindowsSettingsCard" Background="{DynamicResource PanelBrush}" CornerRadius="24" Width="550" MaxHeight="650" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="WindowsConfirmTitle" Text="Apply Windows changes?" Style="{StaticResource PopupTitle}"/>
            <ScrollViewer Grid.Row="1" MaxHeight="410" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,22,0,24">
              <StackPanel>
                <TextBlock x:Name="WindowsConfirmSummary" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="25"/>
                <TextBlock x:Name="WindowsConfirmDetail" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="23" Margin="0,20,0,0"/>
                <TextBlock x:Name="WindowsConfirmNote" FontSize="{DynamicResource BodyFontSize}" FontWeight="Medium" Foreground="{DynamicResource MeterWarnBrush}" TextWrapping="Wrap" LineHeight="25" Margin="0,20,0,0" Visibility="Collapsed"/>
                <!-- These boxes use the Review checkbox style, whose IsEnabled follows "a scan result can be selected" (CanSelectCandidates). Without a scan result that made the
                     consent box dead (faded, impossible to tick), so the "Turn off Windows Update" button could never be enabled. They are always enabled here (local value). -->
                <StackPanel x:Name="WindowsOptions" Margin="0,20,0,0" Visibility="Collapsed">
                  <CheckBox x:Name="RestorePointBox" IsEnabled="True" IsChecked="True" Content="Create a restore point first" Style="{StaticResource CandidateCheckBox}" Tag="{DynamicResource TealTextBrush}" FontSize="{DynamicResource CompactFontSize}" AutomationProperties.Name="Create a restore point first"/>
                  <TextBlock x:Name="RestorePointNote" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="30,4,0,0" Visibility="Collapsed"/>
                  <CheckBox x:Name="EnableProtectionBox" IsEnabled="True" Content="Turn on System Protection for drive C: first" Visibility="Collapsed" Style="{StaticResource CandidateCheckBox}" Tag="{DynamicResource TealTextBrush}" FontSize="{DynamicResource CompactFontSize}" Margin="0,12,0,0" AutomationProperties.Name="Turn on System Protection first"/>
                  <CheckBox x:Name="AlsoUpdateOffBox" IsEnabled="True" Content="Also turn off Windows Update (no security fixes through it)" Visibility="Collapsed" Style="{StaticResource CandidateCheckBox}" Tag="{DynamicResource CleanTextBrush}" FontSize="{DynamicResource CompactFontSize}" Margin="0,14,0,0" AutomationProperties.Name="Also turn off Windows Update"/>
                  <CheckBox x:Name="WindowsConsentBox" IsEnabled="True" Content="I understand my PC gets no security fixes until I turn this back on" Visibility="Collapsed" Click="WindowsConsent_Click" Style="{StaticResource CandidateCheckBox}" Tag="{DynamicResource CleanTextBrush}" FontSize="{DynamicResource CompactFontSize}" Margin="0,14,0,0" AutomationProperties.Name="I understand Windows Update is off until I turn it back on"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="ConfirmWindowsSettingsButton" Content="Apply changes" Click="ConfirmWindowsSettings_Click"/>
              <Button x:Name="CancelWindowsSettingsButton" Grid.Column="2" Content="Cancel" Click="CancelWindowsSettings_Click" Style="{StaticResource TextButton}"/>
            </Grid>
          </Grid>
        </Border>
      </Border>
      <Border x:Name="AboutOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed">
        <Border x:Name="AboutCard" Background="{DynamicResource PanelBrush}" CornerRadius="24" Width="500" MaxHeight="650" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel KeyboardNavigation.TabNavigation="Cycle">
            <!-- 0.9 layout: the title row is the Hush logo at the left and Check for updates / Update now at the right, centered on the logo; directly under the logo,
                 close to it, the version with the short update status beside it (green when a newer version exists); the filling bar below both; then what is new. -->
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="AboutTitle" Text="Hush" FontSize="28" FontWeight="Medium" Foreground="{DynamicResource TealTextBrush}" VerticalAlignment="Center"/>
              <!-- The 14 DIP padding is hit area only: the text of the last button ends on the card's content edge. -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,-14,0">
                <Button x:Name="CheckUpdateButton" Content="Check for updates" Click="CheckUpdate_Click" Style="{StaticResource AccentTextButton}" Padding="14,9" HorizontalAlignment="Right"/>
                <Button x:Name="CancelUpdateButton" Content="Cancel" Click="CancelUpdate_Click" Style="{StaticResource TextButton}" Padding="14,9" Visibility="Collapsed"/>
              </StackPanel>
            </Grid>
            <StackPanel x:Name="UpdateStatusBlock" Margin="0,0,0,0">
              <WrapPanel>
                  <TextBlock x:Name="AboutVersion" FontSize="{DynamicResource BodyFontSize}" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock x:Name="UpdateStatus" Visibility="Collapsed" FontSize="{DynamicResource CompactFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </WrapPanel>
              <local:UpdateActivity x:Name="UpdateSweep" Height="5" Margin="0,10,0,0"/>
              <TextBlock x:Name="UpdateHint" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/>
            </StackPanel>
            <Border x:Name="PatchNotesPanel" Margin="0,24,0,0"><StackPanel>
              <TextBlock x:Name="PatchNotesHeading" Text="What's new in this version" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
              <TextBlock x:Name="PatchNotes" FontSize="{DynamicResource CompactFontSize}" TextWrapping="Wrap" LineHeight="23" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
            </StackPanel></Border>
            <TextBlock x:Name="AboutDescription" Text="Happy Users, Simple Habits, Windows Cleaner" FontSize="17" LineHeight="26" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,24,0,0"/>
            <TextBlock x:Name="AboutTerms" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"/>
            <!-- Footer: Terms of use (quiet) at the left, Close (the exit) at the right. The update action sits with the status above and comes first in tab order. -->
            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="TermsButton" Content="Terms of use" Click="Terms_Click" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Padding="0,8" Height="36" AutomationProperties.Name="Terms of use"/>
              <Button x:Name="CloseAboutButton" Grid.Column="2" Content="Close" Click="CloseAbout_Click" Style="{StaticResource TextButton}" Padding="0,9"/>
            </Grid>
          </StackPanel>
        </Border>
      </Border>
      <!-- Drawn after (above) the About card so the update confirmation appears on top of it. -->
      <Border x:Name="ConsentOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="24" Width="510" Padding="34" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock x:Name="ConsentTitle" Style="{StaticResource PopupTitle}" TextWrapping="Wrap"/>
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,26">
              <TextBlock x:Name="ConsentText" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="25" Margin="0,0,10,0"/>
            </ScrollViewer>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="ConsentConfirmButton" Content="Turn on" Click="ConsentConfirm_Click" Padding="12,9" FontSize="{DynamicResource ActionFontSize}"/>
              <Button x:Name="ConsentCancelButton" Grid.Column="2" Content="Not now" Click="ConsentCancel_Click" Style="{StaticResource TextButton}" FontSize="{DynamicResource ActionFontSize}"/>
            </Grid>
          </StackPanel>
        </Border>
      </Border>
      <Thumb Grid.RowSpan="2" Height="5" Margin="24,0" VerticalAlignment="Top" Cursor="SizeNS" Tag="T" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Height="5" Margin="24,0" VerticalAlignment="Bottom" Cursor="SizeNS" Tag="B" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="5" Margin="0,24" HorizontalAlignment="Left" Cursor="SizeWE" Tag="L" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="5" Margin="0,24" HorizontalAlignment="Right" Cursor="SizeWE" Tag="R" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Tag="TL" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Tag="TR" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Tag="BL" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
      <Thumb Grid.RowSpan="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Tag="BR" DragDelta="Resize_DragDelta" Template="{StaticResource ResizeThumb}"/>
    </Grid>
  </Border>
</Window>
