                <Border x:Name="ThresholdDivider" Style="{StaticResource RowDivider}"/>
                <Grid x:Name="ThresholdRow" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Cleanup threshold" Style="{StaticResource RowName}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="How much Safe junk must build up before Hush mentions it (or cleans it, with Automatic Boost)." AutomationProperties.Name="More about Cleanup threshold"/></StackPanel>
                    <TextBlock Text="How much safe junk before Hush acts" Style="{StaticResource RowLine}"/>
                  </StackPanel>
                  <local:SegmentPanel Orientation="Horizontal" ThumbBrush="{DynamicResource RaisedBrush}" ThumbRadius="10" Grid.Column="2"  VerticalAlignment="Center">
                    <RadioButton x:Name="Threshold500" GroupName="Threshold" Content="500 MB" Tag="500" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                    <RadioButton x:Name="Threshold1000" GroupName="Threshold" Content="1 GB" Tag="1000" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                    <RadioButton x:Name="Threshold2000" GroupName="Threshold" Content="2 GB" Tag="2000" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                    <RadioButton x:Name="Threshold5000" GroupName="Threshold" Content="5 GB" Tag="5000" Style="{StaticResource ChoiceChip}" Click="Threshold_Click"/>
                  </local:SegmentPanel>
                </Grid>
                <Border x:Name="IntervalDivider" Style="{StaticResource RowDivider}"/>
                <Grid x:Name="IntervalRow" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Check every" Style="{StaticResource RowName}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Longer gaps mean less background activity." AutomationProperties.Name="More about Check every"/></StackPanel>
                    <TextBlock Text="Longer gaps mean less background activity" Style="{StaticResource RowLine}"/>
                  </StackPanel>
                  <local:SegmentPanel Orientation="Horizontal" ThumbBrush="{DynamicResource RaisedBrush}" ThumbRadius="10" Grid.Column="2"  VerticalAlignment="Center">
                    <RadioButton x:Name="Interval15" GroupName="Interval" Content="15 min" Tag="15" Style="{StaticResource ChoiceChip}" Click="Interval_Click" AutomationProperties.Name="15 minutes"/>
                    <RadioButton x:Name="Interval60" GroupName="Interval" Content="1 hour" Tag="60" Style="{StaticResource ChoiceChip}" Click="Interval_Click"/>
                    <RadioButton x:Name="Interval360" GroupName="Interval" Content="6 hours" Tag="360" Style="{StaticResource ChoiceChip}" Click="Interval_Click"/>
                    <RadioButton x:Name="Interval1440" GroupName="Interval" Content="Daily" Tag="1440" Style="{StaticResource ChoiceChip}" Click="Interval_Click"/>
                  </local:SegmentPanel>
                </Grid>
                <Border Style="{StaticResource RowDivider}"/>
                <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Low-resource mode" Style="{StaticResource RowName}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Hush uses less processor and disk: lower priority, Windows efficiency mode, slower progress updates. Scans take a little longer." AutomationProperties.Name="More about Low-resource mode"/></StackPanel>
                    <TextBlock Text="Hush uses less processor time while it works" Style="{StaticResource RowLine}"/>
                  </StackPanel>
                  <CheckBox x:Name="LowResourceBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Click="LowResource_Click" VerticalAlignment="Center" AutomationProperties.Name="Low-resource mode"/>
