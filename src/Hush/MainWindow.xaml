                  <TextBlock Text="ADMINISTRATOR" Style="{StaticResource SectionLabel}"/>
                  <TextBlock x:Name="AdminSummary" Grid.Column="1" Style="{StaticResource SectionState}" Margin="12,0,0,0"/>
                </Grid>
              </Expander.Header>
              <StackPanel>
                <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
