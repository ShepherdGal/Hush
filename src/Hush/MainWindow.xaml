                <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="BrowserCookiesTitle" Text="Cookies and site data" Style="{StaticResource RowName}" Foreground="{DynamicResource CleanTextBrush}"/><TextBlock Text="Risky" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource CleanTextBrush}" Margin="10,1,0,0" VerticalAlignment="Center"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Removing cookies signs you out of websites. Chromium browsers and Firefox." AutomationProperties.Name="More about Cookies and site data"/></StackPanel>
                    <TextBlock Text="Signs you out of websites" Style="{StaticResource RowLine}"/>
                  </StackPanel>
                  <CheckBox x:Name="BrowserCookiesBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Tag="{DynamicResource CleanTextBrush}" Click="BrowserChoice_Click" VerticalAlignment="Center" AutomationProperties.Name="Cookies and site data"/>
                </Grid>
                <Border Style="{StaticResource RowDivider}"/>
                <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="BrowserStatus" Style="{StaticResource RowLine}" VerticalAlignment="Center" Margin="0"/>
                  <Button x:Name="BrowserCleanButton" Style="{StaticResource AccentOutlineButton}" Grid.Column="2" Content="Review and clean…" Click="BrowserClean_Click" IsEnabled="False" Height="32" Padding="14,0" AutomationProperties.Name="Review and clean browser data"/>
                </Grid>
              </StackPanel>
            </Expander>
            <!-- Open apps (owner, November 20, 2026): the list shows straight away (it is read once the page has faded in, with the other live readings). -->
            <Expander x:Name="SettingsProcessSection" Style="{StaticResource SettingsGroup}" IsExpanded="True" AutomationProperties.Name="Open apps">
              <Expander.Header>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="OPEN APPS" Style="{StaticResource SectionLabel}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Apps with a window open right now, and helpers that closed apps left running. Ending one asks it to close first, so it can offer to save; anything unsaved in it can be lost." AutomationProperties.Name="More about Open apps"/></StackPanel>
                </Grid>
              </Expander.Header>
              <StackPanel>
                <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="Apps running now" Style="{StaticResource RowName}"/><TextBlock x:Name="ProcessSummary" Text="Reading open apps…" Style="{StaticResource RowLine}"/></StackPanel>
                </Grid>
                <StackPanel x:Name="ProcessListPanel" Margin="0,0,0,10">
                <Border Style="{StaticResource RowDivider}" Margin="0,0,0,6"/>
                <ItemsControl x:Name="ProcessList" AlternationCount="1000" ItemTemplate="{StaticResource ProcessTemplate}"/>
                <TextBlock x:Name="ProcessEmpty" Text="No other apps have a window open." Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                <StackPanel x:Name="BackgroundProcessesPanel" Visibility="Collapsed" Margin="0,18,0,0">
                  <TextBlock FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21"><Run x:Name="BackgroundProcessSummary"/><InlineUIContainer BaselineAlignment="Center"><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Programs of yours that run without any window. &quot;Left behind&quot; are helper processes whose app has already closed; they do nothing useful on their own and the app starts them again when you open it. The others are still working (tray apps, sync tools, command-line tools): end one only if you know you don't need it." AutomationProperties.Name="More about programs without a window"/></InlineUIContainer></TextBlock>
                  <ItemsControl x:Name="BackgroundProcessList" AlternationCount="1000" ItemTemplate="{StaticResource ProcessTemplate}" Margin="0,8,0,0"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
                </StackPanel>
                <TextBlock x:Name="ProcessNote" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                <Grid Margin="0,8,0,0">
                  <Button x:Name="RefreshProcessesButton" Content="Refresh" Click="RefreshProcesses_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" HorizontalAlignment="Left" Margin="-14,0,0,0"/>
                  <Button x:Name="EndLeftBehindButton" Click="EndLeftBehind_Click" Style="{StaticResource AccentOutlineButton}" Padding="18,9" HorizontalAlignment="Right" Visibility="Collapsed" AutomationProperties.Name="End everything closed apps left behind"><TextBlock x:Name="EndLeftBehindText" Text="End all left behind"/></Button>
                </Grid>
                </StackPanel>
              </StackPanel>
            </Expander>
              </StackPanel>
            </StackPanel>
            <!-- About Hush (both modes; owner's pick): version with Check for updates, the terms and support; the wordmark still opens the full About popup. -->
            <StackPanel x:Name="SettingsAboutGroup">
              <TextBlock Text="ABOUT HUSH" Style="{StaticResource SectionLabel}" Margin="4,0,4,8"/>
              <Border CornerRadius="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Padding="18,2">
                <StackPanel>
                  <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Version" Style="{StaticResource RowName}"/><TextBlock x:Name="SettingsVersionText" Style="{StaticResource RowLine}"/></StackPanel>
                    <Button x:Name="SettingsCheckUpdateButton" Grid.Column="2" Click="SettingsCheckUpdate_Click" Style="{StaticResource AccentOutlineButton}" Height="32" Padding="14,0" Content="Check for updates" AutomationProperties.Name="Check for updates"/>
                  </Grid>
                  <Border Style="{StaticResource RowDivider}"/>
                  <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Terms of use" Style="{StaticResource RowName}"/><TextBlock Text="Hush is free and used at your own risk" Style="{StaticResource RowLine}"/></StackPanel>
                    <Button x:Name="SettingsTermsButton" Grid.Column="2" Click="Terms_Click" Style="{StaticResource TextButton}" Height="32" Padding="14,0" Content="Read" AutomationProperties.Name="Read the terms of use"/>
                  </Grid>
                  <Border Style="{StaticResource RowDivider}"/>
                  <Button x:Name="SettingsSupportButton" Style="{StaticResource SupportCard}" Click="Support_Click" Margin="0,12" ToolTip="Opens ko-fi.com/trueshepherdmusic in your browser" AutomationProperties.Name="Support Hush on Ko-fi">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Path Width="18" Height="18" Stretch="None" VerticalAlignment="Center" Data="M9,15.5 C9,15.5 1.75,10.9 1.75,6.3 C1.75,4.1 3.4,2.5 5.4,2.5 C6.8,2.5 8.2,3.4 9,4.6 C9.8,3.4 11.2,2.5 12.6,2.5 C14.6,2.5 16.25,4.1 16.25,6.3 C16.25,10.9 9,15.5 9,15.5 Z" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Enjoying Hush? Support it on Ko-fi" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}"/>
                        <TextBlock Text="Hush stays free. A tip keeps it going." FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Path Grid.Column="3" Width="14" Height="14" Stretch="None" VerticalAlignment="Center" Margin="12,0,0,0" Data="M4,10 L10,4 M5.5,4 H10 V8.5" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <!-- Tweaks (Phase D, the approved mockup; owner's picks of November 20, 2026): one search for every tab (results from all tabs while typing), five sub-tabs
             with counts (the lists are read quietly in the background when Tweaks opens) and a dot while a tab holds staged changes, one card with the open tab's
             rows, and one glass bar: the open tab's Actions, Refresh, what is staged where, and the one Review button. Tweaks reopens on the tab used last. The cards
             are the old Settings cards (names, handlers and tests unchanged), shown as sections of the card. -->
        <Grid x:Name="TweaksPage" Visibility="Collapsed">
          <!-- One screen (owner, November 21, 2026), the same layout as Tools and Settings: the title, the one search and the rail (Overview first) in a 196 DIP column
               at the left; the open entry fills the card beside it, with the glass bar under the card. -->
          <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.RowSpan="2" Margin="0,10,0,0">
            <TextBlock x:Name="TweaksTitle" Text="Tweaks" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"/>
            <TextBox x:Name="SettingsSearch" DockPanel.Dock="Top" Margin="0,14,0,0" Style="{StaticResource SearchBox}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" Tag="Search all tweaks" TextChanged="SettingsSearch_Changed" AutomationProperties.Name="Search all tweaks"/>
            <TextBlock Text="Nothing changes until you review, and Undo puts it back." FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" DockPanel.Dock="Bottom"/>
            <ItemsControl x:Name="TweaksTabs" Margin="0,16,0,0" VerticalAlignment="Top" Focusable="False" ItemsPanel="{StaticResource RailPanel}" ItemContainerStyle="{StaticResource IconTabContainer}" ItemTemplate="{StaticResource RailTemplate}"/>
          </DockPanel>
          <Border x:Name="TweaksCard" Grid.Column="2" Margin="0,12,0,0" CornerRadius="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1">
          <ScrollViewer x:Name="TweaksScroll" Style="{StaticResource PageScroll}" Padding="20,0,20,16">
            <StackPanel x:Name="TweaksSectionsPanel">
              <!-- The Overview (owner's pick B, November 21, 2026): a few things worth a look, from the lists Tweaks reads quietly when it opens. -->
              <StackPanel x:Name="TweaksOverview" Margin="0,18,0,4">
                <TextBlock Text="Overview" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="Change how Windows behaves. Pick a list at the left, or start with these." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>
                <ItemsControl x:Name="TweaksSuggestions" Focusable="False" ItemTemplate="{StaticResource SuggestionTemplate}"/>
                <TextBlock Text="Everything else is in the list at the left." FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              </StackPanel>
              <TextBlock x:Name="TweaksNoMatch" Text="No tweak matches that search." Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,0"/>
            <!-- Startup (owner, November 14, 2026; Pro only): everything that starts with Windows, under five source headings. Read when the card is opened; the old
                 Smart Boost "Startup apps" list moved here. Switch ON = it does not start with Windows; changes go through Review changes. -->
            <Expander x:Name="SettingsStartupSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Startup" Expanded="Startup_Expanded" Collapsed="TopicCard_Collapsed">
              <Expander.Header>
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Startup" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Everything that starts with Windows, including the hidden kinds: apps in the registry and the Startup folders, scheduled tasks that run when you sign in, and services of other programs. Switch one on to stop it starting with Windows: apps are turned off like Task Manager does it, tasks are disabled, services are set to start only when needed. Nothing is uninstalled or deleted, every original is saved first and Undo puts it back. Items a policy owns, or that could stop Windows from starting, are shown but locked. Changes for all users, tasks and services need administrator mode." AutomationProperties.Name="More about Startup"/></StackPanel>
                  <TextBlock x:Name="StartupSummary" Text="Open to see what starts with Windows" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel Margin="0,6,0,8">
                <TextBlock Text="Switch something on to stop it starting with Windows, or switch something that is off back off to let it start again. Nothing changes until you press “Review changes” at the bottom of this page." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,8"/>
                <!-- Owner, November 20, 2026 (the Software Updates layout): one icon tab per source that holds something, its badge = how many lines it has. -->
                <Border x:Name="StartupTabsBar" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,8" Visibility="Collapsed">
                  <ItemsControl x:Name="StartupSourceTabs" Focusable="False" ItemsPanel="{StaticResource IconTabsPanel}" ItemContainerStyle="{StaticResource IconTabContainer}" ItemTemplate="{StaticResource IconTabTemplate}"/>
                </Border>
                <ItemsControl Grid.IsSharedSizeScope="True" x:Name="StartupList" AlternationCount="400" ItemTemplate="{StaticResource ServiceTemplate}"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
                <TextBlock x:Name="StartupEmpty" Text="Nothing starts with Windows from the places Hush checks." Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                <TextBlock x:Name="StartupStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button x:Name="RefreshStartupButton" Content="Refresh" Click="RefreshStartup_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Margin="-14,0,0,0" AutomationProperties.Name="Read what starts with Windows again"/>
                  <Button x:Name="StartupUndoButton" Grid.Column="1" Content="Undo changes" Click="StartupUndo_Click" Style="{StaticResource TextButton}" Visibility="Collapsed" AutomationProperties.Name="Let what Hush stopped start with Windows again"/>
                </Grid>
              </StackPanel>
            </Expander>
            <!-- Services (0.9): services that start with Windows but that most people do not need, and ones left behind by removed programs. Nothing is claimed
                 about speed: each line shows what it uses right now. Needs administrator mode to change; every original setting is saved first and Undo restores it. -->
            <Expander x:Name="SettingsServicesSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Services" Expanded="Services_Expanded" Collapsed="TopicCard_Collapsed">
              <Expander.Header>
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Services" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Windows services are helpers that start with Windows. A few are rarely needed (fax, Xbox, offline maps) and some are left behind by programs you removed. Hush lists the ones it knows most home PCs do not need (Xbox, telemetry, phone, mixed reality, old networking and more), whether they run now or only start when asked, and disables the ones you switch off. A switch that is ON means the service is enabled, as Windows has it now; OFF means Hush will disable it after you review and confirm. It never touches security, update, core network, sign-in or driver services. Each line shows when it starts and what it uses right now; Hush does not promise a speed-up. Every original setting is saved first and Undo puts it back. Changing needs administrator mode." AutomationProperties.Name="More about Services"/></StackPanel>
                  <TextBlock x:Name="ServicesSummary" Text="Open to see what you can turn off" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel Margin="0,6,0,8">
                <!-- What the switches mean, once, where the list starts (the "?" on each line says more): ON = turn this off (a change waiting for Review), OFF = left as it is. -->
                <TextBlock x:Name="ServicesHint" Text="Switch a service on to disable it, or switch one Hush turned off back off to restore it. Nothing changes until you press “Review changes” at the bottom of this page." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,8"/>
                <ItemsControl Grid.IsSharedSizeScope="True" x:Name="ServicesList" AlternationCount="200" ItemTemplate="{StaticResource ServiceTemplate}"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
                <TextBlock x:Name="ServicesEmpty" Text="No service on this PC needs a second look." Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                <TextBlock x:Name="ServicesStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                <!-- Footer like the Windows choices: Refresh and the Actions menu at the left, Undo and Review at the right. Every action only switches the matching
                     services ON and opens the usual review (nothing is written before it is confirmed). -->
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshServicesButton" Content="Refresh" Click="RefreshServices_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Margin="-14,0,0,0"/>

                  </StackPanel>
                  <Button x:Name="ServicesUndoButton" Grid.Column="2" Content="Undo changes" Click="ServicesUndo_Click" Style="{StaticResource TextButton}" Visibility="Collapsed" AutomationProperties.Name="Put the changed services back"/>
                </Grid>
              </StackPanel>
            </Expander>
            <!-- Scheduled tasks (0.9): the sibling of Services, full width under the two balanced columns. Tasks most home PCs do not need (telemetry, app updaters)
                 and ones left behind by removed programs. Read when the card is opened; turning one off disables it (never deletes it), with the original saved first and Undo. -->
            <Expander x:Name="SettingsTasksSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Scheduled tasks" Expanded="Tasks_Expanded" Collapsed="TopicCard_Collapsed">
              <Expander.Header>
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Scheduled tasks" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Scheduled tasks are jobs Windows runs by itself at set times, at start-up or when you sign in. Some only collect usage data for Microsoft or check for app updates in the background, and some are left behind by programs you removed. Hush lists the ones it knows most home PCs do not need and turns off the ones you switch off: the task stays on the PC, it just no longer runs. A switch that is ON means the task is enabled, as Windows has it now; OFF means Hush will turn it off after you review and confirm. It never touches Windows Update, security, backup, restore or other system tasks. Hush does not promise a speed-up. Every original setting is saved first and Undo turns the tasks back on. Changing needs administrator mode." AutomationProperties.Name="More about Scheduled tasks"/></StackPanel>
                  <TextBlock x:Name="TasksSummary" Text="Open to see what you can turn off" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel Margin="0,6,0,8">
                <TextBlock x:Name="TasksHint" Text="Switch a task on to disable it, or switch one Hush turned off back off to restore it. Nothing changes until you press “Review changes” at the bottom of this page." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,8"/>
                <ItemsControl Grid.IsSharedSizeScope="True" x:Name="TasksList" AlternationCount="200" ItemTemplate="{StaticResource ServiceTemplate}"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
                <TextBlock x:Name="TasksEmpty" Text="No scheduled task on this PC needs a second look." Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                <TextBlock x:Name="TasksStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="RefreshTasksButton" Content="Refresh" Click="RefreshTasks_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Margin="-14,0,0,0" AutomationProperties.Name="Read the scheduled tasks again"/>
                  <Button x:Name="TasksUndoButton" Grid.Column="1" Content="Undo changes" Click="TasksUndo_Click" Style="{StaticResource TextButton}" Visibility="Collapsed" AutomationProperties.Name="Turn the changed scheduled tasks back on"/>
                </Grid>
              </StackPanel>
            </Expander>
            <!-- Windows tweaks (owner, November 19, 2026; Pro only): one-switch changes to the right-click menu, File Explorer, the taskbar and Windows' ads. ON = the
                 tweak is (or will be) applied; changes go through Review changes; the original is saved first and switching it off puts it back. -->
            <Expander x:Name="SettingsTweaksSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Windows tweaks" Expanded="Tweaks_Expanded" Collapsed="TopicCard_Collapsed">
              <Expander.Header>
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Windows tweaks" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Small changes to how Windows looks and behaves: the right-click menu, File Explorer, the taskbar and Start, and the ads and tips Windows shows. Switch one on to apply it after you review; switch it off to put the original back. Hush saves every original first. Some show only after File Explorer restarts or you sign out. Tweaks for all users need administrator mode. No Bing in search, widgets off and Edge in the background are in Privacy &amp; telemetry." AutomationProperties.Name="More about Windows tweaks"/></StackPanel>
                  <TextBlock x:Name="TweaksSummary" Text="Open to see the tweaks" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel Margin="0,6,0,8">
                <TextBlock Text="Switch a tweak on to apply it, or off to put Windows back as it was. Nothing changes until you press “Review changes” at the bottom of this page." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,8"/>
                <ItemsControl Grid.IsSharedSizeScope="True" x:Name="TweaksList" AlternationCount="200" ItemTemplate="{StaticResource ServiceTemplate}"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
                <TextBlock x:Name="TweaksStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                <Button x:Name="RefreshTweaksButton" Content="Refresh" Click="RefreshTweaks_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" HorizontalAlignment="Left" Margin="-14,12,0,0" AutomationProperties.Name="Read the tweaks again"/>
              </StackPanel>
            </Expander>
            <Expander x:Name="SettingsPrivacySection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Privacy and telemetry" Collapsed="TopicCard_Collapsed">
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="Privacy &amp; telemetry" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="PrivacySummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <TextBlock x:Name="WindowsSettingsSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"/>
                <TextBlock FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"><Run Text="Recommended" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}"/><Run Text=" · little or no effect on how Windows works. Choices for every user need administrator rights: Hush asks Windows when you apply them."/></TextBlock>
                <ItemsControl x:Name="PrivacyAdjustments" AlternationCount="100" ItemTemplate="{StaticResource AdjustmentTemplate}" Margin="0,0,0,0"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
              </StackPanel>
            </Expander>
            <Expander x:Name="SettingsImpactSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="More impact" Margin="0" Collapsed="TopicCard_Collapsed">
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="More impact" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="ImpactSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <TextBlock FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"><Run Text="Somewhat recommended" FontWeight="SemiBold" Foreground="{DynamicResource MeterWarnBrush}"/><Run Text=" · useful for privacy, but you may notice a difference: some apps or features can stop working. Read each one first. Nothing here uninstalls apps or turns off services. Choices for every user need administrator rights."/></TextBlock>
                <ItemsControl x:Name="AdvancedAdjustments" AlternationCount="100" ItemTemplate="{StaticResource AdjustmentTemplate}" Margin="0,0,0,0"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
              </StackPanel>
            </Expander>
            <!-- Windows Update: a red (Advanced) choice in its own card. Off means completely off, with every original value saved first and Undo. -->
            <Expander x:Name="SettingsUpdateSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Windows Update">
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="Windows Update" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="UpdateSwitchSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander.Header>
              <Grid Margin="0,16,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                  <TextBlock Text="Turn off Windows Update" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource CleanTextBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Risky" FontSize="{DynamicResource SupportFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource CleanTextBrush}" Margin="10,1,0,0" VerticalAlignment="Center"/>
                  <local:HelpMark Style="{StaticResource HelpMark}" AutomationProperties.Name="More about turning off Windows Update" HelpText="Turns Windows Update off completely: its policies, the update services and the update scheduled tasks. Your PC then stops getting security fixes and Defender updates through Windows Update until you turn this back on. Every original value is saved first and Undo puts them all back. Needs administrator rights."/>
                </StackPanel>
                <Button x:Name="TurnOffUpdateButton" Style="{StaticResource AccentOutlineButton}" Grid.Column="2" Content="Turn off…" Click="TurnOffUpdate_Click" Padding="18,8" AutomationProperties.Name="Turn off Windows Update"/>
              </Grid>
            </Expander>
            </StackPanel>
          </ScrollViewer>
          </Border>
          <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
            <TextBlock x:Name="WindowsSettingsStatus" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="4,0,4,8"/>
            <!-- The glass bar: the open tab's Actions and Refresh at the left, what is staged where, and the one Review button (owner, November 9, 2026: one button for everything). -->
            <Border x:Name="TweaksFooterBar" CornerRadius="28" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Padding="8">
            <Grid x:Name="SettingsFooter"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ActionsButton" Click="Actions_Click" Style="{StaticResource AccentOutlineButton}" Padding="18,9" AutomationProperties.Name="Actions: apply recommended settings" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Actions"/><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="9,2,0,0" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                    <!-- The chevron turns upside down while the menu is open and back when it closes (any way of closing), on the shared 280 ms easing. -->
                    <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsOpen, ElementName=ActionsPopup}" Value="True">
                      <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                    </DataTrigger></Style.Triggers></Style></Path.Style>
                  </Path></StackPanel>
                </Button>
                <Popup x:Name="ActionsPopup" PlacementTarget="{Binding ElementName=ActionsButton}" Placement="Top" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-4">
                  <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="6" Margin="14,14,14,18">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000"/></Border.Effect>
                    <StackPanel MinWidth="380">
                      <Button x:Name="ActionRecommendedButton" Style="{StaticResource MenuAction}" Click="ActionRecommended_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource GoodBrush}" Margin="0,0,14,0"/><TextBlock Text="Apply only recommended settings"/></StackPanel></Button>
                      <Button x:Name="ActionSomewhatButton" Style="{StaticResource MenuAction}" Click="ActionSomewhat_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource MeterWarnBrush}" Margin="0,0,14,0"/><TextBlock Text="Recommended and somewhat recommended settings"/></StackPanel></Button>
                      <Button x:Name="ActionAllButton" Style="{StaticResource MenuAction}" Click="ActionAll_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource CleanTextBrush}" Margin="0,0,14,0"/><TextBlock Text="Apply all settings"/></StackPanel></Button>
                      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,5"/>
                      <Button x:Name="ActionUndoButton" Style="{StaticResource MenuAction}" Click="ActionUndo_Click"><TextBlock Text="Undo all changes"/></Button>
                    </StackPanel>
                  </Border>
                </Popup>
                    <Button x:Name="ServicesActionsButton" Click="ServicesActions_Click" Style="{StaticResource AccentOutlineButton}" Padding="18,9" AutomationProperties.Name="Actions: choose services" Margin="0" Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="Actions"/><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="9,2,0,0" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                        <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsOpen, ElementName=ServicesActionsPopup}" Value="True">
                          <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                          <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                        </DataTrigger></Style.Triggers></Style></Path.Style>
                      </Path></StackPanel>
                    </Button>
                    <Popup x:Name="ServicesActionsPopup" PlacementTarget="{Binding ElementName=ServicesActionsButton}" Placement="Top" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-4">
                      <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="6" Margin="14,14,14,18">
                        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000"/></Border.Effect>
                        <StackPanel MinWidth="380">
                          <Button x:Name="ServicesActionRareButton" Style="{StaticResource MenuAction}" Click="ServicesActionRare_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource GoodBrush}" Margin="0,0,14,0"/><TextBlock Text="Turn off only the rarely needed services"/></StackPanel></Button>
                          <Button x:Name="ServicesActionReadFirstButton" Style="{StaticResource MenuAction}" Click="ServicesActionReadFirst_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource MeterWarnBrush}" Margin="0,0,14,0"/><TextBlock Text="Rarely needed and read-first services"/></StackPanel></Button>
                          <Button x:Name="ServicesActionAllButton" Style="{StaticResource MenuAction}" Click="ServicesActionAll_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{DynamicResource CleanTextBrush}" Margin="0,0,14,0"/><TextBlock Text="Turn off every service in the list"/></StackPanel></Button>
                          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,5"/>
                          <Button x:Name="ServicesActionClearButton" Style="{StaticResource MenuAction}" Click="ServicesActionClear_Click"><TextBlock Text="Clear my choices"/></Button>
                          <Button x:Name="ServicesActionUndoButton" Style="{StaticResource MenuAction}" Click="ServicesActionUndo_Click"><TextBlock Text="Undo all changes"/></Button>
                        </StackPanel>
                      </Border>
                    </Popup>
                    <Button x:Name="TabActionsButton" Click="TabActions_Click" Style="{StaticResource AccentOutlineButton}" Padding="18,9" Visibility="Collapsed" AutomationProperties.Name="Actions for this list">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="Actions"/><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="9,2,0,0" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                        <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsOpen, ElementName=TabActionsPopup}" Value="True">
                          <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                          <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                        </DataTrigger></Style.Triggers></Style></Path.Style>
                      </Path></StackPanel>
                    </Button>
                    <Popup x:Name="TabActionsPopup" PlacementTarget="{Binding ElementName=TabActionsButton}" Placement="Top" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-4">
                      <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="6" Margin="14,14,14,18">
                        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000"/></Border.Effect>
                        <StackPanel MinWidth="300">
                          <Button x:Name="TabActionClearButton" Style="{StaticResource MenuAction}" Click="TabActionClear_Click"><TextBlock Text="Clear my choices"/></Button>
                          <Button x:Name="TabActionUndoButton" Style="{StaticResource MenuAction}" Click="TabActionUndo_Click"><TextBlock Text="Undo all changes"/></Button>
                        </StackPanel>
                      </Border>
                    </Popup>
                <Button x:Name="RefreshWindowsSettingsButton" Content="Refresh" Click="RefreshWindowsSettings_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" ToolTip="Read the Windows choices again" Margin="6,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="TweaksStagedSummary" Grid.Column="1" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,4,0"/>
              <Button x:Name="UndoWindowsSettingsButton" Grid.Column="2" Visibility="Collapsed" Content="Undo Windows changes" Click="UndoWindowsSettings_Click" Style="{StaticResource TextButton}" IsEnabled="False"/>
              <Button x:Name="ApplyWindowsSettingsButton" Style="{StaticResource AccentOutlineButton}" Grid.Column="4" Content="Review changes" Click="ReviewChanges_Click" IsEnabled="False" AutomationProperties.Name="Review all staged changes"/>
            </Grid>
            </Border>
          </StackPanel>
        </Grid>
        <!-- Tools (owner, November 19, 2026; Pro only): programs, Store apps, browser extensions and the shredder. Laid out like Settings: one column of cards that open
             closed, each read only when it is opened. -->
        <Grid x:Name="ToolsPage" Visibility="Collapsed">
          <Grid.Resources>

            <!-- One installed program (Phase D mockup): a tick for "uninstall several", its own icon (or a letter tile in a soft color from its name), name and
                 details, its size with its share of the largest, and Uninstall (or Remove leftovers), which lights up in the accent while the pointer is on the row. -->
            <local:KindIconConverter x:Key="KindIcon"/>
            <DataTemplate x:Key="ProgramTemplate">
              <Border x:Name="Row" CornerRadius="12" Background="Transparent" Padding="10,8" Margin="-10,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="96"/><ColumnDefinition Width="16"/><ColumnDefinition Width="156"/></Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="{Binding SelectName}"/>
                  <Grid Grid.Column="1" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border x:Name="LetterTile" CornerRadius="10" Background="{Binding TileBrush}" Opacity="{Binding TileOpacity}"><TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <Image x:Name="OwnIcon" Source="{Binding Icon}" Width="32" Height="32" Opacity="{Binding TileOpacity}" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                  </Grid>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource SupportFontSize}" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding Meta}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SizeLabel}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource GlassEdgeBrush}" Margin="0,5,0,0">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ShareStar}"/><ColumnDefinition Width="{Binding RestStar}"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TealTextBrush}" CornerRadius="2" Opacity="0.75"/>
                      </Grid>
                    </Border>
                  </StackPanel>
                  <Button x:Name="Action" Grid.Column="6" Content="{Binding ActionLabel}" Click="UninstallProgram_Click" Tag="{Binding}" Style="{StaticResource TextButton}" Height="32" Padding="16,0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{Binding ActionName}"/>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True"><Setter TargetName="LetterTile" Property="Visibility" Value="Collapsed"/><Setter TargetName="OwnIcon" Property="Visibility" Value="Visible"/></DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter TargetName="Action" Property="Style" Value="{StaticResource AccentOutlineButton}"/></Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
            <!-- One Store app (owner, November 20, 2026: the Software Updates row): a soft rounded row, a colored letter tile, name and details, Reset and End as
                 quiet text buttons and its own Uninstall button; the row takes the soft accent tint while the pointer is on it. -->
            <DataTemplate x:Key="StoreAppTemplate">
              <Grid x:Name="RowRoot" Margin="0,2" Background="Transparent">
                <Border x:Name="Row" CornerRadius="12" Background="{DynamicResource RaisedBrush}" BorderBrush="Transparent" BorderThickness="1"/>
                <Grid Margin="14,10,12,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="38" Height="38" CornerRadius="10" Background="{Binding TileBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                  </StackPanel>
                  <Button Grid.Column="2" Content="Reset" Click="ResetStoreApp_Click" Tag="{Binding}" Style="{StaticResource TextButton}" VerticalAlignment="Center" ToolTip="Put the app back to how it was when installed (its data is cleared)"/>
                  <Button Grid.Column="3" Content="End" Click="EndStoreApp_Click" Tag="{Binding}" Style="{StaticResource TextButton}" VerticalAlignment="Center" ToolTip="Close the app if it is running"/>
                  <Button Grid.Column="4" Content="Uninstall" Click="UninstallStoreApp_Click" Tag="{Binding}" Style="{StaticResource AccentOutlineButton}" Height="32" Padding="16,0" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding ActionName}"/>
                </Grid>
              </Grid>
              <DataTemplate.Triggers>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SoftAccentBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/></Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
            <!-- One browser extension (the same row): name and where it lives; its own Remove (Firefox family) or Remove in the browser (Chromium) button; a policy's
                 extension is locked. -->
            <DataTemplate x:Key="ExtensionTemplate">
              <Grid x:Name="RowRoot" Margin="0,2" Background="Transparent">
                <Border x:Name="Row" CornerRadius="12" Background="{DynamicResource RaisedBrush}" BorderBrush="Transparent" BorderThickness="1"/>
                <Grid Margin="14,10,12,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="38" Height="38" CornerRadius="10" Background="{Binding TileBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                  </StackPanel>
                  <Button x:Name="RemoveButton" Grid.Column="2" Content="{Binding ActionLabel}" Click="RemoveExtension_Click" Tag="{Binding}" Style="{StaticResource AccentOutlineButton}" Height="32" Padding="16,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding ActionName}"/>
                  <TextBlock x:Name="LockedNote" Grid.Column="2" Text="Locked by a policy" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Locked}" Value="True"><Setter TargetName="RemoveButton" Property="Visibility" Value="Collapsed"/><Setter TargetName="LockedNote" Property="Visibility" Value="Visible"/></DataTrigger>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SoftAccentBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/></Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
            <!-- One kept backup of removed leftovers: Restore or Delete. -->
            <DataTemplate x:Key="BackupTemplate">
              <Grid Margin="22,6,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Restore" Click="RestoreBackup_Click" Tag="{Binding}" Style="{StaticResource TextButton}" VerticalAlignment="Center" AutomationProperties.Name="{Binding RestoreName}"/>
                <Button Grid.Column="2" Content="Delete" Click="DeleteBackup_Click" Tag="{Binding}" Style="{StaticResource TextButton}" VerticalAlignment="Center" AutomationProperties.Name="{Binding DeleteName}"/>
              </Grid>
            </DataTemplate>
          </Grid.Resources>
          <!-- One screen (owner, November 21, 2026): like Settings, the title and a rail of every tool sit in a 196 DIP column at the left, Overview first, and the
               open entry fills the card beside it (its content scrolls inside). The window keeps its one 920 size. -->
          <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DockPanel Margin="0,10,0,0">
            <TextBlock x:Name="ToolsTitle" Text="Tools" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"/>
            <Button x:Name="ToolsBackButton" Content="Back" Style="{StaticResource BackButton}" Click="ToolsBack_Click" Visibility="Collapsed" DockPanel.Dock="Top" AutomationProperties.Name="Back from tools"/>
            <TextBlock x:Name="ToolsSubtitle" Text="Each tool reads your PC only when you open it." FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" DockPanel.Dock="Bottom"/>
            <ItemsControl x:Name="ToolTiles" Margin="0,16,0,0" VerticalAlignment="Top" Focusable="False" ItemsPanel="{StaticResource RailPanel}" ItemContainerStyle="{StaticResource IconTabContainer}" ItemTemplate="{StaticResource RailTemplate}"/>
          </DockPanel>
          <Border x:Name="ToolFocusCard" Grid.Column="2" Margin="0,12,0,0" CornerRadius="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1">
          <ScrollViewer x:Name="ToolsScroll" Style="{StaticResource PageScroll}" Padding="20,0,20,16">
            <StackPanel x:Name="ToolsSectionsPanel" Expander.Expanded="ToolSection_Expanded">
              <!-- The Overview (owner's pick B, November 21, 2026): a few things worth a look right now, from what is already known (nothing is read to fill it). -->
              <StackPanel x:Name="ToolsOverview" Margin="0,18,0,4">
                <TextBlock Text="Overview" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="Tools for your programs, updates, files and the registry. Pick one at the left, or start with these." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>
                <ItemsControl x:Name="ToolsSuggestions" Focusable="False" ItemTemplate="{StaticResource SuggestionTemplate}"/>
                <TextBlock Text="Everything else is in the list at the left." FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              </StackPanel>
              <!-- Programs: everything installed, its own uninstaller, then what it left behind (grouped, backed up first). -->
              <Expander x:Name="ToolsProgramsSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Programs" Expanded="Programs_Expanded" Collapsed="TopicCard_Collapsed">
                <Expander.Header>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Programs" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Every desktop program Windows lists as installed. Uninstall runs the program's own uninstaller first (Windows may ask for permission), then Hush looks for what it left behind: folders, registry settings, shortcuts and start-up entries. You see the list grouped by kind and choose what goes. Only clear matches are ticked for you. Everything is backed up before it is removed, so it can be restored below. Items for all users need administrator mode." AutomationProperties.Name="More about Programs"/></StackPanel>
                    <TextBlock x:Name="ProgramsSummary" Text="Open to see your installed programs" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,8">
                  <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <!-- Owner's pick: largest first, with a switch to name or date installed; the sort sits at the left in the top-bar pill (SortPill rule). -->
                    <Border Style="{StaticResource SortPill}">
                      <local:SegmentPanel x:Name="ProgramsSortBar" Orientation="Horizontal" ThumbBrush="{DynamicResource AccentSelectedBrush}" ThumbEdge="{DynamicResource AccentSelectedEdgeBrush}" ThumbRadius="16" AutomationProperties.Name="Sort programs by">
                        <Button x:Name="SortBySizeButton" Content="Size" Tag="size" Click="ProgramsSort_Click" Style="{StaticResource SegmentChoice}" local:Motion.MouseOnly="True" AutomationProperties.Name="Sort programs by size"/>
                        <Button x:Name="SortByNameButton" Content="Name" Tag="name" Click="ProgramsSort_Click" Style="{StaticResource SegmentChoice}" local:Motion.MouseOnly="True" AutomationProperties.Name="Sort programs by name"/>
                        <Button x:Name="SortByDateButton" Content="Date installed" Tag="date" Click="ProgramsSort_Click" Style="{StaticResource SegmentChoice}" local:Motion.MouseOnly="True" AutomationProperties.Name="Sort programs by the date they were installed"/>
                      </local:SegmentPanel>
                    </Border>
                    <TextBox x:Name="ProgramsSearch" Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource SearchBox}" Tag="Find a program…" TextChanged="ProgramsSearch_Changed" AutomationProperties.Name="Find a program"/>
                  </Grid>
                  <local:WaitSteps x:Name="ProgramsWait" Margin="0,4,0,8"/>
                  <ItemsControl x:Name="ProgramsList" ItemTemplate="{StaticResource ProgramTemplate}"/>
                  <TextBlock x:Name="ProgramsEmpty" Text="No program matches." Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                  <TextBlock x:Name="ProgramsStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                  <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="RefreshProgramsButton" Content="Refresh" Click="RefreshPrograms_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Margin="-14,0,0,0" AutomationProperties.Name="Read the installed programs again"/>
                    <Button x:Name="UninstallSelectedButton" Grid.Column="2" Content="Uninstall selected" Click="UninstallSelected_Click" Style="{StaticResource AccentOutlineButton}" Padding="18,9" IsEnabled="False" AutomationProperties.Name="Uninstall the ticked programs one after another"/>
                  </Grid>
                  <!-- Kept backups of removed leftovers (closed at first). -->
                  <StackPanel x:Name="BackupsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <ToggleButton x:Name="BackupsToggle" Style="{StaticResource TopicHeader}">
                      <TextBlock FontSize="{DynamicResource CompactFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"><Run Text="Removed leftovers you can restore"/><Run x:Name="BackupsCount" Foreground="{DynamicResource FaintBrush}" FontWeight="Normal"/></TextBlock>
                    </ToggleButton>
                    <local:AccordionBody Expanded="{Binding IsChecked, ElementName=BackupsToggle}" IsEnabled="{Binding Expanded, RelativeSource={RelativeSource Self}}">
                      <ItemsControl x:Name="BackupsList" ItemTemplate="{StaticResource BackupTemplate}"/>
                    </local:AccordionBody>
                  </StackPanel>
                </StackPanel>
              </Expander>
              <!-- Store apps: this account's Store apps (never the ones Windows needs). -->
              <Expander x:Name="ToolsStoreSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Store apps" Expanded="StoreApps_Expanded" Collapsed="TopicCard_Collapsed">
                <Expander.Header>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Store apps" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Apps from the Microsoft Store installed for your account. Uninstall removes one for your account. Reset puts it back to how it was when you installed it, which clears its data (the same as Settings > Apps > Advanced options > Reset). End closes it if it is running. Apps that are part of Windows are never listed. Each one asks first." AutomationProperties.Name="More about Store apps"/></StackPanel>
                    <TextBlock x:Name="StoreAppsSummary" Text="Open to see your Store apps" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,8">
                  <local:WaitSteps x:Name="StoreWait" Margin="0,4,0,8"/>
                  <ItemsControl x:Name="StoreAppsList" AlternationCount="2000" ItemTemplate="{StaticResource StoreAppTemplate}"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
                  <TextBlock x:Name="StoreAppsStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                  <Button x:Name="RefreshStoreAppsButton" Content="Refresh" Click="RefreshStoreApps_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" HorizontalAlignment="Left" Margin="-14,12,0,0" AutomationProperties.Name="Read the Store apps again"/>
                </StackPanel>
              </Expander>
              <!-- Browser extensions: per browser and profile. -->
              <Expander x:Name="ToolsExtensionsSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Browser extensions" Expanded="Extensions_Expanded" Collapsed="TopicCard_Collapsed">
                <Expander.Header>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Browser extensions" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="The extensions in each browser and profile on this PC. For Firefox and browsers built like it, Hush removes the extension itself while the browser is closed (its file is backed up first). Chrome, Edge, Brave, Vivaldi and Opera protect their extension settings, so a file removed behind their back can come back: for those Hush opens the browser's own Extensions page at that extension, where one click removes it for good. If you sync your browser, a removed extension may come back from your account; turn off extension sync first. Extensions a policy installed are locked." AutomationProperties.Name="More about Browser extensions"/></StackPanel>
                    <TextBlock x:Name="ExtensionsSummary" Text="Open to see your browser extensions" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,8">
                  <!-- One icon tab per browser that has extensions (owner, November 20, 2026: the Software Updates layout); the badge counts its extensions. -->
                  <Border x:Name="ExtensionTabsBar" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,8" Visibility="Collapsed">
                    <ItemsControl x:Name="ExtensionBrowserTabs" Focusable="False" ItemsPanel="{StaticResource IconTabsPanel}" ItemContainerStyle="{StaticResource IconTabContainer}" ItemTemplate="{StaticResource IconTabTemplate}"/>
                  </Border>
                  <local:WaitSteps x:Name="ExtensionsWait" Margin="0,4,0,8"/>
                  <ItemsControl x:Name="ExtensionsList" AlternationCount="2000" ItemTemplate="{StaticResource ExtensionTemplate}"><ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle></ItemsControl>
                  <TextBlock x:Name="ExtensionsStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                  <Button x:Name="RefreshExtensionsButton" Content="Refresh" Click="RefreshExtensions_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" HorizontalAlignment="Left" Margin="-14,12,0,0" AutomationProperties.Name="Read the browser extensions again"/>
                </StackPanel>
              </Expander>
              <!-- Software updates (owner, November 20, 2026): a tab bar like Tweaks: Programs (Windows' app installer) and one tab per device type with driver
                   updates from Windows Update (a device tab shows only while it holds one); the summary line says what is new; Hush installs what you tick. -->
              <Expander x:Name="ToolsUpdatesSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Software Updates" Expanded="Updates_Expanded" Collapsed="TopicCard_Collapsed">
                <Expander.Header>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Software Updates" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Hush asks Windows which of your programs and device drivers have a newer version. Programs come from each publisher's official source through Windows' own app installer; drivers come from Windows Update for the devices in this PC (graphics, Bluetooth, audio, network and the rest). Each line shows the version you have and the new one. Tick what you want and press Update: programs update one by one, quietly; drivers need administrator mode and Windows may ask for a restart. The publisher's license is accepted for you. Nothing updates unless you press Update." AutomationProperties.Name="More about Software Updates"/></StackPanel>
                    <TextBlock x:Name="UpdatesSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"><Run x:Name="UpdatesHeadline" Text="Open to look for newer versions of your apps"/><Run x:Name="UpdatesDetail"/></TextBlock>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,8">
                  <!-- The tabs (owner's pick, option C, November 20, 2026): each with the icon of what it holds and a count badge that turns accent while something
                       waits; a tab for a device type appears only while that device has an update; the underline springs to the one you pick. -->
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                    <ItemsControl x:Name="UpdateTabsList" Focusable="False" ItemsPanel="{StaticResource IconTabsPanel}" ItemContainerStyle="{StaticResource IconTabContainer}" ItemTemplate="{StaticResource IconTabTemplate}"/>
                  </Border>
                  <local:WaitSteps x:Name="UpdatesWait" Margin="0,2,0,10"/>
                  <!-- The list's top row (owner, November 20, 2026): the sort pill at the left (Programs only: "by kind of program, in a switch like Size | Name"),
                       Select all and Update selected at the right, level with it, so the bulk action is always in view above the list. -->
                  <Grid x:Name="UpdatesActionBar" Margin="0,2,0,6" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="UpdatesSortBar" Style="{StaticResource SortPill}" Visibility="Collapsed">
                      <local:SegmentPanel Orientation="Horizontal" ThumbBrush="{DynamicResource AccentSelectedBrush}" ThumbEdge="{DynamicResource AccentSelectedEdgeBrush}" ThumbRadius="16" AutomationProperties.Name="Sort the program updates by">
                        <Button x:Name="UpdatesSortKindButton" Content="Kind" Tag="kind" Click="UpdatesSort_Click" Style="{StaticResource SegmentChoice}" local:Motion.MouseOnly="True" AutomationProperties.Name="Group the program updates by kind of program"/>
                        <Button x:Name="UpdatesSortSizeButton" Content="Size" Tag="size" Click="UpdatesSort_Click" Style="{StaticResource SegmentChoice}" local:Motion.MouseOnly="True" AutomationProperties.Name="Sort the program updates by the room each program takes"/>
                        <Button x:Name="UpdatesSortNameButton" Content="Name" Tag="name" Click="UpdatesSort_Click" Style="{StaticResource SegmentChoice}" local:Motion.MouseOnly="True" AutomationProperties.Name="Sort the program updates by name"/>
                      </local:SegmentPanel>
                    </Border>
                    <Button x:Name="SelectAllUpdatesButton" Grid.Column="2" Content="Select all" Click="SelectAllUpdates_Click" Style="{StaticResource AccentTextButton}" local:Motion.MouseOnly="True" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" AutomationProperties.Name="Tick or clear every update on this tab"/>
                    <Button x:Name="UpdateSelectedButton" Grid.Column="3" Content="Update selected" Click="UpdateSelected_Click" Style="{StaticResource AccentOutlineButton}" Height="38" Padding="18,0" VerticalAlignment="Center" IsEnabled="False"/>
                  </Grid>
                  <TextBlock x:Name="UpdatesEmpty" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,4"/>
                  <ItemsControl x:Name="UpdatesList" AlternationCount="2000">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <!-- One update that waits: a soft accent fill and edge, its icon (a device icon for a driver, a colored letter for a program), the version change, a
                           New chip on the right and its own Update button. -->
                      <Grid Margin="0,2">
                        <Border CornerRadius="12" Background="{DynamicResource SoftAccentBrush}" Visibility="{Binding WaitingVisibility}"/>
                        <Border Width="3" CornerRadius="2" Margin="0,10" Background="{DynamicResource TealTextBrush}" HorizontalAlignment="Left" Visibility="{Binding WaitingVisibility}"/>
                        <!-- While it downloads and installs (owner, November 20, 2026): a thin bar along the bottom of the row that eases toward full and completes only
                             when the update is really done (EasedProgress); an empty track while it waits its turn. -->
                        <Border x:Name="UpdateProgress" Height="3" CornerRadius="1.5" Margin="96,0,16,5" VerticalAlignment="Bottom" Background="{DynamicResource GlassEdgeBrush}" Visibility="Collapsed"
                                local:EasedProgress.ExpectedSeconds="{Binding ExpectedSeconds}" local:EasedProgress.State="{Binding FillState}">
                          <Border CornerRadius="1.5" Background="{DynamicResource TealTextBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="1"/></Border.RenderTransform></Border>
                        </Border>
                        <Grid Margin="14,10,12,10">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="True" Visibility="{Binding UpdateVisibility}" VerticalAlignment="Center" AutomationProperties.Name="{Binding SelectName}"/>
                          <Grid Grid.Column="1" Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border x:Name="LetterTile" CornerRadius="10" Background="{Binding TileBrush}"><TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <Image x:Name="OwnIcon" Source="{Binding ProgramIcon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                            <Border x:Name="DeviceTile" CornerRadius="10" Background="{DynamicResource AccentSelectedBrush}" BorderBrush="{DynamicResource AccentSelectedEdgeBrush}" BorderThickness="1" Visibility="Collapsed">
                              <local:GlyphIcon Data="{Binding Icon}" Stroke="{DynamicResource TealTextBrush}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                          </Grid>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Detail}"/>
                          </StackPanel>
                          <Border Grid.Column="3" CornerRadius="11" Height="22" Padding="9,0" Background="{DynamicResource AccentSelectedBrush}" BorderBrush="{DynamicResource AccentSelectedEdgeBrush}" BorderThickness="1" VerticalAlignment="Center" Visibility="{Binding NewVisibility}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Ellipse Width="6" Height="6" Fill="{DynamicResource TealTextBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="New" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TealTextBrush}" Margin="6,0,0,1" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Border>
                          <TextBlock Grid.Column="3" Text="Updated" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" Visibility="{Binding DoneVisibility}"/>
                          <Button Grid.Column="4" Content="Update" Click="UpdateRow_Click" Tag="{Binding}" Style="{StaticResource AccentOutlineButton}" Height="32" Padding="16,0" Margin="12,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding CanUpdate}" Visibility="{Binding UpdateVisibility}" AutomationProperties.Name="{Binding UpdateName}"/>
                        </Grid>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasProgramIcon}" Value="True"><Setter TargetName="LetterTile" Property="Visibility" Value="Collapsed"/><Setter TargetName="OwnIcon" Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsDriver}" Value="True"><Setter TargetName="LetterTile" Property="Visibility" Value="Collapsed"/><Setter TargetName="DeviceTile" Property="Visibility" Value="Visible"/></DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate></ItemsControl.ItemTemplate>
                    <!-- Kind view: a plain heading with the kind's icon and count (not collapsible: these are short lists). -->
                    <ItemsControl.GroupStyle>
                      <GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,14,0,4">
                          <local:GlyphIcon Data="{Binding Name, Converter={StaticResource KindIcon}}" Stroke="{DynamicResource MutedBrush}" Width="16" Height="16" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding ItemCount}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TealTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle>
                    </ItemsControl.GroupStyle>
                  </ItemsControl>
                  <TextBlock x:Name="UpdatesStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"/>
                  <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="RefreshUpdatesButton" Content="Check again" Click="RefreshUpdates_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Margin="-14,0,0,0"/>
                    <Button x:Name="UpdatesStopButton" Grid.Column="1" Content="Stop" Click="UpdatesStop_Click" Style="{StaticResource TextButton}" Visibility="Collapsed"/>
                    <Button x:Name="DriversUpdateOnButton" Grid.Column="2" Content="Turn Windows Update back on" Click="DriversUpdateOn_Click" Style="{StaticResource AccentTextButton}" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="Turn Windows Update back on to check drivers"/>
                  </Grid>
                </StackPanel>
              </Expander>
              <!-- Device repair, Bluetooth first (owner, November 20, 2026; owner's pick B: guided steps). Opening it runs the read-only check; the steps run one
                   after another, gentlest first, each asking first, and the check runs again after each. -->
              <Expander x:Name="ToolsRepairSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Device repair" Expanded="Repair_Expanded" Collapsed="TopicCard_Collapsed">
                <Expander.Header>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Device repair" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Fixes Bluetooth that stopped working. Hush first checks, without changing anything: is the adapter there and working, which driver it has, are Bluetooth's services on (including any Hush itself turned off earlier), and which old devices are left over. Then it offers the fixes one at a time, gentlest first, and checks again after each: a quick repair (services back on, adapter restarted), reinstalling the driver, removing old devices you choose, and as a last resort a force clean for devices Windows refuses to remove (their pairing is backed up first). Every fix asks first and needs administrator mode." AutomationProperties.Name="More about Device repair"/></StackPanel>
                    <TextBlock x:Name="RepairSummary" Text="Open to check Bluetooth" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,8">
                  <ItemsControl x:Name="RepairStepsList" Focusable="False">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,2">
                        <Border x:Name="Row" CornerRadius="12" Background="{DynamicResource RaisedBrush}" BorderBrush="Transparent" BorderThickness="1"/>
                        <Grid Margin="14,11,14,11">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Grid Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse x:Name="NumberDisc" Fill="{DynamicResource AccentSelectedBrush}"/>
                            <TextBlock x:Name="NumberText" Text="{Binding NumberText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TealTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Grid>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="StepTitle" Text="{Binding Title}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                            <TextBlock Text="{Binding Line}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <Border Height="3" CornerRadius="1.5" Margin="0,8,0,0" Background="{DynamicResource GlassEdgeBrush}" Visibility="Collapsed" local:EasedProgress.ExpectedSeconds="30" local:EasedProgress.State="{Binding FillState}">
                              <Border CornerRadius="1.5" Background="{DynamicResource TealTextBrush}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="1"/></Border.RenderTransform></Border>
                            </Border>
                          </StackPanel>
                          <Grid Grid.Column="2" Height="24" VerticalAlignment="Center" Visibility="{Binding ChipVisible}">
                            <Border x:Name="ChipFill" CornerRadius="12" Background="{DynamicResource MutedBrush}" Opacity="0.14"/>
                            <TextBlock x:Name="ChipText" Text="{Binding Chip}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="10,0,10,1" VerticalAlignment="Center"/>
                          </Grid>
                        </Grid>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SoftAccentBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/>
                          <Setter TargetName="ChipFill" Property="Background" Value="{DynamicResource TealTextBrush}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TealTextBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="done"><Setter TargetName="NumberDisc" Property="Fill" Value="{DynamicResource GoodBrush}"/><Setter TargetName="NumberDisc" Property="Opacity" Value="0.2"/><Setter TargetName="NumberText" Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                          <Setter TargetName="ChipFill" Property="Background" Value="{DynamicResource GoodBrush}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource GoodBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="failed"><Setter TargetName="ChipFill" Property="Background" Value="{DynamicResource MeterWarnBrush}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource MeterWarnBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="notneeded"><Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Risky}" Value="True"/><Condition Binding="{Binding IsCurrent}" Value="True"/></MultiDataTrigger.Conditions>
                          <Setter TargetName="ChipFill" Property="Background" Value="{DynamicResource CleanTextBrush}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource CleanTextBrush}"/></MultiDataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Old devices (steps 4 and 5): the person ticks which; nothing is ticked for them. -->
                  <StackPanel x:Name="RepairDevicesPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="OLD BLUETOOTH DEVICES" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                    <ItemsControl x:Name="RepairDevicesList" Margin="0,6,0,0">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,2">
                          <Border CornerRadius="12" Background="{DynamicResource RaisedBrush}"/>
                          <Grid Margin="14,9,14,9"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock x:Name="RepairStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"/>
                  <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="RepairCheckButton" Content="Check again" Click="RepairCheckAgain_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Margin="-14,0,0,0" AutomationProperties.Name="Check Bluetooth again"/>
                    <Button x:Name="RepairSkipButton" Grid.Column="2" Content="Skip this step" Click="RepairSkip_Click" Style="{StaticResource TextButton}" local:Motion.MouseOnly="True" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button x:Name="RepairContinueButton" Grid.Column="3" Content="Continue" Click="RepairContinue_Click" Style="{StaticResource AccentOutlineButton}" Height="38" Padding="20,0" Visibility="Collapsed"/>
                  </Grid>
                </StackPanel>
              </Expander>
              <!-- Duplicate and large files: nothing ticked for you, never every copy, to the Recycle Bin. -->
              <Expander x:Name="ToolsDuplicatesSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Duplicate and large files" Expanded="Duplicates_Expanded" Collapsed="TopicCard_Collapsed">
                <Expander.Header>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Duplicate and large files" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Finds files that are exact copies of each other (the same content, checked byte for byte through a fingerprint, not just the same name) and the largest files in the folders you choose. Nothing is ticked for you, and Hush never lets you tick every copy of a file. What you remove goes to the Recycle Bin, so you can get it back. Windows, Program Files and ProgramData are skipped unless you choose them yourself." AutomationProperties.Name="More about Duplicate and large files"/></StackPanel>
                    <TextBlock x:Name="DuplicatesSummary" Text="Choose folders to look in" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,8">
                  <!-- The friendly start (owner, November 20, 2026, mockup 5A): what it does, the usual places as one-click chips, one button. -->
                  <StackPanel HorizontalAlignment="Center" Margin="0,4,0,4">
                    <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource SoftAccentBrush}" BorderBrush="{DynamicResource AccentSelectedEdgeBrush}" BorderThickness="1" HorizontalAlignment="Center">
                      <Path Data="M8 6 H17 A1.5 1.5 0 0 1 18.5 7.5 V19 A1.5 1.5 0 0 1 17 20.5 H8 A1.5 1.5 0 0 1 6.5 19 V7.5 A1.5 1.5 0 0 1 8 6 Z M4 16 V4.5 A1 1 0 0 1 5 3.5 H14" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Find copies and big files" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Pick where to look. Nothing is removed unless you choose, and it goes to the Recycle Bin." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" Margin="0,4,0,0"/>
                  </StackPanel>
                  <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                    <ItemsControl x:Name="DuplicateFoldersList" Focusable="False">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <ToggleButton IsChecked="{Binding Checked, Mode=TwoWay}" Margin="4" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
                          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Pill" CornerRadius="16" Padding="13,7" Background="{DynamicResource RaisedBrush}" BorderBrush="Transparent" BorderThickness="1">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Tick" Text="✓ " FontWeight="Bold" Foreground="{DynamicResource TealTextBrush}" Visibility="Collapsed"/>
                                <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}"/>
                              </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSelectedBrush}"/><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource HeadingBrush}"/></Trigger>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/></Trigger>
                              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource TealTextBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="DuplicateAddFolderButton" Content="+ Other folder…" Click="DuplicateAddFolder_Click" Style="{StaticResource TextButton}" Margin="4" VerticalAlignment="Center" AutomationProperties.Name="Add another folder to look in"/>
                  </WrapPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,4">
                    <Button x:Name="DuplicateSearchButton" Content="Choose a place first" Click="DuplicateSearch_Click" Style="{StaticResource AccentOutlineButton}" Height="38" Padding="22,0" IsEnabled="False"/>
                    <Button x:Name="DuplicateStopButton" Content="Stop" Click="DuplicateStop_Click" Style="{StaticResource TextButton}" Margin="8,0,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                  <local:WaitSteps x:Name="DuplicatesWait" Margin="0,12,0,0"/>
                  <!-- Results: a summary first, then the copies and big files. -->
                  <UniformGrid x:Name="DuplicateSummaryTiles" Columns="3" Margin="-4,14,-4,0" Visibility="Collapsed">
                    <Border CornerRadius="12" Background="{DynamicResource RaisedBrush}" Margin="4" Padding="14,10"><StackPanel><TextBlock x:Name="DuplicateCopiesValue" FontSize="22" FontWeight="Light" Foreground="{DynamicResource HeadingBrush}"/><TextBlock x:Name="DuplicateCopiesLabel" FontSize="13" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                    <Border CornerRadius="12" Background="{DynamicResource RaisedBrush}" Margin="4" Padding="14,10"><StackPanel><TextBlock x:Name="DuplicateLargeValue" FontSize="22" FontWeight="Light" Foreground="{DynamicResource HeadingBrush}"/><TextBlock x:Name="DuplicateLargeLabel" FontSize="13" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                    <Border CornerRadius="12" Background="{DynamicResource SoftAccentBrush}" Margin="4" Padding="14,10"><StackPanel><TextBlock x:Name="DuplicateFreeValue" FontSize="22" FontWeight="Light" Foreground="{DynamicResource TealTextBrush}"/><TextBlock x:Name="DuplicateFreeLabel" FontSize="13" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                  </UniformGrid>
                  <TextBlock x:Name="DuplicatesEmptyResult" Text="No copies or big files found in those places." Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                  <ItemsControl x:Name="DuplicateResultsList" AlternationCount="4000" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="True" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="{Binding Name}"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding File.Path}"/>
                          <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                    <ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle>
                  </ItemsControl>
                  <TextBlock x:Name="DuplicatesStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"/>
                  <Button x:Name="DuplicateRecycleButton" Content="Move to Recycle Bin" Click="DuplicateRecycle_Click" Style="{StaticResource DangerButton}" Padding="22,9" HorizontalAlignment="Right" Margin="0,12,0,0" IsEnabled="False" Visibility="Collapsed"/>
                </StackPanel>
              </Expander>
              <!-- Registry (owner, November 19, 2026): full backups (made before each registry clean, on by default) and a search that can delete what it finds. -->
              <Expander x:Name="ToolsRegistrySection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Registry" Expanded="RegistryCard_Expanded" Collapsed="TopicCard_Collapsed">
                <Expander.Header>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Registry" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Full backups: a copy of this account's whole registry (and, in administrator mode, the all-users software part), made by Windows' own export. Hush makes one before each registry clean unless you turn that off, and keeps the newest five. Restoring puts the saved values back; keys created since then stay, and a restart is best afterwards. Search: finds a word in key names, value names and text values. You choose what to delete; each one is exported first. Places Windows needs are shown but can never be deleted, and all-users ones need administrator mode." AutomationProperties.Name="More about Registry"/></StackPanel>
                    <TextBlock x:Name="RegistrySummary" Text="Full backups and search" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,8">
                  <TextBlock Text="Full backups" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                  <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="RegistryAutoBackupSwitch" Style="{StaticResource SwitchCheckBox}" IsEnabled="True" Click="RegistryAutoBackup_Click" VerticalAlignment="Center" AutomationProperties.Name="Back up the whole registry before each registry clean"/>
                    <TextBlock Grid.Column="2" Text="Back up the whole registry before each registry clean" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="RegistryBackupNowButton" Grid.Column="3" Content="Back up now" Click="RegistryBackupNow_Click" Style="{StaticResource AccentOutlineButton}" Padding="18,9" Margin="12,0,0,0"/>
                  </Grid>
                  <ItemsControl x:Name="RegistryBackupsList" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Restore" Click="RegistryRestore_Click" Tag="{Binding}" Style="{StaticResource TextButton}" VerticalAlignment="Center" AutomationProperties.Name="{Binding RestoreName}"/>
                        <Button Grid.Column="2" Content="Delete" Click="RegistryBackupDelete_Click" Tag="{Binding}" Style="{StaticResource TextButton}" VerticalAlignment="Center" AutomationProperties.Name="{Binding DeleteName}"/>
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="RegistryBackupStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"/>
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7" Margin="0,16,0,12"/>
                  <TextBlock Text="Search" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                  <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="RegistrySearchBox" Style="{StaticResource SearchBox}" Tag="Find a word in the registry (at least 3 letters)…" KeyDown="RegistrySearchBox_KeyDown" AutomationProperties.Name="Find a word in the registry"/>
                    <Button x:Name="RegistrySearchButton" Grid.Column="1" Content="Search" Click="RegistrySearch_Click" Style="{StaticResource AccentOutlineButton}" Padding="18,9" Margin="12,0,0,0"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="RegistrySearchKeys" Content="Key names" IsChecked="True" IsEnabled="True" Margin="0,0,20,0"/>
                    <CheckBox x:Name="RegistrySearchValues" Content="Value names" IsChecked="True" IsEnabled="True" Margin="0,0,20,0"/>
                    <CheckBox x:Name="RegistrySearchData" Content="Text values" IsChecked="True" IsEnabled="True"/>
                  </StackPanel>
                  <ItemsControl x:Name="RegistryFindsList" AlternationCount="4000" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="{Binding Name}"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                          <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Detail}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                    <ItemsControl.GroupStyle><StaticResource ResourceKey="AdjustmentGroups"/></ItemsControl.GroupStyle>
                  </ItemsControl>
                  <TextBlock x:Name="RegistrySearchStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"/>
                  <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="RegistrySearchStopButton" Content="Stop" Click="RegistrySearchStop_Click" Style="{StaticResource TextButton}" Margin="-14,0,0,0" Visibility="Collapsed"/>
                    <Button x:Name="RegistryDeleteButton" Grid.Column="2" Content="Delete selected" Click="RegistryDelete_Click" Style="{StaticResource DangerButton}" Padding="22,9" IsEnabled="False" Visibility="Collapsed" AutomationProperties.Name="Delete the ticked registry entries"/>
                  </Grid>
                </StackPanel>
              </Expander>
              <!-- Disk check (owner, November 19, 2026): a read-only check, a repair only at the next restart when problems were found, and the drives' own health. -->
              <Expander x:Name="ToolsDiskSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Disk check" Expanded="Disk_Expanded" Collapsed="TopicCard_Collapsed">
                <Expander.Header>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Disk check" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Check runs Windows' own disk check in read-only mode: it looks for file system errors and changes nothing. If it finds any, you can let Windows repair the drive the next time the PC starts, before anything uses it. Health is what each drive reports about itself to Windows. Checking needs administrator mode." AutomationProperties.Name="More about Disk check"/></StackPanel>
                    <TextBlock x:Name="DiskSummary" Text="Check your drives for errors" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,8">
                  <!-- Owner, November 20, 2026 (mockup 4A): health first in friendly words with a chip, then one card per drive; the waiting steps while it reads. -->
                  <local:WaitSteps x:Name="DiskWait" Margin="0,0,0,10"/>
                  <Grid x:Name="DiskHealthRow" Visibility="Collapsed" Margin="0,0,0,10">
                    <Border CornerRadius="12" Background="{DynamicResource RaisedBrush}"/>
                    <Grid Margin="14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="DiskHealthText" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      <Grid Grid.Column="1" Height="24" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border x:Name="DiskHealthChipFill" CornerRadius="12" Background="{DynamicResource GoodBrush}" Opacity="0.14"/>
                        <TextBlock x:Name="DiskHealthChip" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" Margin="10,0,10,1" VerticalAlignment="Center"/>
                      </Grid>
                    </Grid>
                  </Grid>
                  <ItemsControl x:Name="DiskDrivesList" Margin="-5,0,-5,0" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="5">
                        <Border x:Name="Card" CornerRadius="14" Background="{DynamicResource RaisedBrush}" BorderBrush="Transparent" BorderThickness="1"/>
                        <StackPanel Margin="16,16,16,14">
                          <Grid Width="96" Height="96" HorizontalAlignment="Center">
                            <Viewbox><Grid Width="158" Height="158">
                              <Ellipse Margin="16" Stroke="{DynamicResource GlassEdgeBrush}" StrokeThickness="12"/>
                              <Path Data="{Binding UsedRing}" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid></Viewbox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                              <TextBlock Text="{Binding UsedText}" FontSize="20" FontWeight="Light" Foreground="{DynamicResource HeadingBrush}" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                              <TextBlock Text="used" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            </StackPanel>
                          </Grid>
                          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                          <TextBlock Text="{Binding FreeText}" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                          <Grid x:Name="Chip" Height="24" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="{Binding ChipVisible}">
                            <Border x:Name="ChipFill" CornerRadius="12" Background="{DynamicResource TealTextBrush}" Opacity="0.14"/>
                            <TextBlock x:Name="ChipText" Text="{Binding Chip}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TealTextBrush}" Margin="10,0,10,1" VerticalAlignment="Center"/>
                          </Grid>
                          <TextBlock Text="{Binding Line}" Visibility="{Binding LineVisible}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                          <Border Height="3" CornerRadius="1.5" Margin="8,10,8,0" Background="{DynamicResource GlassEdgeBrush}" Visibility="Collapsed" local:EasedProgress.ExpectedSeconds="120" local:EasedProgress.State="{Binding FillState}">
                            <Border CornerRadius="1.5" Background="{DynamicResource TealTextBrush}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="1"/></Border.RenderTransform></Border>
                          </Border>
                          <Button Content="Check" Click="DiskCheck_Click" Tag="{Binding}" IsEnabled="{Binding CanCheck}" Style="{StaticResource AccentOutlineButton}" Height="32" Padding="22,0" HorizontalAlignment="Center" Margin="0,12,0,0" AutomationProperties.Name="{Binding CheckName}"/>
                        </StackPanel>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="good"><Setter TargetName="ChipFill" Property="Background" Value="{DynamicResource GoodBrush}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource GoodBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="problems"><Setter TargetName="ChipFill" Property="Background" Value="{DynamicResource MeterWarnBrush}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource MeterWarnBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource MeterWarnBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="failed"><Setter TargetName="ChipFill" Property="Background" Value="{DynamicResource MutedBrush}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="checking"><Setter TargetName="Card" Property="Background" Value="{DynamicResource SoftAccentBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentSelectedEdgeBrush}"/></DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="DiskStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"/>
                  <Button x:Name="DiskRepairButton" Content="Repair at next restart" Click="DiskRepair_Click" Style="{StaticResource AccentOutlineButton}" Padding="18,9" HorizontalAlignment="Right" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Expander>
              <!-- Registry size (owner's choice: measure only; the registry files are never swapped). -->
              <Expander x:Name="ToolsRegistrySizeSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Registry size" Collapsed="TopicCard_Collapsed">
                <Expander.Header>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Registry size" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Over time the registry files keep empty space inside them. Measure saves a fresh, tightly packed copy of each part with Windows' own tool, compares its size with the file in use and deletes the copy again. Hush only tells you the result: swapping the registry files is risky and the gain is small, so Hush does not do it. Measuring needs administrator mode." AutomationProperties.Name="More about Registry size"/></StackPanel>
                    <TextBlock x:Name="RegistrySizeSummary" Text="See how much space the registry could save" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,8">
                  <!-- The friendly start (owner, November 20, 2026, mockup 5A): what it does in one line and one centered button; the waiting steps while it measures. -->
                  <StackPanel HorizontalAlignment="Center" Margin="0,4,0,4">
                    <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource SoftAccentBrush}" BorderBrush="{DynamicResource AccentSelectedEdgeBrush}" BorderThickness="1" HorizontalAlignment="Center">
                      <Path Data="M5 20 V10 M10 20 V4 M15 20 V13 M20 20 V7" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="How much room does the registry take?" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Hush packs a copy to compare with the real files. Nothing is changed." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" Margin="0,4,0,0"/>
                    <Button x:Name="RegistryMeasureButton" Content="Measure" Click="RegistryMeasure_Click" Style="{StaticResource AccentOutlineButton}" Height="38" Padding="26,0" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                  </StackPanel>
                  <local:WaitSteps x:Name="RegistryWait" Margin="0,12,0,0"/>
                  <Border x:Name="RegistrySizeBox" CornerRadius="12" Background="{DynamicResource RaisedBrush}" Padding="14,10" Margin="0,12,0,0" Visibility="{Binding Visibility, ElementName=RegistrySizeText}">
                    <TextBlock x:Name="RegistrySizeText" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Visibility="Collapsed"/>
                  </Border>
                </StackPanel>
              </Expander>
              <!-- Shredder: overwrite chosen files before deleting them, and wipe a drive's free space. -->
              <Expander x:Name="ToolsShredderSection" Style="{StaticResource ToolSection}" AutomationProperties.Name="Shredder" Expanded="Shredder_Expanded" Collapsed="TopicCard_Collapsed">
                <Expander.Header>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Shredder" Style="{StaticResource CardTitle}"/><local:HelpMark Style="{StaticResource HelpMark}" HelpText="Shred overwrites every byte of the files you choose with random data and then deletes them, so ordinary recovery tools find nothing. Wipe free space fills a drive's free space with zeros for a moment and deletes that again, which overwrites the remains of files you deleted earlier. On a hard disk one pass is enough. On SSDs and USB sticks the drive itself moves data around, so no program can promise that every old copy is overwritten. Shredding cannot be undone: there is no backup and no Recycle Bin." AutomationProperties.Name="More about Shredder"/></StackPanel>
                    <TextBlock x:Name="ShredderSummary" Text="Delete files so they cannot be recovered" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,6,0,8">
                  <StackPanel HorizontalAlignment="Center" Margin="0,4,0,4">
                    <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource SoftAccentBrush}" BorderBrush="{DynamicResource AccentSelectedEdgeBrush}" BorderThickness="1" HorizontalAlignment="Center">
                      <Path Data="M7 3.5 H14.5 L18 7 V12.5 H7 Z M8.5 15.5 V20.5 M12.5 15.5 V20.5 M16.5 15.5 V20.5" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Delete files for good" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Add what to shred: it is overwritten, then deleted, so it cannot be brought back. Windows, Program Files and your profile's own top folders are never shredded." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" Margin="0,4,0,0"/>
                  </StackPanel>
                  <ItemsControl x:Name="ShredList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Remove" Click="ShredRemove_Click" Tag="{Binding}" Style="{StaticResource TextButton}" AutomationProperties.Name="Take it off the list"/>
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="ShredAddFilesButton" Content="Add files…" Click="ShredAddFiles_Click" Style="{StaticResource AccentOutlineButton}" Height="36" Padding="18,0"/>
                    <Button x:Name="ShredAddFolderButton" Content="Add a folder…" Click="ShredAddFolder_Click" Style="{StaticResource AccentOutlineButton}" Height="36" Padding="18,0" Margin="10,0,0,0"/>
                    <Button x:Name="ShredButton" Content="Shred" Click="Shred_Click" Style="{StaticResource DangerButton}" Height="36" Padding="22,0" Margin="10,0,0,0" IsEnabled="False" AutomationProperties.Name="Shred the files on the list"/>
                  </StackPanel>
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7" Margin="0,16,0,12"/>
                  <TextBlock Text="Wipe free space" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                  <TextBlock Text="Overwrites the remains of files deleted earlier. It can take a long time on a big drive, and the drive is full for a moment while it runs." FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,8"/>
                  <ItemsControl x:Name="WipeDrivesList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Wipe" Click="WipeDrive_Click" Tag="{Binding}" Style="{StaticResource TextButton}" AutomationProperties.Name="{Binding ActionName}"/>
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="ShredStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                  <Button x:Name="ShredCancelButton" Content="Stop" Click="ShredCancel_Click" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-14,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
      </Grid>
      <Border x:Name="ModalOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed">
        <!-- The Clean confirmation. Simple mode shows only the title (what will be freed), one calm line and the two buttons; Pro mode adds the breakdown by group and category and
             the short list of what will happen (see ShowConfirmation). Left edges line up on one 34 DIP margin, the amounts share one right edge. -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Style="{StaticResource PopupShadowPlate}"><Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.4" Color="#000000"/></Border.Effect></Border>
        <Border x:Name="ConfirmCard" Style="{StaticResource PopupCard}" Width="520">
          <StackPanel>
            <TextBlock x:Name="ConfirmTitle" Text="Are you sure?" Style="{StaticResource PopupTitle}"/>
            <TextBlock x:Name="ConfirmSummary" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource SupportFontSize}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22"/>
            <TextBlock x:Name="ConfirmHomeNote" Visibility="Collapsed" Text="Cleans only the green, recommended items. Use Take a look to choose more." FontSize="{DynamicResource CompactFontSize}" Foreground="{DynamicResource GoodBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0"/>
            <ScrollViewer x:Name="ConfirmScroll" MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
              <StackPanel Margin="0,0,8,0">
                <Border Background="{DynamicResource RaisedBrush}" CornerRadius="14" Padding="16,12">
                  <StackPanel x:Name="ConfirmGroups" Grid.IsSharedSizeScope="True"/>
                </Border>
                <TextBlock x:Name="ConfirmDetail" FontSize="{DynamicResource CompactFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="2,18,0,0"/>
              </StackPanel>
            </ScrollViewer>
            <!-- Advanced (red) cleanups are irreversible or touch recovery data: Clean stays off until this is ticked. -->
            <Border BorderBrush="{DynamicResource CleanTextBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,18,0,0" Visibility="{Binding Visibility, ElementName=AdvancedConsentBox}">
              <CheckBox x:Name="AdvancedConsentBox" Visibility="Collapsed" Click="AdvancedConsent_Click" Style="{StaticResource CandidateCheckBox}" Tag="{DynamicResource CleanTextBrush}" FontSize="{DynamicResource SupportFontSize}" Content="I understand some of this cannot be undone" IsEnabled="True" AutomationProperties.Name="I understand some of this cannot be undone"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
              <Button x:Name="ConfirmDeleteButton" Content="Clean selected" Click="ConfirmDelete_Click" Style="{StaticResource PopupDangerAction}"/>
              <Button x:Name="CancelDeleteButton" Content="Keep my files" Click="CancelDelete_Click" Style="{StaticResource PopupLeave}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        </Grid>
      </Border>
      <Border x:Name="WindowsSettingsOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Style="{StaticResource PopupShadowPlate}"><Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.4" Color="#000000"/></Border.Effect></Border>
        <Border x:Name="WindowsSettingsCard" Style="{StaticResource PopupCard}" Width="550" MaxHeight="650">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="WindowsConfirmTitle" Text="Apply Windows changes?" Style="{StaticResource PopupTitle}"/>
            <ScrollViewer Grid.Row="1" MaxHeight="410" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,22">
              <StackPanel>
                <TextBlock x:Name="WindowsConfirmSummary" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="22"/>
                <TextBlock x:Name="WindowsConfirmDetail" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="23" Margin="0,20,0,0"/>
                <TextBlock x:Name="WindowsConfirmNote" FontSize="{DynamicResource BodyFontSize}" FontWeight="Medium" Foreground="{DynamicResource MeterWarnBrush}" TextWrapping="Wrap" LineHeight="25" Margin="0,20,0,0" Visibility="Collapsed"/>
                <!-- These boxes use the Review checkbox style, whose IsEnabled follows "a scan result can be selected" (CanSelectCandidates). Without a scan result that made the
                     consent box dead (faded, impossible to tick), so the "Turn off Windows Update" button could never be enabled. They are always enabled here (local value). -->
                <StackPanel x:Name="WindowsOptions" Margin="0,20,0,0" Visibility="Collapsed">
                  <CheckBox x:Name="RestorePointBox" IsEnabled="True" IsChecked="True" Content="Create a restore point first" Style="{StaticResource CandidateCheckBox}" Tag="{DynamicResource TealTextBrush}" FontSize="{DynamicResource CompactFontSize}" AutomationProperties.Name="Create a restore point first"/>
                  <TextBlock x:Name="RestorePointNote" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="30,4,0,0" Visibility="Collapsed"/>
                  <CheckBox x:Name="EnableProtectionBox" IsEnabled="True" Content="Turn on System Protection for drive C: first" Visibility="Collapsed" Style="{StaticResource CandidateCheckBox}" Tag="{DynamicResource TealTextBrush}" FontSize="{DynamicResource CompactFontSize}" Margin="0,12,0,0" AutomationProperties.Name="Turn on System Protection first"/>
                  <CheckBox x:Name="AlsoUpdateOffBox" IsEnabled="True" Content="Also turn off Windows Update (no security fixes through it)" Visibility="Collapsed" Style="{StaticResource CandidateCheckBox}" Tag="{DynamicResource CleanTextBrush}" FontSize="{DynamicResource CompactFontSize}" Margin="0,14,0,0" AutomationProperties.Name="Also turn off Windows Update"/>
                  <CheckBox x:Name="WindowsConsentBox" IsEnabled="True" Content="I understand my PC gets no security fixes until I turn this back on" Visibility="Collapsed" Click="WindowsConsent_Click" Style="{StaticResource CandidateCheckBox}" Tag="{DynamicResource CleanTextBrush}" FontSize="{DynamicResource CompactFontSize}" Margin="0,14,0,0" AutomationProperties.Name="I understand Windows Update is off until I turn it back on"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
              <Button x:Name="ConfirmWindowsSettingsButton" Content="Apply changes" Click="ConfirmWindowsSettings_Click" Style="{StaticResource PopupAction}"/>
              <Button x:Name="CancelWindowsSettingsButton" Content="Cancel" Click="CancelWindowsSettings_Click" Style="{StaticResource PopupLeave}"/>
            </StackPanel>
          </Grid>
        </Border>
        </Grid>
      </Border>
      <!-- About (Phase D, the approved mockup; owner, November 20, 2026: keep "Happy Users, Simple Habits, Windows Cleaner" under the name). The shared popup card: the app
           icon and Hush with the update action level with them at the right; the line, the version with the update status, the filling bar; what is new; a hairline;
           the terms line and the license; the support link at the left and Close at the right. -->
      <Border x:Name="AboutOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Style="{StaticResource PopupShadowPlate}"><Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.4" Color="#000000"/></Border.Effect></Border>
        <Border x:Name="AboutCard" Style="{StaticResource PopupCard}" Width="520" MaxHeight="650">
          <StackPanel KeyboardNavigation.TabNavigation="Cycle">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Image Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" AutomationProperties.Name="Hush"><Image.Source><BitmapImage UriSource="/Hush;component/Assets/Hush-brush.png" DecodePixelWidth="96"/></Image.Source></Image>
              <TextBlock x:Name="AboutTitle" Grid.Column="2" Text="Hush" FontSize="28" FontWeight="Medium" Foreground="{DynamicResource TealTextBrush}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CheckUpdateButton" Content="Check for updates" Click="CheckUpdate_Click" Style="{StaticResource PopupAction}"/>
                <Button x:Name="CancelUpdateButton" Content="Cancel" Click="CancelUpdate_Click" Style="{StaticResource PopupLeave}" Visibility="Collapsed"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="AboutDescription" Text="Happy Users, Simple Habits, Windows Cleaner" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <StackPanel x:Name="UpdateStatusBlock" Margin="0,6,0,0">
              <WrapPanel>
                  <TextBlock x:Name="AboutVersion" FontSize="{DynamicResource SupportFontSize}" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock x:Name="UpdateStatus" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </WrapPanel>
              <local:UpdateActivity x:Name="UpdateSweep" Height="5" Margin="0,10,0,0"/>
              <TextBlock x:Name="UpdateHint" Visibility="Collapsed" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/>
            </StackPanel>
            <Border x:Name="PatchNotesPanel" Margin="0,16,0,0"><StackPanel>
              <TextBlock x:Name="PatchNotesHeading" Text="What's new in this version" FontSize="{DynamicResource SupportFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
              <TextBlock x:Name="PatchNotes" FontSize="{DynamicResource SupportFontSize}" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"/>
            </StackPanel></Border>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7" Margin="0,18,0,14"/>
            <WrapPanel>
              <TextBlock x:Name="AboutTerms" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <Button x:Name="TermsButton" Content="Terms of use" Click="Terms_Click" Style="{StaticResource AccentTextButton}" FontSize="13" Padding="0,2" Height="22" VerticalAlignment="Center" AutomationProperties.Name="Terms of use"/>
            </WrapPanel>
            <TextBlock Text="MIT license · © 2026 ShepherdGal" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
            <!-- Support (owner, November 13, 2026: Ko-fi, opens only on click; November 20: one big clickable card with a soft tint), then Close at the right. -->
            <Button x:Name="SupportButton" Style="{StaticResource SupportCard}" Click="Support_Click" Margin="0,16,0,0" ToolTip="Opens ko-fi.com/trueshepherdmusic in your browser" AutomationProperties.Name="Support Hush on Ko-fi">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Path Width="18" Height="18" Stretch="None" VerticalAlignment="Center" Data="M9,15.5 C9,15.5 1.75,10.9 1.75,6.3 C1.75,4.1 3.4,2.5 5.4,2.5 C6.8,2.5 8.2,3.4 9,4.6 C9.8,3.4 11.2,2.5 12.6,2.5 C14.6,2.5 16.25,4.1 16.25,6.3 C16.25,10.9 9,15.5 9,15.5 Z" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Enjoying Hush? Support it on Ko-fi" FontWeight="Medium" Foreground="{DynamicResource HeadingBrush}"/>
                  <TextBlock Text="Hush stays free. A tip keeps it going." FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Path Grid.Column="3" Width="14" Height="14" Stretch="None" VerticalAlignment="Center" Margin="12,0,0,0" Data="M4,10 L10,4 M5.5,4 H10 V8.5" Stroke="{DynamicResource TealTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Grid>
            </Button>
            <Button x:Name="CloseAboutButton" Content="Close" Click="CloseAbout_Click" Style="{StaticResource TextButton}" Height="40" Padding="16,0" Margin="0,10,-16,0" HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>
        </Grid>
      </Border>
      <!-- Uninstall a program (owner, November 19, 2026): one popup with four steps lit in turn (Prepare, Uninstaller, Leftovers, Review); the action is on the left,
           the way out on the right. The leftovers are grouped by kind, each group with its own tick and a chevron that opens it (closed at first). -->
      <Border x:Name="UninstallOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Style="{StaticResource PopupShadowPlate}"><Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.4" Color="#000000"/></Border.Effect></Border>
        <Border x:Name="UninstallCard" Style="{StaticResource PopupCard}" Width="580">
          <StackPanel>
            <ItemsControl x:Name="UninstallSteps" Margin="0,0,0,16" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Grid Width="20" Height="20" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.5"/>
                    <Path x:Name="Tick" Data="M5.5,10.2 L8.6,13.2 L14.5,7" Stroke="{DynamicResource PopupBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Width="20" Height="20" Stretch="None"/>
                  </Grid>
                  <TextBlock x:Name="Label" Text="{Binding Label}" Margin="8,0,0,0" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                  <Border x:Name="Joint" Width="18" Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0" VerticalAlignment="Center"/>
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Lit}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TealBrush}"/><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource TealBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></DataTrigger>
                  <DataTrigger Binding="{Binding Current}" Value="True"><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource HeadingBrush}"/><Setter TargetName="Dot" Property="Fill" Value="Transparent"/><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource TealBrush}"/><Setter TargetName="Dot" Property="StrokeThickness" Value="2"/><Setter TargetName="Tick" Property="Visibility" Value="Collapsed"/></DataTrigger>
                  <DataTrigger Binding="{Binding More}" Value="False"><Setter TargetName="Joint" Property="Visibility" Value="Collapsed"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="UninstallTitle" Style="{StaticResource PopupTitle}" TextWrapping="Wrap"/>

            <TextBlock x:Name="UninstallText" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,4,0,0"/>
            <!-- How deep to look for leftovers (Moderate by default). -->
            <StackPanel x:Name="UninstallDepthPanel" Margin="0,14,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Search depth" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border CornerRadius="20" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Padding="3">
                  <local:SegmentPanel Orientation="Horizontal" ThumbBrush="{DynamicResource AccentSelectedBrush}" ThumbEdge="{DynamicResource AccentSelectedEdgeBrush}" ThumbRadius="16" >
                    <Button x:Name="DepthSafeButton" Content="Safe" Style="{StaticResource SegmentChoice}" Tag="Off" Click="Depth_Click" AutomationProperties.Name="Safe search"/>
                    <Button x:Name="DepthModerateButton" Content="Moderate" Style="{StaticResource SegmentChoice}" Tag="On" Click="Depth_Click" AutomationProperties.Name="Moderate search"/>
                    <Button x:Name="DepthDeepButton" Content="Deep" Style="{StaticResource SegmentChoice}" Tag="Off" Click="Depth_Click" AutomationProperties.Name="Deep search"/>
                  </local:SegmentPanel>
                </Border>
              </StackPanel>
              <TextBlock x:Name="UninstallDepthNote" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0"/>
            </StackPanel>
            <ScrollViewer x:Name="LeftoverScroll" MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Margin="0,14,0,0">
              <Border Background="{DynamicResource RaisedBrush}" CornerRadius="14" Padding="10,6" Margin="0,0,10,0">
              <ItemsControl x:Name="LeftoverGroups">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" VerticalAlignment="Center" AutomationProperties.Name="{Binding SelectName}"/>
                      <ToggleButton Grid.Column="1" Style="{StaticResource TopicHeader}" IsChecked="{Binding IsOpen, Mode=TwoWay}">
                        <TextBlock FontSize="{DynamicResource CompactFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Summary, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}" FontWeight="Normal"/></TextBlock>
                      </ToggleButton>
                    </Grid>
                    <local:AccordionBody Expanded="{Binding IsOpen}" IsEnabled="{Binding Expanded, RelativeSource={RelativeSource Self}}">
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <Grid Margin="34,5,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="{Binding Title}"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Title}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                              <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                          </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </local:AccordionBody>
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              </Border>
            </ScrollViewer>
            <TextBlock Text="Everything is backed up before it is removed. You can restore it later from Tools." FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
              <Button x:Name="UninstallActionButton" Content="Uninstall" Click="UninstallAction_Click" Style="{StaticResource PopupAction}"/>
              <Button x:Name="UninstallCancelButton" Content="Cancel" Click="UninstallCancel_Click" Style="{StaticResource PopupLeave}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        </Grid>
      </Border>
      <!-- Drawn after (above) the About card so the update confirmation appears on top of it. -->
      <Border x:Name="ConsentOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Style="{StaticResource PopupShadowPlate}"><Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.4" Color="#000000"/></Border.Effect></Border>
        <Border x:Name="ConsentCard" Style="{StaticResource PopupCard}" Width="480">
          <StackPanel>
            <TextBlock x:Name="ConsentTitle" Style="{StaticResource PopupTitle}" TextWrapping="Wrap"/>
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,22">
              <TextBlock x:Name="ConsentText" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,10,0"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ConsentConfirmButton" Content="Turn on" Click="ConsentConfirm_Click" Style="{StaticResource PopupAction}"/>
              <Button x:Name="ConsentCancelButton" Content="Not now" Click="ConsentCancel_Click" Style="{StaticResource PopupLeave}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        </Grid>
      </Border>
      <!-- The result of applied changes (owner, November 20, 2026, mockup A: "more refined with a highlight to let people know changes applied well", buttons
           centered, OK not Close): a big check badge with two soft rings that open once, a centered title and line, what was done as a checked list (a part that
           did not work gets an amber mark), advice in its own soft box, and ONE centered OK. -->
      <Border x:Name="ResultOverlay" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Style="{StaticResource PopupShadowPlate}"><Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.4" Color="#000000"/></Border.Effect></Border>
          <Border Style="{StaticResource PopupCard}" Width="460">
            <StackPanel HorizontalAlignment="Stretch">
              <Grid Width="104" Height="104" HorizontalAlignment="Center">
                <Ellipse x:Name="ResultRingOuter" Width="100" Height="100" StrokeThickness="1" Stroke="{DynamicResource GoodBrush}" Opacity="0.14" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
                <Ellipse x:Name="ResultRingInner" Width="82" Height="82" StrokeThickness="2" Stroke="{DynamicResource GoodBrush}" Opacity="0.28" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
                <Grid Width="64" Height="64">
                  <Ellipse x:Name="ResultBadgeFill" Fill="{DynamicResource GoodBrush}" Opacity="0.16"/>
                  <Path x:Name="ResultCheck" Data="M 19,33 L 28,42 L 45,23" Stroke="{DynamicResource GoodBrush}" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  <TextBlock x:Name="ResultMark" Text="!" Visibility="Collapsed" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource MeterWarnBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Grid>
              <TextBlock x:Name="ResultTitle" Style="{StaticResource PopupTitle}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
              <TextBlock x:Name="ResultSubtitle" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
                <ItemsControl x:Name="ResultLines" Focusable="False">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,0,0,5">
                      <Border CornerRadius="10" Background="{DynamicResource RaisedBrush}"/>
                      <Grid Margin="12,8,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="Mark" Text="✓" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                      </Grid>
                    </Grid>
                    <DataTemplate.Triggers><DataTrigger Binding="{Binding Ok}" Value="False"><Setter TargetName="Mark" Property="Text" Value="!"/><Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource MeterWarnBrush}"/></DataTrigger></DataTemplate.Triggers>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Border x:Name="ResultAdviceBox" CornerRadius="12" Background="{DynamicResource SoftAccentBrush}" BorderBrush="{DynamicResource AccentSelectedEdgeBrush}" BorderThickness="1" Padding="12,9" Margin="0,8,0,0">
                <TextBlock x:Name="ResultAdvice" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21"/>
              </Border>
              <Button x:Name="ResultOkButton" Content="OK" Click="ResultOk_Click" Style="{StaticResource PopupAction}" HorizontalAlignment="Center" MinWidth="140" Margin="0,22,0,0" AutomationProperties.Name="OK"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <!-- No resize edges (owner, November 20, 2026): the window has one size, set by the interface size (UI/MainWindow.UiSize.cs). -->
    </Grid>
  </Border>
</Window>
