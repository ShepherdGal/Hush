                    <StackPanel Orientation="Horizontal"><TextBlock Text="Run Hush as administrator" Style="{StaticResource RowName}"/><local:HelpMark Style="{StaticResource HelpMark}" Margin="8,0,0,0" AutomationProperties.Name="More about administrator mode" HelpText="System Temp, Prefetch, Windows logs and Windows Update files can only be cleaned as administrator. Hush still shows everything first and asks before cleaning. The installed copy moves to Program Files and starts through one task, so there is no permission prompt on each start; a portable copy asks each time."/></StackPanel>
                    <TextBlock Text="Cleans system files without asking every time" Style="{StaticResource RowLine}"/>
