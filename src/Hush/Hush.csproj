<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hush</AssemblyName>
    <RootNamespace>Hush</RootNamespace>
    <Version>0.8</Version>
    <Authors>ShepherdGal</Authors>
    <Copyright>Copyright (c) 2026 ShepherdGal. MIT License.</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Hush.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same icon the executable carries, available to the windows themselves (taskbar, Alt+Tab). -->
    <Resource Include="Assets\Hush.ico" />
    <InternalsVisibleTo Include="Hush.Tests" />
  </ItemGroup>
</Project>
