<Window x:Class="Hush.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hush"
        Title="Hush Setup" Icon="/Hush;component/Assets/Hush.ico" Width="520" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
  <!-- Setup (Phase D, owner, November 20, 2026: "like the new popups"): the shared popup card as the whole window; the app icon and Hush at the top with Close, a
       22 title, plain text, the option as a switch row, and one button row: the action as a pill at the left, the way out as a quiet button right beside it. -->
  <Border x:Name="Surface" CornerRadius="22" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" MouseLeftButtonDown="Surface_MouseLeftButtonDown">
    <Grid Margin="28,22,28,28">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" AutomationProperties.Name="Hush"><Image.Source><BitmapImage UriSource="/Hush;component/Assets/Hush-brush.png" DecodePixelWidth="80"/></Image.Source></Image>
        <TextBlock Grid.Column="2" Text="Hush" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource TealTextBrush}" VerticalAlignment="Center"/>
        <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CaptionButton}" Click="Close_Click" Margin="0,0,-12,0" ToolTip="Close" AutomationProperties.Name="Close">
          <Path Style="{StaticResource CaptionIcon}" Stretch="None" Data="M4,4 L14,14 M14,4 L4,14"/>
        </Button>
      </Grid>
      <TextBlock x:Name="Heading" Grid.Row="1" Style="{StaticResource PopupTitle}" Margin="0,20,0,0" TextWrapping="Wrap"/>
      <StackPanel Grid.Row="2" Margin="0,10,0,0">
        <TextBlock x:Name="Details" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="22"/>
        <TextBlock x:Name="TermsNote" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0"/>
      </StackPanel>
      <!-- The option as a switch row on a raised panel (its words are the switch's content, set by the code). -->
      <Border x:Name="OptionPanel" Grid.Row="3" Margin="0,18,0,0" CornerRadius="14" Background="{DynamicResource RaisedBrush}" Padding="16,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Content, ElementName=OptionBox}" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource HeadingBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="OptionHint" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,2,0,0"/>
          </StackPanel>
          <CheckBox x:Name="OptionBox" Grid.Column="2" Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        </Grid>
      </Border>
      <TextBlock x:Name="Status" Grid.Row="4" FontSize="{DynamicResource SupportFontSize}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,16,0,0" Visibility="Collapsed"/>
      <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,22,0,0">
        <Button x:Name="PrimaryButton" Style="{StaticResource PopupAction}" Click="Primary_Click"/>
        <Button x:Name="SecondaryButton" Style="{StaticResource PopupLeave}" Click="Secondary_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
